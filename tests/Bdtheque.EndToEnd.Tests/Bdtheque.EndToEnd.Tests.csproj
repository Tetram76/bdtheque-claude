<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bdtheque.EndToEnd.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Both applications declare a top-level `Program`: the frontend's is reached through its alias,
         the API's only through the shared API host of Bdtheque.Testing. -->
    <ProjectReference Include="..\..\src\Bdtheque.Frontend\Bdtheque.Frontend.csproj" Aliases="frontend" />
    <ProjectReference Include="..\Bdtheque.Testing\Bdtheque.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <!-- Decoding of the captures, the library the API already uses for the visuals. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <!-- Where the reference captures are kept, and written when they are updated (CaptureStore). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ProjectDirectory</_Parameter1>
      <_Parameter2>$(MSBuildProjectDirectory)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bdtheque.Testing" />
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
