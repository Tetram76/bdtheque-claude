<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Bdtheque.Frontend.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bdtheque.Frontend\Bdtheque.Frontend.csproj" />
    <!-- The rule codes the frontend's texts must cover (RuleMessagesTests); the frontend itself never references it. -->
    <ProjectReference Include="..\..\src\Bdtheque.Domain\Bdtheque.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="bunit" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The ways of raising an event that the compiler refuses (RS0030), and why (choix-implementation/outillage.md, tests). -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stylesheets of the themes, whose colors ThemeContrastTests checks. -->
    <None Include="..\..\src\Bdtheque.Frontend\wwwroot\themes\*.css" LinkBase="themes" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Bunit" />
    <!-- CircuitEvents: the only way a test raises an event (BannedSymbols.txt). -->
    <Using Include="Bdtheque.Frontend.Tests.Controls" />
  </ItemGroup>

</Project>
