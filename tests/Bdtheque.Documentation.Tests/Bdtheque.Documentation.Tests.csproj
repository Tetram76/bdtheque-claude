<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Bdtheque.Documentation.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel serves the built site to the browser, as a static site. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The waits that the compiler refuses (RS0030), as in the end-to-end tests (choix-implementation/outillage.md). -->
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Playwright" />
  </ItemGroup>

</Project>
