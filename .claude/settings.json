{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/Show-SpeckitMoment.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/Show-SpeckitMoment.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(gh *)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/Show-SpeckitMoment.ps1\"",
            "timeout": 30
          },
          {
            "type": "command",
            "if": "PowerShell(git push*)",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/Show-SpeckitMoment.ps1\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*github.*",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "& \"$env:CLAUDE_PROJECT_DIR/.claude/hooks/Show-SpeckitMoment.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
