# Style rules listed by the weekly quality audit (.github/workflows/quality-audit.yml), and by no other build: only
# Directory.Build.props includes this file, for a build run with StyleAudit=true
# (gestion-projet/depot/controle-qualite-hebdomadaire.md). Each deviation becomes an entry of the harness's
# tracking issue, never a build error.
#
# Only the rules that do not express a preference of form: a defect (code without effect, redundant or misleading),
# or a newer syntax of the language left unused where it says the same thing more directly
# (contraintes-techniques/exploitation-des-technologies-retenues.md). The rules of preference (var, braces,
# expression bodies, form of the namespace, target-typed new…) are left out: fixing them would freeze a model
# of code, a judgment the agent makes case by case.
is_global = true

# Defects.
# IDE0001, IDE0002: name or member access that can be simplified.
dotnet_diagnostic.IDE0001.severity = warning
dotnet_diagnostic.IDE0002.severity = warning
# IDE0004: unnecessary cast.
dotnet_diagnostic.IDE0004.severity = warning
# IDE0005: unnecessary using directive.
dotnet_diagnostic.IDE0005.severity = warning
# IDE0035: unreachable code.
dotnet_diagnostic.IDE0035.severity = warning
# IDE0044: field never assigned after construction, not readonly.
dotnet_diagnostic.IDE0044.severity = warning
# IDE0051, IDE0052: private member unused, or never read.
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
# IDE0059: value assigned and never used.
dotnet_diagnostic.IDE0059.severity = warning
# IDE0060: unused parameter.
dotnet_diagnostic.IDE0060.severity = warning
# IDE0062: local function that captures nothing, not static.
dotnet_diagnostic.IDE0062.severity = warning
# IDE0064: readonly struct field assigned as a whole.
dotnet_diagnostic.IDE0064.severity = warning
# IDE0079: unnecessary suppression.
dotnet_diagnostic.IDE0079.severity = warning
# IDE0080: unnecessary suppression operator (!).
dotnet_diagnostic.IDE0080.severity = warning
# IDE0100: redundant equality (== true).
dotnet_diagnostic.IDE0100.severity = warning
# IDE0110: unnecessary discard.
dotnet_diagnostic.IDE0110.severity = warning
# IDE0240, IDE0241: redundant or unnecessary nullable directive.
dotnet_diagnostic.IDE0240.severity = warning
dotnet_diagnostic.IDE0241.severity = warning
# IDE0250, IDE0251: struct or member that can be readonly.
dotnet_diagnostic.IDE0250.severity = warning
dotnet_diagnostic.IDE0251.severity = warning
# IDE0280: nameof instead of a literal parameter name.
dotnet_diagnostic.IDE0280.severity = warning

# Newer syntax left unused.
# IDE0056, IDE0057: index and range operators.
dotnet_diagnostic.IDE0056.severity = warning
dotnet_diagnostic.IDE0057.severity = warning
# IDE0066: switch expression.
dotnet_diagnostic.IDE0066.severity = warning
# IDE0078, IDE0083, IDE0150, IDE0170, IDE0260: pattern matching.
dotnet_diagnostic.IDE0078.severity = warning
dotnet_diagnostic.IDE0083.severity = warning
dotnet_diagnostic.IDE0150.severity = warning
dotnet_diagnostic.IDE0170.severity = warning
dotnet_diagnostic.IDE0260.severity = warning
# IDE0180: tuple swap.
dotnet_diagnostic.IDE0180.severity = warning
# IDE0220: explicit cast in foreach.
dotnet_diagnostic.IDE0220.severity = warning
# IDE0230: UTF-8 string literal.
dotnet_diagnostic.IDE0230.severity = warning
# IDE0290: primary constructor.
dotnet_diagnostic.IDE0290.severity = warning
# IDE0300 to IDE0306: collection expressions.
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning
# IDE0320: static anonymous function.
dotnet_diagnostic.IDE0320.severity = warning
# IDE0330: System.Threading.Lock.
dotnet_diagnostic.IDE0330.severity = warning
# IDE0340: unbound generic type in nameof.
dotnet_diagnostic.IDE0340.severity = warning
