@inherits Block<DashboardData>
@* Same blocks as the base theme, placed in newspaper columns; only the type distribution is replaced. *@
<main class="dashboard gazette-front">
    <div class="g-cols">
        <div class="g-main">
            <ThemeSlot Slot="DashboardSlots.Hero" Data="Data.Hero" />
            <ThemeSlot Slot="DashboardSlots.NewArrivals" Data="Data.NewArrivals" />
        </div>
        <aside class="g-aside" aria-label="Cours et palmarès">
            <ThemeSlot Slot="DashboardSlots.Value" Data="Data.Value" />
            <ThemeSlot Slot="DashboardSlots.Publishers" Data="Data.Publishers" />
        </aside>
    </div>
    <div class="g-cols g-bottom">
        <ThemeSlot Slot="DashboardSlots.Types" Data="Data.Types" />
        <ThemeSlot Slot="DashboardSlots.Genres" Data="Data.Genres" />
    </div>
</main>
