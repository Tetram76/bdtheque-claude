@inherits Block<PublishersData>
<section class="block publishers" aria-labelledby="h-pub">
    <h2 id="h-pub" class="bubble">Chez quels éditeurs ?</h2>
    <p class="lede">Un stand par éditeur, à la taille de ses éditions possédées.</p>
    <div class="expo-scroll">
        <ol class="expo-line">
            @foreach (var (publisher, stand) in _stops)
            {
                <li>
                    <a href="@publisher.Href" class="expo-stop">
                        <span class="expo-name">@publisher.Name</span>
                        <span class="expo-dot-wrap" aria-hidden="true"><span class="expo-dot" style="--d:@(18 + (int)Math.Round(publisher.Count * 30.0 / _max))px"></span></span>
                        <span class="expo-n">@Fmt.N(publisher.Count)</span>
                        <span class="expo-stand">@stand</span>
                    </a>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private List<(CountedLink Publisher, string Stand)> _stops = [];
    private int _max;

    protected override void OnParametersSet()
    {
        // Two stands per aisle: A1, A2, B1, B2… "Others" has none.
        _stops = Data.Publishers.Select((p, i) => (p, $"{(char)('A' + i / 2)}{i % 2 + 1}")).ToList();
        if (Data.Others is { } others) _stops.Add((others, "—"));
        _max = _stops.Max(s => s.Publisher.Count);
    }
}
