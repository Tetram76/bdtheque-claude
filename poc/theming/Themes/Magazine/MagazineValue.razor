@inherits Block<ValueData>
<section class="block value" aria-labelledby="h-value">
    <h2 id="h-value" class="bubble">Ça vaut combien, tout ça ?</h2>
    <p class="lede">
        Notre enquête : <strong>@Fmt.Eur(Data.Estimated.Current)</strong> au total,
        <mark>@Fmt.Eur(Data.Estimated.Today) d'aujourd'hui</mark>.
        Un album coûte en moyenne @Pair(PriceKind.Average), le plus cher @Pair(PriceKind.Max).
    </p>
    <p class="note">
        Valeur connue @Fmt.Eur(Data.Known.Current) (@Fmt.Eur(Data.Known.Today) du jour) · médian @Pair(PriceKind.Median)
        · le moins cher @Pair(PriceKind.Min) · @Fmt.N(Data.NotConvertible) montants non convertibles exclus
        · @Fmt.N(Data.FreeEditions) éd. gratuites non valorisées.
    </p>
</section>

@code {
    private string Pair(PriceKind kind)
    {
        var amount = Data.Prices.First(p => p.Kind == kind).Amount;
        return $"{Fmt.Eur(amount.Current)} ({Fmt.Eur(amount.Today)} du jour)";
    }
}
