@inherits Block<PublishersData>
<section class="block publishers" aria-labelledby="h-pub">
    <h2 id="h-pub" class="bubble bubble--right">Chez quels éditeurs ?</h2>
    <ol class="ranking">
        @foreach (var (publisher, i) in Data.Publishers.Select((p, i) => (p, i)))
        {
            <li class="pal-@(i % 8)" style="--w:@Fmt.Css((double)publisher.Count / _max)">
                <a href="@publisher.Href" class="rank-row">
                    <span class="rank-name">@publisher.Name</span>
                    <span class="rank-bar" aria-hidden="true"><span></span></span>
                    <span class="rank-n">@Fmt.N(publisher.Count)</span>
                </a>
            </li>
        }
    </ol>
    @if (Data.Others is { } others)
    {
        <a href="@others.Href" class="rank-row others pal-7" style="--w:@Fmt.Css((double)others.Count / _max)">
            <span class="rank-name">@others.Name</span>
            <span class="rank-bar" aria-hidden="true"><span></span></span>
            <span class="rank-n">@Fmt.N(others.Count)</span>
        </a>
    }
    <p class="note">Éditions possédées.</p>
</section>

@code {
    private int _max;
    protected override void OnParametersSet() =>
        _max = Data.Publishers.Append(Data.Others).Max(p => p?.Count ?? 0);
}
