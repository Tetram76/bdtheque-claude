@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject CurrentTheme Current
@inject ThemeCatalog Catalog

<div class="page">
    <ThemeSlot Slot="SiteSlots.Header" Data="Header()" />
    @Body
    <footer class="site-footer">
        <span>Montants convertis en euro (taux Frankfurter, inflation INSEE)</span>
        <a href="/">Administration</a>
    </footer>
</div>

@* Prototype only: shows the session's theme and lets the reviewer switch. *@
<aside class="proto-bar" aria-label="Prototype">
    Thème de la session : <strong>@Current.Theme.Name</strong> ·
    @foreach (var theme in Catalog.All)
    {
        <a href="@($"?theme={theme.Id}")" data-enhance-nav="false">@theme.Id</a>@(" · ")
    }
    <a href="?theme=new" data-enhance-nav="false">nouvelle session</a>
</aside>

@code {
    private static readonly (string Label, string Href)[] Nav =
    [
        ("Accueil", "/"), ("Albums", "/albums"), ("Séries", "/series"), ("Auteurs", "/auteurs"),
        ("Éditeurs", "/editeurs"), ("Intentions d'achat", "/intentions"),
    ];

    private SiteHeaderData Header()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0];
        return new SiteHeaderData(Nav.Select(n => new NavItem(n.Label, n.Href, n.Href == path)).ToList(), FakeData.AlbumCount);
    }
}
