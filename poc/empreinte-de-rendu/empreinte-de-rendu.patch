@@ -0,0 +1,118 @@
+extern alias frontend;
+
+using Bdtheque.EndToEnd.Tests.Controls;
+using frontend::Bdtheque.Frontend.Navigation;
+using frontend::Bdtheque.Frontend.Theming;
+
+namespace Bdtheque.EndToEnd.Tests.Captures;
+
+/// <summary>
+/// The fingerprint of a rendering (<see cref="RenderFingerprint"/>) stands for its capture: the same rendering always has
+/// the same fingerprint, whatever the page holds that the browser never paints (the token of a form, the identifiers that
+/// the application draws), and any change of what the browser paints from changes it.
+/// </summary>
+[Collection(ApplicationCollection.Name)]
+public sealed class RenderFingerprintTests(ApplicationHost application) : BrowserTest<ApplicationHost>(application)
+{
+    private static readonly ViewportSize Smartphone = ScreenCaptureTests.Viewports["smartphone"];
+
+    [Fact]
+    public async Task APageRenderedAgain_HasTheSameFingerprint()
+    {
+        // The page of the login holds the antiforgery token of its form, drawn for each rendering.
+        var first = await RenderAsync(AppPaths.AdminLogin);
+        var second = await RenderAsync(AppPaths.AdminLogin);
+
+        Assert.Equal(await RenderFingerprint.ComputeAsync(first), await RenderFingerprint.ComputeAsync(second));
+    }
+
+    [Fact]
+    public async Task APageMadeInteractive_HasTheFingerprintOfThePageRenderedByTheServer()
+    {
+        // Whether the circuit has rendered the fields of the page yet depends on the speed of the run: here, never.
+        var interactive = await RenderAsync(ControlsPage.Path);
+        var rendered = await NewCapturePageAsync(ThemeCatalog.Planche.Key, Smartphone);
+        await rendered.RouteAsync("**/_blazor/**", route => route.AbortAsync());
+        await PageReadiness.GotoAsync(rendered, ControlsPage.Path);
+
+        Assert.Equal(await RenderFingerprint.ComputeAsync(interactive), await RenderFingerprint.ComputeAsync(rendered));
+    }
+
+    [Fact]
+    public async Task AStyleChanged_ChangesTheFingerprint()
+    {
+        var page = await RenderAsync(ControlsPage.Path);
+        var before = await RenderFingerprint.ComputeAsync(page);
+
+        await page.AddStyleTagAsync(new PageAddStyleTagOptions { Content = "body { letter-spacing: 1px; }" });
+
+        Assert.NotEqual(before, await RenderFingerprint.ComputeAsync(page));
+    }
+
+    [Fact]
+    public async Task ATextChanged_ChangesTheFingerprint()
+    {
+        var page = await RenderAsync(ControlsPage.Path);
+        var before = await RenderFingerprint.ComputeAsync(page);
+
+        await page.EvaluateAsync("() => document.querySelector('h1').textContent += '!'");
+
+        Assert.NotEqual(before, await RenderFingerprint.ComputeAsync(page));
+    }
+
+    [Fact]
+    public async Task ARowScrolledElsewhere_ChangesTheFingerprint()
+    {
+        var page = await RenderAsync(ControlsPage.Path);
+        var before = await RenderFingerprint.ComputeAsync(page);
+
+        // Only the position of the row changes: the attributes that its script toggles on scroll are put back.
+        await page.EvaluateAsync("""
+            async () => {
+                const row = [...document.querySelectorAll("app-scroll-row")]
+                    .find(row => row.querySelector(".scroll-row-items").scrollWidth > row.querySelector(".scroll-row-items").clientWidth);
+                const items = row.querySelector(".scroll-row-items");
+                const attributes = [...row.attributes].map(attribute => [attribute.name, attribute.value]);
+                items.scrollLeft = items.scrollLeft > 0 ? 0 : 10;
+                await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));
+                [...row.attributes].forEach(attribute => row.removeAttribute(attribute.name));
+                attributes.forEach(([name, value]) => row.setAttribute(name, value));
+            }
+            """);
+
+        Assert.NotEqual(before, await RenderFingerprint.ComputeAsync(page));
+    }
+
+    [Fact]
+    public async Task AFontChanged_ChangesTheFingerprint()
+    {
+        var original = await RenderAsync(ControlsPage.Path);
+
+        var page = await NewCapturePageAsync(ThemeCatalog.Planche.Key, Smartphone);
+        await page.RouteAsync("**/*.woff2", async route =>
+        {
+            var response = await route.FetchAsync();
+            var body = await response.BodyAsync();
+            body[^1] ^= 1;
+            await route.FulfillAsync(new RouteFulfillOptions { Response = response, BodyBytes = body });
+        });
+        await PageReadiness.GotoAsync(page, ControlsPage.Path);
+        await ControlsPage.WaitUntilInteractiveAsync(page);
+        await PageReadiness.WaitAsync(page);
+
+        Assert.NotEqual(await RenderFingerprint.ComputeAsync(original), await RenderFingerprint.ComputeAsync(page));
+    }
+
+    private async Task<IPage> RenderAsync(string path)
+    {
+        var page = await NewCapturePageAsync(ThemeCatalog.Planche.Key, Smartphone);
+        await PageReadiness.GotoAsync(page, path);
+        if (path == ControlsPage.Path)
+        {
+            await ControlsPage.WaitUntilInteractiveAsync(page);
+            await PageReadiness.WaitAsync(page);
+        }
+
+        return page;
+    }
+}
