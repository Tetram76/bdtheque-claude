+using System.Security.Cryptography;
+using System.Text;
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace Bdtheque.EndToEnd.Tests.Captures;
+
+/// <summary>
+/// The fingerprint of what the browser paints a page from: its rendered state (the document and what its scripts made of
+/// it, the rules of its stylesheets, the position of what scrolls, the focus, the values of its fields), the bytes of the
+/// fonts and images it designates, the browser and its switches, the size of the screen, and how the page is captured.
+/// The same fingerprint stands for the same capture, which is then not taken again (<see cref="CaptureStore"/>): the cost
+/// of the control follows what changed, no longer the number of themes and screens (#285).
+/// </summary>
+/// <remarks>
+/// It is written as one line per input, each with its hash, so that the change of a fingerprint, which a pull request
+/// shows, names what changed. Everything is read from the page as it is, never from what the network carried until then:
+/// a font or an image may be asked for later in one run than in another. What the page holds without the browser ever
+/// painting it is left out, as it changes from one rendering to the next: the comments of Blazor, the attributes of its
+/// element references (<c>_bl_</c>), the attribute of the default value of a field, which Blazor drops once the field is
+/// interactive (the value painted is kept), a hidden field (the antiforgery token of a form), the identifiers that the
+/// application draws (a Guid, only ever in an address: shown, it would make the capture itself change from one run to the
+/// next), the address of the application, whose port is drawn. The scripts are left out too: what they do is in the state
+/// they leave.
+/// </remarks>
+public static class RenderFingerprint
+{
+    private const string RenderedState = """
+        async () => {
+            const guid = /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/gi;
+            const clean = text => text.replaceAll(location.origin, "").replace(guid, "{guid}");
+
+            // The fonts and images that the page designates, by their address resolved from where they are written.
+            const resources = new Set();
+            const designate = (url, base) => {
+                if (url && !url.startsWith("data:"))
+                    resources.add(new URL(url, base).href);
+            };
+            const designateIn = (text, base) => {
+                for (const [, , url] of (text ?? "").matchAll(/url\(\s*(["']?)(.*?)\1\s*\)/g))
+                    designate(url, base);
+            };
+
+            const lines = [];
+            const describe = (node, depth) => {
+                for (const child of node.childNodes) {
+                    if (child.nodeType === Node.TEXT_NODE) {
+                        lines.push(`${depth} ${JSON.stringify(clean(child.data))}`);
+                        continue;
+                    }
+                    if (child.nodeType !== Node.ELEMENT_NODE)
+                        continue;
+                    const field = ["input", "textarea", "select"].includes(child.localName);
+                    const hidden = child.localName === "input" && child.type === "hidden";
+                    const attributes = [...child.attributes]
+                        .filter(attribute => !attribute.name.startsWith("_bl_") && !(field && attribute.name === "value"))
+                        .map(attribute => `${attribute.name}=${JSON.stringify(clean(attribute.value))}`)
+                        .sort();
+                    const state = [];
+                    if (field && !hidden)
+                        state.push(`value=${JSON.stringify(child.value)}`, `checked=${child.checked === true}`);
+                    if (child.scrollLeft || child.scrollTop)
+                        state.push(`scroll=${child.scrollLeft},${child.scrollTop}`);
+                    if (child === document.activeElement)
+                        state.push("focused");
+                    lines.push(`${depth} <${child.localName} ${attributes.join(" ")}> ${state.join(" ")}`);
+                    designateIn(child.getAttribute("style"), document.baseURI);
+                    if (child.localName === "img")
+                        designate(child.currentSrc || child.src, document.baseURI);
+                    if (child.localName === "image")
+                        designate(child.getAttribute("href"), document.baseURI);
+                    describe(child, depth + 1);
+                }
+            };
+            describe(document, 0);
+            const page = document.scrollingElement;
+            lines.push(`window ${innerWidth}x${innerHeight}@${devicePixelRatio} scroll=${page.scrollLeft},${page.scrollTop}`);
+
+            const styles = [...document.styleSheets, ...document.adoptedStyleSheets].map(sheet => {
+                const rules = [...sheet.cssRules].map(rule => rule.cssText);
+                rules.forEach(rule => designateIn(rule, sheet.href ?? document.baseURI));
+                return `${sheet.disabled} ${sheet.media.mediaText}\n${rules.map(clean).join("\n")}`;
+            });
+
+            // Read again from the cache of the browser, as the page received them.
+            const hex = buffer => [...new Uint8Array(buffer)].map(byte => byte.toString(16).padStart(2, "0")).join("");
+            const painted = await Promise.all([...resources].map(async url => {
+                const response = await fetch(url, { cache: "force-cache", signal: AbortSignal.timeout(10000) });
+                if (!response.ok)
+                    throw new Error(`${url} could not be read (status ${response.status})`);
+                return `resource ${clean(url)} ${hex(await crypto.subtle.digest("SHA-256", await response.arrayBuffer()))}`;
+            }));
+            return { document: lines.join("\n"), styles: styles.join("\n\n"), resources: [...new Set(painted)].sort() };
+        }
+        """;
+
+    private static readonly JsonSerializerOptions CaptureOptionsFormat = new() { DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull };
+
+    /// <summary>The fingerprint of the page as it is, once ready (<see cref="PageReadiness"/>).</summary>
+    public static async Task<string> ComputeAsync(IPage page)
+    {
+        var state = await page.EvaluateAsync<RenderedPage>(RenderedState);
+        var lines = new List<string>
+        {
+            $"capture {JsonSerializer.Serialize(CaptureStore.Options, CaptureOptionsFormat)}",
+            $"browser {page.Context.Browser!.BrowserType.Name} {page.Context.Browser.Version} {string.Join(' ', ApplicationHost.BrowserArguments)}",
+            $"document {Hash(state.Document)}",
+            $"styles {Hash(state.Styles)}",
+        };
+        lines.AddRange(state.Resources);
+        return string.Join('\n', lines) + '\n';
+    }
+
+    private static string Hash(string text) => Convert.ToHexStringLower(SHA256.HashData(Encoding.UTF8.GetBytes(text)));
+
+    // Built by Playwright, which sets the properties of an instance it creates.
+    private sealed class RenderedPage
+    {
+        public string Document { get; set; } = "";
+
+        public string Styles { get; set; } = "";
+
+        public string[] Resources { get; set; } = [];
+    }
+}
