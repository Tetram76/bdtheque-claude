<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- The French UI needs culture-aware date/currency formatting and linguistic sorting
         (fr-FR), which the globalization-invariant mode would silently disable. The base
         images (aspnet:10.0, Ubuntu, not Alpine/chiseled) already ship ICU, so full
         globalization support has no extra cost here. See choix-implementation.md. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- The XML comments are checked by the compiler, a malformed comment, or one that refers to a
         parameter, type or member that no longer exists, failing the build: nothing else would notice
         it going stale. Every warning fails it, rather than a hand-picked list of documentation
         warnings, which would let the forgotten ones through (e.g. a duplicated <param>); the build
         is kept free of warnings anyway. Documenting every member (CS1591) or every parameter
         (CS1573) is not required, the comments explaining the why rather than the what. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>BDthèque</Authors>
    <Company>BDthèque</Company>
    <Product>BDthèque</Product>
  </PropertyGroup>

</Project>
