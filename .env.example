# Copy this file to `.env` (ignored by git) and fill in the values before `docker compose up`.

# Tag of the application images published on Docker Hub (tetram76/bdtheque-api,
# tetram76/bdtheque-frontend): the number of a published version (e.g. `0.1.0`, for production),
# `nightly` (nightly build of the main branch), or the tag of an on-demand build: its branch
# (e.g. `main`) or `sha-<commit>`.
BDTHEQUE_TAG=nightly

# PostgreSQL database
POSTGRES_DB=bdtheque
POSTGRES_USER=bdtheque
POSTGRES_PASSWORD=

# Secret shared between `frontend` and `api` (defense in depth, see contraintes-techniques/architecture-deploiement/architecture-des-tiers.md).
# Generate a random value, e.g. `openssl rand -base64 32`.
INTERNAL_API_KEY=

# The single administrator account, which signs in to the administration: its login, and a long password of your own,
# e.g. a passphrase of several words.
ADMIN_LOGIN=
ADMIN_PASSWORD=

# The second factor of the administrator account: required when PUBLIC_URL is an https address (a deployment exposed
# on the Internet), optional otherwise. Created, and shown as a QR code to scan with an authenticator application, by
# `dotnet run scripts/New-AdminTotpSecret.cs` (see README.md). A new secret revokes every session opened before.
ADMIN_TOTP_SECRET=

# Port published on the host/NAS to access the application.
FRONTEND_PORT=8080

# Behind the reverse proxy of the NAS, which serves HTTPS and relays in HTTP to `frontend`: the address under which
# the browser reaches the application, scheme and host, port included if it is not the default one, without path
# (e.g. `https://bdtheque.example.com`). Leave empty for a deployment reached directly in HTTP (internal deployment).
PUBLIC_URL=

# Host (NAS) directory where visuals are stored (covers, pages, etc.). It must exist and be
# writable by the user the `api` container runs as, or `api` refuses to start (see README).
VISUELS_HOST_PATH=./data/visuels

# Optional: the user the `api` container runs as, `uid:gid` (e.g. `1026:100`). Give it a user that can write to the
# visuals directory, e.g. your NAS user when you created it from File Station: nothing else to change.
# Empty, `api` runs as the user of its image (UID 1654, not root), who must then be given the directory:
# e.g. `mkdir -p ./data/visuels && sudo chown 1654:1654 ./data/visuels`.
API_USER=

# Production (default) or Development.
ASPNETCORE_ENVIRONMENT=Production
