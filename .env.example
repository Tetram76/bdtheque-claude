# Copier ce fichier en `.env` (ignoré par git) et renseigner les valeurs avant `docker compose up`.

# Base de données PostgreSQL
POSTGRES_DB=bdtheque
POSTGRES_USER=bdtheque
POSTGRES_PASSWORD=

# Secret partagé entre `frontend` et `api` (défense en profondeur, cf. contraintes-techniques.md).
# Générer une valeur aléatoire, ex. `openssl rand -base64 32`.
INTERNAL_API_KEY=

# Port publié sur l'hôte/NAS pour accéder à l'application.
FRONTEND_PORT=8080

# Répertoire hôte (NAS) où sont stockés les visuels (couvertures, planches, etc.).
VISUELS_HOST_PATH=./data/visuels

# Production (par défaut) ou Development.
ASPNETCORE_ENVIRONMENT=Production
