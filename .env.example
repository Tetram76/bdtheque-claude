# Copy this file to `.env` (ignored by git) and fill in the values before `docker compose up`.

# Tag of the application images published on Docker Hub (tetram76/bdtheque-api,
# tetram76/bdtheque-frontend): `nightly` (nightly build of the main branch), or the tag of an
# on-demand build: its branch (e.g. `main`) or `sha-<commit>`.
BDTHEQUE_TAG=nightly

# PostgreSQL database
POSTGRES_DB=bdtheque
POSTGRES_USER=bdtheque
POSTGRES_PASSWORD=

# Secret shared between `frontend` and `api` (defense in depth, see contraintes-techniques.md).
# Generate a random value, e.g. `openssl rand -base64 32`.
INTERNAL_API_KEY=

# Port published on the host/NAS to access the application.
FRONTEND_PORT=8080

# Host (NAS) directory where visuals are stored (covers, pages, etc.). It must exist and be
# writable by the user of the `api` container (UID 1654, not root), or `api` refuses to start:
# e.g. `mkdir -p ./data/visuels && sudo chown 1654:1654 ./data/visuels` (see README).
VISUELS_HOST_PATH=./data/visuels

# Production (default) or Development.
ASPNETCORE_ENVIRONMENT=Production
