@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<RecordVisual> L

@* The mention of the kind of a record of the consultation over the visual of its head, written once for the records of an
   album, a series and an author (visuel/fiche-album/contenu.md, choix-implementation/socle/frontend.md): alone on its line,
   as a title, on the left edge of the visual. A subgrid of the rows of the head, so that the identity of the record, which
   the page places on the row of the visual, starts under the mention whatever its height. *@
<div class="record-visual">
    <p class="record-kind">@L[KindKey]</p>
    @ChildContent
</div>

@code {
    /// <summary>The kind of the record: an album, a series or an author, the only records of the consultation.</summary>
    [Parameter, EditorRequired]
    public RecordType Kind { get; set; }

    /// <summary>The visual of the head: the cover of an album, the pile of a series, the monogram of an author.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string KindKey => Kind switch
    {
        RecordType.Album => "Album",
        RecordType.Series => "Series",
        RecordType.Author => "Author",
        _ => throw new ArgumentOutOfRangeException(nameof(Kind), Kind, "Only the records of an album, a series and an author carry the mention of their kind."),
    };
}
