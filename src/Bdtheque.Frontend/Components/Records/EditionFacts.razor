@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<EditionFacts> L
@inject ValueLabels Values
@inject DisplayFormatter Format

@* The detail of the edition chosen on the record of an album (visuel/fiche-album/contenu.md), in two groups: the edition and
   the copy. A data not set stays shown, with « Non renseigné ». The labels of the date and of the amount of the acquisition
   follow its mode (fonctionnel/presentation/libelles-contextuels-sur-l-edition.md). Each amount would be followed by its
   value in euros of the day, and a missing acquisition amount replaced by the estimated value: both belong to the Phase 4
   and are said not available yet, without any value made up. Its dates of creation and modification close it, in the time
   zone of the browser. *@
<div class="edition-detail">
    <div class="edition-group">
        <h3>@L["Edition"]</h3>
        <dl>
            <div>
                <dt>@L["Publisher"]</dt>
                <dd>
                    @if (Edition.PublisherWebsite is { } website)
                    {
                        <a href="@website" target="_blank" rel="noopener noreferrer">@Edition.Edition.PublisherName</a>
                    }
                    else
                    {
                        @Edition.Edition.PublisherName
                    }
                </dd>
            </div>
            @Row(L["Collection"], Edition.Edition.PublisherCollectionName, GrammaticalGender.Feminine)
            @Row(L["Year"], Edition.Edition.PublicationYear?.ToString(CultureInfo.InvariantCulture), GrammaticalGender.Feminine)
            @Row(L["Isbn"], Edition.Edition.Isbn, GrammaticalGender.Masculine)
            @Row(L["Category"], Label(Edition.Category), GrammaticalGender.Feminine)
            @Row(L["Format"], Label(Edition.Format), GrammaticalGender.Masculine)
            @Row(L["Binding"], Label(Edition.Binding), GrammaticalGender.Feminine)
            @Row(L["Orientation"], Label(Edition.Orientation), GrammaticalGender.Feminine)
            @Row(L["ReadingDirection"], Label(Edition.ReadingDirection), GrammaticalGender.Masculine)
            @Row(L["Pages"], Edition.PageCount is { } pages ? Format.Number(pages) : null, GrammaticalGender.Masculine)
            @Row(L["Color"], L[Edition.IsColor ? "Color.Yes" : "Color.No"], GrammaticalGender.Feminine)
        </dl>
    </div>
    <div class="edition-group">
        <h3>@L["Copy"]</h3>
        <dl>
            @Row(L["AcquisitionMode"], Label(Edition.AcquisitionMode), GrammaticalGender.Masculine)
            @Row(L[Purchased ? "Date.Purchase" : "Date.Acquisition"], Edition.AcquisitionDate is { } date ? Format.Date(date) : null, GrammaticalGender.Feminine)
            <div>
                <dt>@L[Purchased ? "Amount.Purchase" : "Amount.Acquisition"]</dt>
                <dd>
                    @if (Edition.AcquisitionAmount is { } amount && Edition.AcquisitionCurrency is { } currency)
                    {
                        @AmountOf(amount, currency)
                    }
                    else if (Edition.IsFree)
                    {
                        @L["Free"]
                    }
                    else
                    {
                        <span class="edition-unavailable">@L["Estimated"]</span>
                    }
                </dd>
            </div>
            <div>
                <dt>@L["InitialValue"]</dt>
                <dd>
                    @if (Edition.InitialValueAmount is { } initial && Edition.InitialValueCurrency is { } initialCurrency)
                    {
                        @AmountOf(initial, initialCurrency)
                    }
                    else
                    {
                        <NotSet Gender="GrammaticalGender.Feminine" />
                    }
                </dd>
            </div>
            @Row(L["SecondHand"], L[Edition.IsSecondHand ? "SecondHand.Yes" : "SecondHand.No"], GrammaticalGender.Feminine)
            @Row(L["Condition"], Label(Edition.Condition), GrammaticalGender.Masculine)
            @Row(L["Dedicated"], L[Edition.IsDedicated ? "Yes" : "No"], GrammaticalGender.Feminine)
            @Row(L["PersonalReference"], Edition.PersonalReference, GrammaticalGender.Feminine)
            @Row(L["PersonalNotes"], Edition.PersonalNotes, GrammaticalGender.Feminine)
        </dl>
    </div>
</div>
<p class="edition-dates" data-local>@Dates</p>

@code {
    [Parameter, EditorRequired]
    public EditionDetail Edition { get; set; } = null!;

    private bool Purchased => Edition.AcquisitionMode == AcquisitionMode.Purchase;

    private string? Label<TEnum>(TEnum? value) where TEnum : struct, Enum => value is { } known ? Values.Of(known) : null;

    private RenderFragment Row(string label, string? value, GrammaticalGender gender) => __builder =>
    {
        <div>
            <dt>@label</dt>
            <dd>
                @if (value is null)
                {
                    <NotSet Gender="gender" />
                }
                else
                {
                    @value
                }
            </dd>
        </div>
    };

    private RenderFragment AmountOf(decimal amount, string currency) => __builder =>
    {
        <span>@Format.Amount(amount, currency)</span>
        <span class="edition-unavailable">@L["EurosOfTheDay"]</span>
    };

    // The date of entry into the collection, which the application sets alone, is left out: beside the date of acquisition,
    // it would read as another date of acquisition (visuel/fiche-album/contenu.md).
    private string Dates => L["Dates", Format.LocalDate(Edition.CreatedAt), Format.LocalDate(Edition.ModifiedAt)];
}
