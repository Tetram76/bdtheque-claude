@inject IStringLocalizer<MergeData> L

@* What the record keeps of the two merged records (visuel/fusion/fusion-de-deux-fiches.md): the head of each record above its
   values, a row per data (MergeChoice), then what the data chosen make of the record. Laid out by the width of the block
   itself (container query): side by side, the values sit under the heads of their records; on a smartphone, the heads go,
   each value carrying the name of its record. *@
<Block Title="@(Title ?? L["Title"])" Kicker="@(Kicker ?? L["Kicker"])" class="merge-data">
    <div class="merge-data-frame">
        <div class="merge-data-grid">
            <span class="merge-data-corner" aria-hidden="true"></span>
            @Head(First)
            @Head(Second)
            @ChildContent
        </div>
    </div>
    @if (Result is not null)
    {
        <p class="merge-data-result">@Result</p>
    }
</Block>

@code {
    /// <summary>The head of the first record: its name, what is linked to it, its last modification.</summary>
    [Parameter, EditorRequired]
    public MergeRecordHead First { get; set; } = null!;

    [Parameter, EditorRequired]
    public MergeRecordHead Second { get; set; } = null!;

    /// <summary>
    /// The title of the block, « Ce que garde la fiche » by default; another block of data to choose has its own (« Collections
    /// homonymes »).
    /// </summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>The mention of the block, « Données » by default.</summary>
    [Parameter]
    public string? Kicker { get; set; }

    /// <summary>The rows of the data (MergeChoice).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>What the data chosen make of the record (e.g. the display name of an author), if anything.</summary>
    [Parameter]
    public RenderFragment? Result { get; set; }

    private RenderFragment Head(MergeRecordHead head) =>
        @<span class="merge-data-head">
            <strong><LabelText Text="@head.Name" /></strong>
            @if (head.ModifiedAt is { } modifiedAt)
            {
                <span class="merge-data-head-detail">
                    @if (head.Links is not null)
                    {
                        @head.Links<text> · </text>
                    }
                    @L["Modified"] <LocalDateTime Value="modifiedAt" DateOnly />
                </span>
            }
        </span>;
}
