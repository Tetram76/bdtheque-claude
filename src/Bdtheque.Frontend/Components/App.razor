@inject BrowserTimeZone TimeZone

<!DOCTYPE html>
@* The time zone the page is rendered in, which the script compares to that of the browser. *@
<html lang="fr" data-time-zone="@TimeZone.Zone.Id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Bdtheque.Frontend.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["browser-time-zone.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
