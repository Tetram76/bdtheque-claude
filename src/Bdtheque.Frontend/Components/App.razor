@inject BrowserTimeZone TimeZone
@inject IThemeSelector ThemeSelector
@inject AudienceOpposition AudienceOpposition
@inject IDayColorsSource DayColors

<!DOCTYPE html>
@* The time zone of the browser the request brought, which the script compares to the current one: the page is current
   whenever its request brought it, even when the server, not knowing it, presents in universal time.
   The theme is carried by the root element, so that a theme redefines the contracts of the base theme for the whole page.
   The opposition of the visitor to the audience measurement too, which the scripts of the page respect. So are the colours
   of the day of a theme painted by them, only known at each request: an enhanced navigation brings them with the theme.
   Those colours are the ones of the date of the browser: the whole page then depends on its time zone (data-local), and is
   rendered again once its request brings it (wwwroot/browser-time-zone.js), dates and times or not. *@
<html lang="fr" data-time-zone="@TimeZone.Name" data-theme="@Theme.Key" data-audience="@(AudienceOpposition.IsOpposed ? "opposed" : null)" style="@_dayStyle" data-local="@Theme.PaintedByTheDay">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="@Assets[Theme.PreloadedFont]" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["themes/base.css"]" />
    @if (Theme.Stylesheet is { } stylesheet)
    {
        <link rel="stylesheet" href="@Assets[stylesheet]" />
    }
    <link rel="stylesheet" href="@Assets["Bdtheque.Frontend.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["browser-time-zone.js"]"></script>
    <script src="@Assets["touch-screen.js"]"></script>
    <script src="@Assets["modal-dialog.js"]"></script>
    <script src="@Assets["scroll-row.js"]"></script>
    <script src="@Assets["fold-row.js"]"></script>
    <script src="@Assets["bibliography-folds.js"]"></script>
    @* The scripts of every offered theme, on every page, each acting only on a page of its theme: an enhanced navigation
       keeps the scripts of the page and never runs those it inserts, while the theme of the visit can change from one
       page to the next (a new date). Before Blazor, as the other scripts: a script draws the page as soon as it is parsed. *@
    @foreach (var script in ThemeCatalog.Offered.Select(theme => theme.Script).OfType<string>())
    {
        <script src="@Assets[script]"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string? _dayStyle;

    private Theme Theme => ThemeSelector.Current;

    protected override async Task OnInitializedAsync()
    {
        if (Theme.PaintedByTheDay)
            _dayStyle = DayPalette.Of(await DayColors.GetAsync()).Style;
    }
}
