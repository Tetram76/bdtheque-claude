@attribute [Route(AppPaths.UniverseRoute)]
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Components.Records
@inject IStringLocalizer<UniverseRecord> L
@inject ApiClient Api
@inject DisplayFormatter Format

@* The record of a universe in the consultation (visuel/fiche-univers/contenu.md): its parents in the breadcrumb, a universe having
   neither list nor entry in the menu; the thought bubble of the universes under the mention of its kind; its name and the
   number of its series, albums and sub-universes; its description; the tree of its universe at the top, where it stands; its
   series and albums, those of its sub-universes
   included, presented as the bibliography of an author, without roles (Records/Bibliography.razor), whole, a record having no
   filter; its dates. Its styles read the contracts of the base theme only (visuel/fiche-univers/declinaison-par-theme.md). *@
<PageTitle>@(_universe?.Name ?? L["Title"])</PageTitle>
<AudienceScreen Function="AudienceFunctions.UniverseRecord" Record="new PresentedRecord(RecordType.Universe, Id)" />

@if (_problem is not null)
{
    <h1 class="visually-hidden">@L["Title"]</h1>
    <ErrorMessage Problem="_problem" />
}
else if (_universe is { } universe)
{
    <RecordBreadcrumb Items="BreadcrumbItems" EditHref="@AppPaths.AdminEditUniverseFromRecord(Id, universe.Name)" EditLabel="@L["Edit"]" />

    <div class="universe-record">
        <div class="universe-head">
            @* Decorative, put forward as a theme puts forward the visual of a record (--record-visual-…). *@
            <RecordVisual Kind="RecordType.Universe">
                <span class="universe-visual" aria-hidden="true"><Icon Name="IconName.Universe" /></span>
            </RecordVisual>

            <div class="universe-identity">
                <h1>@universe.Name</h1>

                <ul class="universe-facts" aria-label="@L["Facts"]">
                    @if (_seriesCount == 0 && _albumCount == 0)
                    {
                        <li class="universe-fact" data-fact="main">@L["Albums.None"]</li>
                    }
                    else
                    {
                        @if (_seriesCount > 0)
                        {
                            <li class="universe-fact" data-fact="main">@Counted("Series", _seriesCount)</li>
                        }
                        @if (_albumCount > 0)
                        {
                            <li class="universe-fact" data-fact="@(_seriesCount == 0 ? "main" : null)">@Counted("Albums", _albumCount)</li>
                        }
                    }
                    @* Its sub-universes at every level, which the tree presents; data not set is not shown. *@
                    @if (_subUniverseCount > 0)
                    {
                        <li class="universe-fact">@L["SubUniverses.Count", Format.Number(_subUniverseCount)]</li>
                    }
                </ul>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(universe.Description))
        {
            <Block Title="@L["Description.Title"]" Kicker="@L["Description.Kicker"]" data-part="description">
                <p class="universe-description">@universe.Description</p>
            </Block>
        }

        @* The whole tree of its universe at the top, a block of its own (visuel/fiche-univers/contenu.md): drawn by its branches,
           each universe leading to its record with what is attached to it on the same line, that of the record put forward
           without a link; no block for a universe at the top without sub-universes, which would show it alone. *@
        @if (universe.Tree.Count > 1)
        {
            <Block Title="@L["Tree.Title"]" Kicker="@L["Tree.Kicker"]" data-part="tree">
                <p class="universe-tree-summary">@TreeSummary</p>
                @Tree(null, "universe-tree")
            </Block>
        }

        @if (universe.Works.Count > 0)
        {
            <Bibliography Entries="universe.Works" Of="RecordType.Universe" />
        }
    </div>

    <p class="universe-dates" data-local>@L["Dates", Format.LocalDate(universe.CreatedAt), Format.LocalDate(universe.ModifiedAt)]</p>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UniverseDetail? _universe;
    private ApiProblem? _problem;
    private int _seriesCount;
    private int _albumCount;
    private int _subUniverseCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _universe = await Api.GetAsync<UniverseDetail>($"/catalog/universes/{Id}");
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            return;
        }

        _seriesCount = _universe.Works.Count(e => e.Series is not null);
        // Every album attached, in a series or not: a series attached itself presents all of them.
        _albumCount = _universe.Works.Sum(e => e.Series?.Albums.Count ?? 1);
        // Its sub-universes at every level: those of the tree it is an ancestor of.
        _subUniverseCount = _universe.Tree.Count(u => u.Id != Id && Ancestry(u).Contains(Id));
    }

    // The ancestors of a universe of the tree, from its parent up.
    private IEnumerable<Guid> Ancestry(UniverseInTree universe)
    {
        for (var parentId = universe.ParentId; parentId is { } id; parentId = _universe!.Tree.First(u => u.Id == id).ParentId)
            yield return id;
    }

    private string Counted(string key, int count) => L[count > 1 ? $"{key}.Other" : $"{key}.One", Format.Number(count)];

    // The number of universes of the tree, that of the levels it spans, and their order.
    private string TreeSummary
    {
        get
        {
            var tree = _universe!.Tree;
            var levels = tree.Max(u => Ancestry(u).Count() + 1);
            return L["Tree.Summary",
                L[tree.Count > 1 ? "Universes.Other" : "Universes.One", Format.Number(tree.Count)],
                L[levels > 1 ? "Levels.Other" : "Levels.One", Format.Number(levels)]];
        }
    }

    // What is attached to a universe of the tree, as its own record says it: its series and its albums, a number at zero left
    // out, or that nothing is, as the facts say it.
    private string Works(UniverseInTree universe)
    {
        var works = new List<string>();
        if (universe.SeriesCount > 0)
            works.Add(Counted("Series", universe.SeriesCount));
        if (universe.AlbumCount > 0)
            works.Add(Counted("Albums", universe.AlbumCount));
        return works.Count > 0 ? string.Join(" · ", works) : L["Albums.None"];
    }

    // The universes under a parent, or at the top, each followed by its sub-universes; the API gives them in the order of the
    // hierarchy, siblings by name, each saying its parent. The universe of the record is put forward, without a link to the
    // page shown.
    private RenderFragment Tree(Guid? parentId, string? listClass = null) => __builder =>
    {
        <ul class="@listClass">
            @foreach (var universe in _universe!.Tree.Where(u => u.ParentId == parentId))
            {
                <li>
                    <span class="tree-universe">
                        @if (universe.Id == Id)
                        {
                            <strong class="tree-current" aria-current="page">@universe.Name</strong>
                        }
                        else
                        {
                            <a href="@AppPaths.UniverseRecord(universe.Id)">@universe.Name</a>
                        }
                        <span class="tree-universe-works">@Works(universe)</span>
                    </span>
                    @if (_universe.Tree.Any(u => u.ParentId == universe.Id))
                    {
                        @Tree(universe.Id)
                    }
                </li>
            }
        </ul>
    };

    // The parents of the universe, from the top down, each leading to its record, then the universe itself: a universe has no
    // list to lead back to.
    private IReadOnlyList<BreadcrumbItem> BreadcrumbItems =>
    [
        // « Univers » leads nowhere, the universes having no list in the consultation, but says from the first level what the
        // record presents, as « Albums » opens the breadcrumb of an album (visuel/fiche-univers/contenu.md).
        new(L["Breadcrumb.Universes"]),
        .. _universe!.Ancestors.Select(ancestor => new BreadcrumbItem(ancestor.Name, AppPaths.UniverseRecord(ancestor.Id))),
        new(_universe.Name),
    ];
}
