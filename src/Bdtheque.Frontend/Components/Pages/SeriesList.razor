@attribute [Route(AppPaths.Series)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@inject IStringLocalizer<SeriesList> L
@inject ApiClient Api
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject ListMemory Memory
@inject NavigationManager Navigation

@* The list of the series of the consultation, after the model of that of the albums: every series of the base, its albums in
   the collection shown, and limited to the collection by its own filter of the possession, the same as in every list
   (fonctionnel/regles-metier/perimetre-de-la-consultation.md). Rendered statically, like the lists of the administration, whose
   search, filters, navigation and empty lists it shares: its criteria and the panel of its filters are carried by its address
   (Lists/CatalogSeriesListQuery.cs). Each row leads to the record of its series, the consultation having neither entry nor
   action. Its styles read the contracts of the base theme only. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.SeriesList" />

<ListLayout Title="@L["ListTitle"]" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_wholeCount" InAdministration="false" />
    </Heading>
    <ChildContent>
        <ListSearch Action="@AppPaths.Series" FieldId="series-search" TextName="@ListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" ClearHref="@_query.WithoutSearchHref()" PanelId="series-filters"
                    FiltersName="@ListQuery.FiltersName" FiltersOpenValue="@ListQuery.FiltersOpenValue"
                    FiltersOpen="_query.FiltersOpen" FilterCount="_query.ActiveFilterCount" Panel="FiltersPanel"
                    HiddenFilters="KeptFilters" />

        <ActiveFilters Filters="ActiveFilterTags()" ClearHref="@_query.WithoutFilters().Href()" />

        <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (_query with { Entry = entry, Page = 1 }).Href())" />

        <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@_query.IsNarrowed" WholeCount="_wholeCount" Order="@L["Order"]" />

        @if (_list!.Series.Items.Count == 0)
        {
            switch (_query.EmptyReason)
            {
                case EmptyListReason.Search:
                    <EmptyList Message="@L["Empty.Text", _query.Text!]" SearchedIn="@L["Empty.SearchedIn"]">
                        <Actions>
                            <Button Href="@_query.WithoutSearchHref()" Label="@L["Empty.Clear"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case EmptyListReason.Filters:
                    <EmptyList Message="@L["Empty.Criteria"]">
                        <Actions>
                            <Button Href="@_query.WithoutFilters().Href()" Label="@L["Empty.ClearFilters"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case EmptyListReason.Entry:
                    <EmptyList Message="@L["Empty.Entry"]">
                        <Actions>
                            <Button Href="@AppPaths.Series" Label="@L["Empty.All"]" />
                        </Actions>
                    </EmptyList>
                    break;
                default:
                    <EmptyList Message="@L["Empty.None"]" />
                    break;
            }
        }
        else
        {
            <CatalogSeriesRows Rows="_list.Series.Items" Label="@L["Title"]" />

            <Pagination Number="_list.Series.Number" Size="_list.Series.Size" TotalCount="_list.Series.TotalCount"
                        ItemsLabel="@L["Title"]" PageHref="@(page => (_query with { Page = page }).Href())" />
        }
    </ChildContent>
</ListLayout>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CatalogSeriesListQuery _query = CatalogSeriesListQuery.All;
    private SeriesCatalogList? _list;
    private int? _wholeCount;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        _query = CatalogSeriesListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            _list = await Api.GetAsync<SeriesCatalogList>(_query.ApiPath());
            // A page beyond the last one (an old address) is no empty list: its series are on the pages before it, the last of
            // which it leads to, with the same criteria.
            if (_list.Series is { Items.Count: 0, TotalCount: > 0 } series && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (series.TotalCount + series.Size - 1) / series.Size }).Href());
                return;
            }

            // The number of all the series, which the heading gives: that of the list itself, unless its criteria narrow it.
            _wholeCount = _query.IsNarrowed || _query.Entry is not null
                ? (await Api.GetAsync<SeriesCatalogList>(CatalogSeriesListQuery.All.ApiPath(1))).Series.TotalCount
                : _list.Series.TotalCount;
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        // The list as it presents itself, which a record and the menu lead back to (fonctionnel/structure-de-l-application.md,
        // Retour à une liste).
        Memory.Keep(_query);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    private string CountText() => _list!.Series.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // The filters chosen, each with the list without it; a record that no longer exists is no filter of the list.
    private IReadOnlyList<ActiveFilters.ActiveFilter> ActiveFilterTags()
    {
        var filters = _list!.Filters;
        var tags = new List<ActiveFilters.ActiveFilter>();
        void Add(string name, string? value, CatalogSeriesListQuery without)
        {
            if (value is not null)
                tags.Add(new(L[$"Filter.{name}"].Value, value, (without with { Page = 1 }).Href()));
        }

        Add("Author", filters.Author is { } author ? RecordSearch.AuthorName(author.LastName, author.FirstName, author.Pseudonym) : null,
            _query with { AuthorId = null });
        Add("Publisher", filters.Publisher?.Name, _query with { PublisherId = null });
        Add("PublisherCollection", filters.PublisherCollection?.Name, _query with { PublisherCollectionId = null });
        Add("Genre", filters.Genre?.Label, _query with { GenreId = null });
        Add("Universe", filters.Universe?.Name, _query with { UniverseId = null });
        // The possession is not that of the series: the tag names its albums, as the option does
        // (fonctionnel/regles-metier/perimetre-de-la-consultation.md).
        Add("State", _query.State is { } state ? Possession[$"OfAlbums.{state}"].Value : null, _query with { State = null });
        return tags;
    }

    [Inject]
    private IStringLocalizer<PossessionFilterField> Possession { get; set; } = null!;

    private RenderFragment FiltersPanel => @<SeriesFilterFields Filters="_list!.Filters" OffersPossession="true" State="_query.State" />;

    // The filters chosen, kept by the search while their panel is folded.
    private RenderFragment KeptFilters => @<QueryFields Parameters="@((_query with { Text = null, Entry = null, Page = 1 }).Parameters())" />;
}
