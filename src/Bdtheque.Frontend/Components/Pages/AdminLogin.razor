@attribute [Route(AppPaths.AdminLogin)]
@using Bdtheque.Frontend.Api
@using Bdtheque.Frontend.Security
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IStringLocalizer<AdminLogin> L
@inject AdminCredentials Credentials
@inject AdminSecondFactor SecondFactor
@inject AdminSessions Sessions
@inject LoginThrottle Throttle
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The login of the administration (contraintes-techniques/architecture-deploiement/authentification.md), outside it: open
   to anyone, in the theme of the visit. Rendered statically, as a page that writes the authentication cookie must be
   (choix-implementation/socle/frontend.md); once signed in, back to the page that asked for it. The login has the focus as
   the page opens, and again as it is given back after a refusal, the login typed kept. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.AdminLogin" />

<div class="admin-login">
    <Block Title="@L["Title"]" HeadingLevel="1" Raised="true">
        <p>@(SecondFactor.IsRequired ? L["IntroWithCode"] : L["Intro"])</p>
        @if (_problem is not null)
        {
            <ErrorMessage Problem="_problem" Label="@_label" Message="@_message" />
        }
        <form method="post" @formname="@FormName" @onsubmit="SignInAsync">
            <AntiforgeryToken />
            <Field Id="admin-login-name" Label="@L["Login"]" Context="field">
                <input id="@field.Id" name="@nameof(Login)" type="text" value="@Login" autocomplete="username"
                       autocapitalize="none" spellcheck="false" required autofocus tabindex="0" />
            </Field>
            <Field Id="admin-login-password" Label="@L["Password"]" Context="field">
                <input id="@field.Id" name="@nameof(Password)" type="password" autocomplete="current-password" required />
            </Field>
            @* Under the password, in the same form: a refusal never tells which of the three was wrong
               (fonctionnel/structure-de-l-application.md). *@
            @if (SecondFactor.IsRequired)
            {
                <Field Id="admin-login-code" Label="@L["Code"]" Context="field">
                    <input id="@field.Id" name="@nameof(Code)" type="text" inputmode="numeric" autocomplete="one-time-code"
                           pattern="[0-9 ]*" maxlength="7" required />
                </Field>
            }
            <Button Type="submit" Variant="ButtonVariant.Primary" Label="@L["SignIn"]" />
        </form>
    </Block>
</div>

@code {
    private const string FormName = "admin-login";

    private ApiProblem? _problem;
    private string? _label;
    private string? _message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromQuery(Name = AppPaths.ReturnUrlParameter)]
    private string? ReturnUrl { get; set; }

    [SupplyParameterFromForm(FormName = FormName)]
    private string? Login { get; set; }

    [SupplyParameterFromForm(FormName = FormName)]
    private string? Password { get; set; }

    [SupplyParameterFromForm(FormName = FormName)]
    private string? Code { get; set; }

    // Already signed in: nothing to ask, straight to the page asked for.
    protected override void OnInitialized()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method) && HttpContext.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo(ReturnPath.AfterSignIn(ReturnUrl, new Uri(Navigation.BaseUri)));
    }

    private async Task SignInAsync()
    {
        // Too many failures of late: refused without even checking, which would otherwise go on telling a right guess.
        if (Throttle.IsBlocked())
        {
            Refuse(ProblemCategory.Functional, "TooManyAttempts", L["TooManyAttempts.Label"]);
            return;
        }

        // The code is checked only for the right credentials: once accepted it can no longer be used, and a typing error in
        // the password must not spend the code of the administrator.
        if (!Credentials.AreValid(Login, Password) || (SecondFactor.IsRequired && !SecondFactor.IsValid(Code)))
        {
            Throttle.RecordFailure();
            Refuse(ProblemCategory.Business, SecondFactor.IsRequired ? "InvalidCredentialsOrCode" : "InvalidCredentials", L["InvalidCredentials.Label"]);
            return;
        }

        Throttle.Reset();
        var administrator = Sessions.SignIn();
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, administrator);
        // The cookie only authenticates the requests that follow: this one, from now on that of the administrator, records
        // the login in a visit of the administrator.
        HttpContext.User = administrator;
        await Recorder.RecordActionAsync(AudienceFunctions.AdminSignedIn, cancellationToken: HttpContext.RequestAborted);
        Navigation.NavigateTo(ReturnPath.AfterSignIn(ReturnUrl, new Uri(Navigation.BaseUri)));
    }

    // The login is kept, never the password, which is typed again.
    private void Refuse(ProblemCategory category, string message, string? label = null)
    {
        _problem = new ApiProblem(category, null, null, null);
        _label = label;
        _message = L[message];
    }
}
