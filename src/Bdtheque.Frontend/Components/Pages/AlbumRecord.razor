@attribute [Route(AppPaths.AlbumRoute)]
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Components.Records
@inject IStringLocalizer<AlbumRecord> L
@inject ApiClient Api
@inject RecordLabels Labels
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The record of an album in the consultation (visuel/fiche-album/contenu.md): the cover and the identity of the album, its
   contributions, genres and universes; its summary; its editions in the collection, each with its visuals and its detail,
   an edition targeted by a purchase intent being never presented as an edition, but under them with the other intents
   (fonctionnel/regles-metier/intention-d-achat.md); the rest of its series; its dates; and the viewer of a visual, a dialog
   above the record that its address opens (Navigation/AlbumRecordQuery.cs). Its styles read the contracts of the base theme only
   (visuel/fiche-album/declinaison-par-theme.md). *@
<PageTitle>@(_album is null ? L["Title"] : Labels.Album(_album.Album, _format))</PageTitle>
<AudienceScreen Function="AudienceFunctions.AlbumRecord" Record="new PresentedRecord(RecordType.Album, Id)" />

@if (_problem is not null)
{
    <h1 class="visually-hidden">@L["Title"]</h1>
    <ErrorMessage Problem="_problem" />
}
else if (_album is { } album)
{
    <Breadcrumb Items="BreadcrumbItems" />

    <div class="album-record">
        <div class="album-head">
            @* The cover of the album, put forward as a theme puts it (--record-visual-…, themes/base.css). *@
            <div class="album-cover">
                <Cover VisualId="CoverId" Alt="@L["Cover", Heading]" Volume="true" />
            </div>

            <div class="album-identity">
                @* Not in the collection, at first glance: wished for, or catalogued only (visuel/fiche-album/contenu.md). *@
                <CollectionStatus State="CollectionState" />
                <div class="album-title">
                    @if (album.Album.SeriesId is { } seriesId)
                    {
                        <a class="album-series" href="@AppPaths.SeriesRecord(seriesId)">@album.Album.SeriesTitle</a>
                    }
                    <h1>@Heading</h1>
                </div>

                <ul class="album-facts" aria-label="@L["Facts"]">
                    @if (Labels.Volume(album.Album) is { } volume)
                    {
                        <li class="album-fact" data-fact="volume">@volume</li>
                    }
                    @if (album.FirstPublicationYear is { } year)
                    {
                        <li class="album-fact">@L["Published", Format.PartialDate(year, album.FirstPublicationMonth)]</li>
                    }
                    <li class="album-membership">
                        <Tag Text="@Membership" Variant="@(album.Album.IsInCollection ? TagVariant.Filled : TagVariant.Dashed)"
                             Icon="@(!album.Album.IsInCollection && IsIntended ? IconName.PurchaseIntent : null)" />
                    </li>
                </ul>

                @* Data not set is not shown in the consultation (visuel/charte-graphique/convivialite-et-efficacite.md). *@
                @if (album.Rating is not null)
                {
                    <div class="album-rating">
                        <RatingStars Rating="album.Rating" />
                    </div>
                }

                <ContributionsByRole Contributions="album.Contributions" />
                <Classification Genres="album.Genres" Universes="album.Universes" />
            </div>
        </div>

        <Block Title="@L["Story.Title"]" Kicker="@L["Story.Kicker"]">
            @if (album.Summary is { } summary)
            {
                <p class="album-summary">@summary</p>
            }
            else
            {
                <p><NotSet /></p>
            }
            <h3 class="album-notes-title">@L["Notes"]</h3>
            @if (album.PersonalNotes is { } notes)
            {
                <p class="album-notes">@notes</p>
            }
            else
            {
                <p><NotSet Gender="GrammaticalGender.Feminine" /></p>
            }
        </Block>

        @* Without edition in the collection, nothing says so in their place: the banner and the membership of the album already
           do; and an album with neither edition nor intent has no block that would hold nothing (visuel/fiche-album/contenu.md). *@
        @if (_owned.Count > 0 || IsIntended)
        {
            <Block Title="@L["Editions.Title"]" Kicker="@L["Editions.Kicker"]" data-part="editions">
                @if (_owned.Count > 0)
                {
                    @* Every edition of the collection at once, each with its visuals and its detail: an album has one, rarely more. *@
                    <ol class="editions">
                        @foreach (var edition in _owned)
                        {
                            var label = Labels.Edition(edition.Edition);
                            <li class="edition">
                                <h3 class="edition-label"><LabelText Text="@label" /></h3>
                                <EditionVisuals AlbumId="Id" Edition="edition" EditionLabel="@label" Open="@(edition == _open ? _position : null)" />
                                <EditionFacts Edition="edition" />
                            </li>
                        }
                    </ol>
                }
                <AlbumIntents AlbumIntent="album.PurchaseIntent" Editions="album.Editions" />
            </Block>
        }

        @if (album.Album.SeriesId is { } series)
        {
            <RestOfSeries AlbumId="Id" SeriesId="series" SeriesTitle="@(album.Album.SeriesTitle!)" Albums="album.SeriesAlbums" LabelFormat="_format" />
        }
    </div>

    <p class="album-dates" data-local>@L["Dates", Format.LocalDate(album.CreatedAt), Format.LocalDate(album.ModifiedAt)]</p>

    @if (_open is { } open)
    {
        <VisualDialog AlbumId="Id" Edition="open" EditionLabel="@Labels.Edition(open.Edition)" Position="_position" />
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private AlbumDetail? _album;
    private AlbumLabelFormat _format;
    private ApiProblem? _problem;
    private List<EditionDetail> _owned = [];
    private EditionDetail? _open;
    private int _position;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var query = AlbumRecordQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            _format = (await Api.GetAsync<ApplicationSettings>("/catalog/settings")).AlbumLabelFormat;
            _album = await Api.GetAsync<AlbumDetail>($"/catalog/albums/{Id}");
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            return;
        }

        // Only the editions of the collection are editions; an edition targeted by an intent is one of the intents
        // (fonctionnel/regles-metier/intention-d-achat.md). A visual the collection does not have, which only an address
        // written by hand names, opens no viewer.
        _owned = [.. _album.Editions.Where(e => e.IsInCollection)];
        if (_owned.Find(e => e.Edition.Id == query.Edition) is { } edition && query.Visual is { } visual && visual <= edition.Visuals.Count)
            (_open, _position) = (edition, visual);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    // The cover of the album (fonctionnel/regles-metier/couverture-d-un-album.md), among the editions of the collection: the
    // first cover of the oldest edition by its year of edition that has one, those without year last; none, the generic
    // visual.
    private Guid? CoverId => _owned
        .Where(e => e.Visuals.Any(v => v.Type == VisualType.Cover))
        .OrderBy(e => e.Edition.PublicationYear is null)
        .ThenBy(e => e.Edition.PublicationYear)
        .Select(e => e.Visuals.First(v => v.Type == VisualType.Cover).Id)
        .Cast<Guid?>()
        .FirstOrDefault();

    private string Heading => _album!.Album.Title ?? Labels.Album(_album.Album, _format);

    private IReadOnlyList<BreadcrumbItem> BreadcrumbItems =>
    [
        new(L["Breadcrumb.Albums"], AppPaths.Albums),
        .. _album!.Album.SeriesId is { } series ? [new BreadcrumbItem(_album.Album.SeriesTitle!, AppPaths.SeriesRecord(series))] : Array.Empty<BreadcrumbItem>(),
        new(Heading),
    ];

    private int OwnedEditionCount => _owned.Count;

    private Bdtheque.Contracts.Admin.AlbumCollectionState CollectionState => (_album!.Album.IsInCollection, IsIntended) switch
    {
        (true, _) => Bdtheque.Contracts.Admin.AlbumCollectionState.InCollection,
        (false, true) => Bdtheque.Contracts.Admin.AlbumCollectionState.PurchaseIntent,
        _ => Bdtheque.Contracts.Admin.AlbumCollectionState.OutsideCollection,
    };

    private bool IsIntended => _album!.PurchaseIntent is not null || _album.Editions.Any(e => e.PurchaseIntent is not null);

    private string Membership => (_album!.Album.IsInCollection, OwnedEditionCount, IsIntended) switch
    {
        (true, 1, _) => L["Membership.InCollection.One", 1],
        (true, var count, _) => L["Membership.InCollection.Other", count],
        (false, _, true) => L["Membership.PurchaseIntent"],
        _ => L["Membership.OutOfCollection"],
    };
}
