@page "/Error"
@inject IStringLocalizer<Error> L

@* Reached by the exception handler for an unhandled error: a technical error, which discloses nothing of
   its cause (fonctionnel/presentation-des-erreurs.md). *@
<PageTitle>@L["Title"]</PageTitle>

<section class="block">
    <h1 class="block-title">@L["Title"]</h1>
    <ErrorMessage Problem="ApiProblem.Technical()" />
</section>
