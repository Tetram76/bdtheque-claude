@attribute [Route(AppPaths.Home)]
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Frontend.Api
@using Bdtheque.Frontend.Components.Dashboard
@inject ApiClient Api
@inject BrowserTimeZone TimeZone
@inject TimeProvider Clock
@inject IStringLocalizer<Home> L

@* The home page of the consultation (fonctionnel/page-accueil.md): the dashboard, or, without any owned edition, the welcome
   screen of an empty collection, which the API tells by a dashboard without content. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.Home" />
<FooterAdministrationLink />

@if (_problem is not null)
{
    <h1 class="visually-hidden">@L["Title"]</h1>
    <ErrorMessage Problem="_problem" />
}
else if (_dashboard?.Content is { } content)
{
    <DashboardBoard Content="content" LabelFormat="_settings!.AlbumLabelFormat" />
}
else if (_dashboard is not null)
{
    <EmptyCollectionWelcome />
}

@code {
    /// <summary>The latest entries the themes present: those of the mockups (visuel/dashboard/).</summary>
    internal const int LatestCount = 6;

    private ApplicationSettings? _settings;
    private Contracts.Catalog.Dashboard? _dashboard;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The day of the visitor, in the time zone of their browser: that of the edition in the spotlight. Unknown on a
            // first page, rendered again once the browser gave it (DashboardBoard, data-local): the dashboard is then asked
            // without any day, so that no edition is drawn for a day the visitor does not live.
            var day = TimeZone.Today(Clock) is { } today
                ? $"day={today.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)}&"
                : "";
            _settings = await Api.GetAsync<ApplicationSettings>("/catalog/settings");
            _dashboard = await Api.GetAsync<Contracts.Catalog.Dashboard>($"/catalog/dashboard?{day}latestCount={LatestCount}");
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
        }
    }
}
