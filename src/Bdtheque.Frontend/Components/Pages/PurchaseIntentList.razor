@attribute [Route(AppPaths.PurchaseIntents)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@inject IStringLocalizer<PurchaseIntentList> L
@inject ApiClient Api
@inject RecordLabels Labels
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject ListMemory Memory
@inject NavigationManager Navigation

@* The public list of the purchase intents (fonctionnel/structure-de-l-application.md), after the model of the list of the
   albums of the consultation, its rows those of the list of the administration without its actions (visuel/listes/liste-par-liste.md):
   each intent presented as an intent, with what it targets, the whole album or an edition
   (fonctionnel/regles-metier/intention-d-acquisition.md), its album leading to its record. Its search, the navigation by
   initial of its albums and the cross filters of the albums, applied to the album of each intent, are carried by its address
   (Lists/CatalogPurchaseIntentListQuery.cs); the possession is none of its filters, of no interest there
   (fonctionnel/regles-metier/perimetre-de-la-consultation.md). Its styles read the contracts of the base theme only. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.PurchaseIntents" />

<ListLayout Title="@L["ListTitle"]" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_wholeCount" InAdministration="false" />
    </Heading>
    <ChildContent>
        <ListSearch Action="@AppPaths.PurchaseIntents" FieldId="intents-search" TextName="@ListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" ClearHref="@_query.WithoutSearchHref()" PanelId="intents-filters"
                    FiltersName="@ListQuery.FiltersName" FiltersOpenValue="@ListQuery.FiltersOpenValue"
                    FiltersOpen="_query.FiltersOpen" FilterCount="_query.ActiveFilterCount" Panel="FiltersPanel"
                    HiddenFilters="KeptFilters" />

        <ActiveFilters Filters="ActiveFilterTags()" ClearHref="@_query.WithoutFilters().Href()" />

        <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (_query with { Entry = entry, Page = 1 }).Href())" />

        <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@_query.IsNarrowed" WholeCount="_wholeCount" Order="@L["Order"]" />

        @if (_list!.Intents.Items.Count == 0)
        {
            switch (_query)
            {
                case { EmptyReason: EmptyListReason.Search, Text: { } text }:
                    <EmptyList Message="@L["Empty.Text", text]" SearchedIn="@L["Empty.SearchedIn"]">
                        <Actions>
                            <Button Href="@_query.WithoutSearchHref()" Label="@L["Empty.Clear"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case { EmptyReason: EmptyListReason.Filters }:
                    <EmptyList Message="@L["Empty.Criteria"]">
                        <Actions>
                            <Button Href="@_query.WithoutFilters().Href()" Label="@L["Empty.ClearFilters"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case { EmptyReason: EmptyListReason.Entry }:
                    <EmptyList Message="@L["Empty.Entry"]">
                        <Actions>
                            <Button Href="@AppPaths.PurchaseIntents" Label="@L["Empty.All"]" />
                        </Actions>
                    </EmptyList>
                    break;
                default:
                    <EmptyList Message="@L["Empty.None"]" />
                    break;
            }
        }
        else
        {
            <div class="intent-rows" role="table" aria-label="@L["Title"]">
                <div class="intent-row intent-row-head" role="row">
                    <span class="intent-cover" role="columnheader"><span class="visually-hidden">@L["Column.Cover"]</span></span>
                    <span class="intent-main" role="columnheader">@L["Column.Album"]</span>
                    <span class="intent-target" role="columnheader">@L["Column.Target"]</span>
                    <span class="intent-state" role="columnheader">@L["Column.State"]</span>
                    <span class="intent-created" role="columnheader">@L["Column.Created"]</span>
                </div>
                @foreach (var row in _list.Intents.Items)
                {
                    <div class="intent-row" role="row">
                        <span class="intent-cover" role="cell"><Cover VisualId="row.Cover?.VisualId" /></span>
                        <span class="intent-main" role="cell">
                            <RowEntry><a href="@AppPaths.Album(row.Album.Id)">@Labels.Album(row.Album, _settings!.AlbumLabelFormat)</a></RowEntry>
                        </span>
                        <span class="intent-meta">
                            @* What the intent targets, told apart at first glance: the whole album, any edition doing, or one
                               edition, named beside it, its publisher leading to its site. *@
                            <span class="intent-target" role="cell">
                                @if (row.Edition is { } edition)
                                {
                                    <Tag Text="@L["Target.Edition"]" Variant="TagVariant.Outlined" Icon="IconName.Edition" />
                                    <span class="intent-target-detail intent-target-edition">
                                        <EditionLabelText Edition="edition" PublisherWebsite="@row.PublisherWebsite" />
                                    </span>
                                }
                                else
                                {
                                    <Tag Text="@L["Target.Album"]" Variant="TagVariant.Accent" Icon="IconName.Album" />
                                    <span class="intent-target-detail">@L["Target.AnyEdition"]</span>
                                }
                            </span>
                            <span class="intent-state" role="cell"><CollectionStateTag State="row.State" /></span>
                            <span class="intent-created" role="cell">
                                <span class="intent-caption">@L["Column.Created"]</span> <LocalDateTime Value="row.CreatedAt" DateOnly="true" />
                            </span>
                        </span>
                    </div>
                }
            </div>

            <Pagination Number="_list.Intents.Number" Size="_list.Intents.Size" TotalCount="_list.Intents.TotalCount"
                        ItemsLabel="@L["Title"]" PageHref="@(page => (_query with { Page = page }).Href())" />
        }
    </ChildContent>
</ListLayout>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CatalogPurchaseIntentListQuery _query = CatalogPurchaseIntentListQuery.All;
    private ApplicationSettings? _settings;
    private PurchaseIntentCatalogList? _list;
    private int? _wholeCount;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        _query = CatalogPurchaseIntentListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            _settings = await Api.GetAsync<ApplicationSettings>("/catalog/settings");
            _list = await Api.GetAsync<PurchaseIntentCatalogList>(_query.ApiPath());
            // A page beyond the last one (an old address) is no empty list: its intents are on the pages before it, the last of
            // which it leads to, with the same criteria.
            if (_list.Intents is { Items.Count: 0, TotalCount: > 0 } intents && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (intents.TotalCount + intents.Size - 1) / intents.Size }).Href());
                return;
            }

            // The number of all the intents, which the heading gives: that of the list itself, unless its criteria narrow it.
            _wholeCount = _query.IsNarrowed || _query.Entry is not null
                ? (await Api.GetAsync<PurchaseIntentCatalogList>(CatalogPurchaseIntentListQuery.All.ApiPath(1))).Intents.TotalCount
                : _list.Intents.TotalCount;
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        // The list as it presents itself, whose filters the menu keeps (fonctionnel/structure-de-l-application.md, Retour à une liste).
        Memory.Keep(_query);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    private string CountText() => _list!.Intents.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // The filters chosen, each with the list without it; a record that no longer exists is no filter of the list.
    private IReadOnlyList<ActiveFilters.ActiveFilter> ActiveFilterTags()
    {
        var filters = _list!.Filters;
        var tags = new List<ActiveFilters.ActiveFilter>();
        void Add(string name, string? value, CatalogPurchaseIntentListQuery without)
        {
            if (value is not null)
                tags.Add(new(L[$"Filter.{name}"].Value, value, (without with { Page = 1 }).Href()));
        }

        Add("Series", filters.Series?.Title, _query with { SeriesId = null });
        Add("Author", filters.Author is { } author ? RecordSearch.AuthorName(author.LastName, author.FirstName, author.Pseudonym) : null,
            _query with { AuthorId = null });
        Add("Publisher", filters.Publisher?.Name, _query with { PublisherId = null });
        Add("PublisherCollection", filters.PublisherCollection?.Name, _query with { PublisherCollectionId = null });
        Add("Genre", filters.Genre?.Label, _query with { GenreId = null });
        Add("Universe", filters.Universe?.Name, _query with { UniverseId = null });
        return tags;
    }

    private RenderFragment FiltersPanel => @<AlbumFilterFields Filters="_list!.Filters" WithPossession="false" />;

    // The filters chosen, kept by the search while their panel is folded.
    private RenderFragment KeptFilters => @<QueryFields Parameters="@((_query with { Text = null, Entry = null, Page = 1 }).Parameters())" />;
}
