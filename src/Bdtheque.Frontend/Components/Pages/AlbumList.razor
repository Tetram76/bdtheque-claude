@attribute [Route(AppPaths.Albums)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Frontend.Components.Lists
@inject IStringLocalizer<AlbumList> L
@inject ApiClient Api
@inject RecordLabels Labels
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The list of the albums of the consultation, model of its other lists: every album of the base, owned or not, its possession
   marked (fonctionnel/regles-metier/perimetre-de-la-consultation.md), each leading to its record. Rendered statically, its criteria
   are carried by its address (Lists/CatalogAlbumListQuery.cs): the possession, the filter that limits it to the collection,
   kept as long as the list, its entry of the navigation by initial and its page. Each album is named by its full label, the list
   mixing the series (fonctionnel/presentation/libelle-d-un-album.md), and shown by the cover the API takes among the editions the
   filter shows (fonctionnel/regles-metier/couverture-d-un-album.md). Its styles read the contracts of the base theme only. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.Albums" />

<CatalogListLayout Title="@L["Title"]" TotalCount="_wholeCount" ListTitle="@L["ListTitle"]" Kicker="@L["Kicker"]" Problem="_problem"
                   Loaded="@(_list is not null)">
    <FilterChoices Label="@L["Possession"]" Choices="PossessionChoices()" />

    <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (_query with { Entry = entry, Page = 1 }).Href())" />

    <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@(_query.ActiveFilterCount > 0)" WholeCount="_wholeCount"
                 Order="@L["Order"]" />

    @if (_list!.Items.Count == 0)
    {
        switch (_query.EmptyReason)
        {
            case EmptyListReason.Filters:
                <EmptyList Message="@L["Empty.Filter"]">
                    <Actions>
                        <Button Href="@_query.WithState(null).Href()" Label="@L["Empty.ClearFilter"]" />
                    </Actions>
                </EmptyList>
                break;
            case EmptyListReason.Entry:
                <EmptyList Message="@L["Empty.Entry"]">
                    <Actions>
                        <Button Href="@AppPaths.Albums" Label="@L["Empty.All"]" />
                    </Actions>
                </EmptyList>
                break;
            default:
                <EmptyList Message="@L["Empty.None"]" />
                break;
        }
    }
    else
    {
        <div class="album-rows" role="table" aria-label="@L["Title"]">
            <div class="album-row album-row-head" role="row">
                <span class="album-cover" role="columnheader"><span class="visually-hidden">@L["Column.Cover"]</span></span>
                <span class="album-main" role="columnheader">@L["Column.Album"]</span>
                <span class="album-date" role="columnheader">@L["Column.Date"]</span>
                <span class="album-state" role="columnheader">@L["Column.State"]</span>
            </div>
            @foreach (var row in _list.Items)
            {
                <div class="album-row" role="row">
                    <span class="album-cover" role="cell"><Cover VisualId="row.Cover?.VisualId" /></span>
                    <span class="album-main" role="cell">
                        <RowEntry Detail="@AuthorsText(row)"><a href="@AppPaths.Album(row.Album.Id)">@Labels.Album(row.Album, _settings!.AlbumLabelFormat)</a></RowEntry>
                    </span>
                    <span class="album-meta">
                        <span class="album-date" role="cell">
                            @if (row.FirstPublicationYear is { } year)
                            {
                                @Format.PartialDate(year, row.FirstPublicationMonth)
                            }
                            else
                            {
                                <NotSet Gender="GrammaticalGender.Feminine" Brief="true" />
                            }
                        </span>
                        <span class="album-state" role="cell"><CollectionStateTag State="row.State" /></span>
                    </span>
                </div>
            }
        </div>

        <Pagination Number="_list.Number" Size="_list.Size" TotalCount="_list.TotalCount" ItemsLabel="@L["Title"]"
                    PageHref="@(page => (_query with { Page = page }).Href())" />
    }
</CatalogListLayout>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CatalogAlbumListQuery _query = CatalogAlbumListQuery.All;
    private ApplicationSettings? _settings;
    private Page<AlbumListItem>? _list;
    private int? _wholeCount;
    private ApiProblem? _problem;

    protected override async Task OnInitializedAsync()
    {
        _query = CatalogAlbumListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            _settings = await Api.GetAsync<ApplicationSettings>("/catalog/settings");
            _list = await Api.GetAsync<Page<AlbumListItem>>(_query.ApiPath());
            // A page beyond the last one (an old address) is no empty list: its albums are on the pages before it, the last of
            // which it leads to, with the same criteria.
            if (_list is { Items.Count: 0, TotalCount: > 0 } albums && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (albums.TotalCount + albums.Size - 1) / albums.Size }).Href());
                return;
            }
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        _wholeCount = await WholeCountAsync();

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    // The number of all the albums, which the heading gives: that of the list itself without criteria, read once more otherwise;
    // without it, the list goes on.
    private async Task<int?> WholeCountAsync()
    {
        if (_query.Entry is null && _query.ActiveFilterCount == 0)
            return _list!.TotalCount;
        try
        {
            return (await Api.GetAsync<Page<AlbumListItem>>(_query.WholeApiPath())).TotalCount;
        }
        catch (ApiProblemException)
        {
            return null;
        }
    }

    // All the albums, then each state, in the order of the states (fonctionnel/regles-metier/appartenance-a-la-collection.md).
    private IReadOnlyList<FilterChoices.FilterChoice> PossessionChoices() =>
    [
        new(L["State.All"], _query.WithState(null).Href(), _query.State is null),
        .. Enum.GetValues<AlbumCollectionState>().Select(state =>
            new FilterChoices.FilterChoice(L[$"State.{state}"], _query.WithState(state).Href(), _query.State == state)),
    ];

    private string CountText() => _list!.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // Each author once, at the place of their first role, which the API already gives.
    private static string AuthorsText(AlbumListItem row) =>
        string.Join(" · ", row.Authors.Select(a => RecordSearch.AuthorName(a.LastName, a.FirstName, a.Pseudonym)));
}
