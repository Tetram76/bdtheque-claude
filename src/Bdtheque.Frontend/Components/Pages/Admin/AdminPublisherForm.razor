@attribute [Route(AppPaths.AdminNewPublisher)]
@attribute [Route("/admin/publishers/{Id:guid}")]
@rendermode InteractiveServer
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Entries
@inject IStringLocalizer<AdminPublisherForm> L
@inject IStringLocalizer<FieldMessages> FieldTexts
@inject IStringLocalizer<RuleMessages> RuleTexts
@inject ApiClient Api
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The entry form of a publisher and of its collections (visuel/saisie-editeur/contenu.md), on the model of the entry form of a
   series, whose frame and errors it shares. The collections have neither list nor page of their own: they are entered here and
   saved with the publisher, a collection removed staying in the list, struck, until the saving. No side column. It applies no
   rule of the publisher, which the domain alone holds (choix-implementation/ecritures/erreurs-metier-fonctionnelles-et-techniques.md):
   the error of its saving says what to correct. Its styles read the contracts of the base theme only
   (visuel/saisie-editeur/declinaison-par-theme.md). *@
<PageTitle>@PageTitle</PageTitle>
<AudienceScreen Function="@(Id is null ? AudienceFunctions.AdminNewPublisherForm : AudienceFunctions.AdminPublisherForm)"
                Record="@(Id is { } id ? new PresentedRecord(RecordType.Publisher, id) : null)" />

@if (Entry is null)
{
    @if (_loadProblem is not null)
    {
        <Breadcrumb Items="@([new(L["Administration"], AppPaths.AdminHome), new(L["Publishers"], AppPaths.AdminPublishers), new(L["Breadcrumb.Unknown"])])" />
        <ErrorMessage Problem="_loadProblem" />
    }
}
else
{
    <EntryForm @key="_reading" @ref="_form" HasRedo="Tracker.HasRedo" Breadcrumb="@([new(L["Administration"], AppPaths.AdminHome), new(L["Publishers"], AppPaths.AdminPublishers), new(Entry.Id is null ? L["New"] : Subject)])"
               Title="@(Entry.Id is null ? L["New"] : L["Edit"])" Subject="@Subject" State="State" Saving="_saving"
               SaveLabel="@(Entry.Id is null ? L["Create"] : L["Save"])" CancelHref="@AppPaths.AdminPublishers" OnSave="SaveAsync"
               Problem="@SaveProblem" Dates="@Dates">
        <Block Title="@L["Block.Publisher"]" Kicker="@L["Kicker.Publisher"]">
            <div class="publisher-fields">
                <Field Id="publisher-name" Label="@L["Name"]" Required State="@DatumState(NameKey)" Error="@Errors.For("/name")" Context="control">
                    <input id="@control.Id" type="text" placeholder="@L["Name.Placeholder"]" aria-describedby="@control.DescribedBy"
                           aria-invalid="@control.Invalid" @bind="Entry.Name" @bind:event="oninput" />
                </Field>
                <Field Id="publisher-website" Label="@L["Website"]" Help="@L["Website.Help"]" State="@DatumState(WebsiteKey)" Error="@Errors.For("/website")" Context="control">
                    <span class="publisher-website">
                        <input id="@control.Id" type="url" placeholder="https://…" aria-describedby="@control.DescribedBy"
                               aria-invalid="@control.Invalid" @bind="Entry.Website" @bind:event="oninput" />
                        @* An external site opened in a new tab, without access to the form nor referrer
                           (choix-implementation/socle/frontend.md, site extérieur), its globe the icon of the button
                           (visuel/charte-graphique/liens-qui-font-sortir-de-l-application.md). *@
                        @if (!string.IsNullOrWhiteSpace(Entry.Website))
                        {
                            <a class="publisher-website-open" href="@Entry.Website.Trim()" target="_blank" rel="noopener noreferrer"
                               title="@L["Website.Open"]"><span class="visually-hidden">@L["Website.Open"]</span><ExternalMark /></a>
                        }
                    </span>
                </Field>
            </div>
        </Block>

        <Block Title="@L["Block.Collections"]" Kicker="@L["Kicker.Collections"]">
            <div class="publisher-fields">
                <p class="publisher-help">@L["Collections.Help"]</p>
                @if (Entry.Collections.Count == 0)
                {
                    <p class="publisher-collections-none">@L["Collections.None"]</p>
                }
                else
                {
                    <ul class="publisher-collections">
                        @foreach (var collection in Entry.Collections)
                        {
                            <li @key="collection.Key" class="publisher-collection" data-removed="@(collection.Removed ? "true" : null)">
                                @if (collection.Removed)
                                {
                                    <span class="publisher-collection-name">@collection.Name</span>
                                }
                                else
                                {
                                    var state = CollectionState(collection);
                                    <span class="publisher-collection-name">
                                        @* Its label hidden, the mark of a collection renamed is read with it, inside it (Field); the
                                           pill seen right after the name is hidden from screen readers, so as not to be read twice. *@
                                        <Field Id="@CollectionId(collection)" Label="@L["Collection.Name"]" LabelHidden Required State="state"
                                               Error="@Errors.ForNamed(Label(collection), CollectionField(collection))" ErrorRelated="@Errors.IsRelated(CollectionField(collection))"
                                               Context="control">
                                            <span class="publisher-collection-input">
                                                <input id="@control.Id" type="text" placeholder="@L["Collection.Name"]"
                                                       aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                                                       @bind="collection.Name" @bind:event="oninput" />
                                                @if (state?.Modified == true)
                                                {
                                                    <span class="publisher-collection-mark" aria-hidden="true"><ModifiedMark /></span>
                                                }
                                            </span>
                                        </Field>
                                    </span>
                                }
                                <span class="publisher-collection-use">
                                    @if (collection.Id is null)
                                    {
                                        <Tag Text="@L["Collection.New"]" />
                                    }
                                    <span class="publisher-collection-count">@Use(collection)</span>
                                </span>
                                <span class="publisher-collection-action">
                                    @if (collection.Removed)
                                    {
                                        <button type="button" class="publisher-collection-restore" @onclick="() => collection.Removed = false">@L["Collection.Restore"]</button>
                                    }
                                    else if (collection.InUse)
                                    {
                                        <span class="publisher-collection-locked" role="img" aria-label="@L["Collection.Locked"]" title="@L["Collection.Locked"]">
                                            <Icon Name="IconName.Lock" />
                                        </span>
                                    }
                                    else
                                    {
                                        <button type="button" class="publisher-collection-remove" aria-label="@L["Collection.Remove", Label(collection)]"
                                                title="@L["Collection.Remove.Title"]" @onclick="() => Entry.Remove(collection)">
                                            <Icon Name="IconName.Delete" />
                                        </button>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                }
                @* What the user had added and removed before the reload, under the list (visuel/saisie-album/contenu.md, #329). *@
                @if (DatumState(CollectionsKey) is { } collectionsState)
                {
                    <RedoLine Id="publisher-collections-redo" State="collectionsState" />
                }
                <span>
                    <button type="button" class="publisher-collections-add" @onclick="AddCollection"><Icon Name="IconName.Add" /><span>@L["Collections.Add"]</span></button>
                </span>
            </div>
        </Block>
    </EntryForm>

    @if (_changesShown)
    {
        <ChangesDialog Id="publisher-changes" Subject="@Subject" Changes="Tracker.Changes()" OnClose="() => _changesShown = false" />
    }
}

@code {
    private ApiProblem? _loadProblem;
    private ApiProblem? _saveProblem;
    // The collections the last saving sent, in the order of its content, where its error designates them: the collections
    // added or removed since leave the error on the collection it designates.
    private List<Guid> _sentCollections = [];
    private EntryForm? _form;
    private bool _revealProblem;
    private bool _saving;
    private string? _savedFingerprint;
    private bool _changesShown;
    private EntryTracker<PublisherEntry>? _tracker;
    // The data the tracker compares, those of the collections following the reading (CollectionData).
    private readonly List<EntryDatum<PublisherEntry>> _data = [];
    // The number of the reading of the publisher: the form is rendered anew for each, its controls reading the record reloaded.
    private int _reading;

    private const string NameKey = "name";
    private const string WebsiteKey = "website";
    private const string CollectionsKey = "collections";

    /// <summary>The publisher to modify; none for a new publisher.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>For a new publisher, the text searched in its list, which found nothing: its name (AppPaths.NewWithSearched).</summary>
    [SupplyParameterFromQuery(Name = AppPaths.SearchedParameter)]
    public string? Searched { get; set; }

    /// <summary>The publisher as the form holds it, read once, by the prerendering.</summary>
    [PersistentState]
    public PublisherEntry? Entry { get; set; }

    /// <summary>The publisher as it was read or last saved: what the user changed since.</summary>
    [PersistentState]
    public PublisherEntry? ReadEntry { get; set; }

    // The name of the publisher, as typed; « <Sans nom> » while nothing is.
    private string Subject => string.IsNullOrWhiteSpace(Entry!.Name) ? L["Unnamed"] : Entry.Name.Trim();

    private string PageTitle => Entry is null || Entry.Id is null ? L["New"] : L["PageTitle", Subject];

    private SaveBarState State => Entry!.Id is null ? SaveBarState.New : SavedState;

    // The state of a publisher already saved: whether its form still holds what was last read or saved.
    private SaveBarState SavedState => Entry!.Fingerprint() == _savedFingerprint ? SaveBarState.Unchanged : SaveBarState.Unsaved;

    protected override async Task OnInitializedAsync()
    {
        if (Entry is null)
        {
            try
            {
                Entry = Id is { } id ? PublisherEntry.Of(await Api.GetAsync<PublisherForm>($"/admin/publishers/{id}")) : new PublisherEntry { Name = Searched };
                ReadEntry = Entry.Copy();
            }
            catch (ApiProblemException exception)
            {
                _loadProblem = exception.Problem;
                return;
            }
        }

        _savedFingerprint = ReadEntry!.Fingerprint();
        Track(ReadEntry);
    }

    private static string CollectionId(CollectionEntry collection) => $"publisher-collection-{collection.Key}";

    // The name of a collection, as typed, which its removal names; « <Sans nom> » while nothing is.
    private string Label(CollectionEntry collection) => string.IsNullOrWhiteSpace(collection.Name) ? L["Unnamed"] : collection.Name.Trim();

    // What references a collection (« 3 séries · 58 éditions · 1 intention · 1 recherche enregistrée »), what decides of its
    // removal (visuel/saisie-editeur/contenu.md, #471), an edition targeted counted as its intent
    // (fonctionnel/regles-metier/suppression-des-entites.md), in the order of the entity types
    // (fonctionnel/presentation/ordre-des-types-de-fiche.md); what becomes of a collection removed at the saving.
    private string Use(CollectionEntry collection)
    {
        if (collection.Removed)
            return L["Collection.Removed"];
        if (!collection.InUse)
            return L["Collection.Unused"];
        string?[] parts =
        [
            Counted(collection.SeriesCount, "Collection.Series", "Collection.Series.Plural"),
            Counted(collection.EditionCount, "Collection.Edition", "Collection.Editions"),
            Counted(collection.PurchaseIntentCount, "Collection.PurchaseIntent", "Collection.PurchaseIntents"),
            Counted(collection.SavedSearchCount, "Collection.SavedSearch", "Collection.SavedSearches"),
        ];
        return string.Join(" · ", parts.OfType<string>());
    }

    // A number of records, in the singular or the plural; none for no record, which the use leaves unsaid.
    private string? Counted(int count, string singular, string plural)
    {
        if (count == 0)
            return null;
        return L[count > 1 ? plural : singular, count];
    }

    private void AddCollection() => Entry!.AddCollection();

    private async Task SaveAsync()
    {
        if (_saving)
            return;
        _saving = true;
        _saveProblem = null;
        var content = Entry!.ToContent();
        _sentCollections = [.. Entry.Kept.Select(c => c.Key)];
        try
        {
            if (Entry.Id is { } id)
            {
                await Api.PutAsync<UpdatePublisherRequest, PublisherForm>($"/admin/publishers/{id}", new UpdatePublisherRequest(content, Entry.Version));
                await Recorder.RecordActionAsync(AudienceFunctions.AdminPublisherSaved, $"publisher={id}");
            }
            else
            {
                var created = await Api.PostAsync<PublisherContent, PublisherForm>("/admin/publishers", content);
                await Recorder.RecordActionAsync(AudienceFunctions.AdminPublisherCreated, $"publisher={created.Id}");
            }

            // A record saved, created or modified, leads back to the list (visuel/saisie-album/contenu.md, decision of the user).
            Navigation.NavigateTo(AppPaths.AdminPublishers);
        }
        catch (ApiProblemException exception)
        {
            _saveProblem = exception.Problem;
            _revealProblem = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // Once the error of a saving is rendered, what is to correct is brought into view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealProblem && _form is not null)
        {
            _revealProblem = false;
            await _form.RevealProblemAsync();
        }
    }

    private async Task ShowChangesAsync()
    {
        _changesShown = true;
        await Recorder.RecordActionAsync(AudienceFunctions.AdminPublisherChanges, $"publisher={Entry!.Id}");
    }

    // The record as it is now, read anew within the circuit: the entry left behind offers again, under each datum, what the
    // user had entered (visuel/saisie-album/contenu.md, #329). The form is rendered anew, its controls reading the record reloaded.
    private async Task ReloadAsync()
    {
        try
        {
            var reloaded = PublisherEntry.Of(await Api.GetAsync<PublisherForm>($"/admin/publishers/{Entry!.Id!.Value}"));
            Tracker.Abandon();
            Entry = reloaded;
            ReadEntry = reloaded.Copy();
            Track(ReadEntry);
            _savedFingerprint = ReadEntry.Fingerprint();
            _saveProblem = null;
            _sentCollections = [];
            _reading++;
        }
        catch (ApiProblemException exception)
        {
            // Deleted meanwhile, or unreadable: said as the error of the saving was, the entry staying as it is.
            _saveProblem = exception.Problem;
        }
    }

    // What to correct in each field the error of the saving designates (visuel/saisie-album/contenu.md).
    private FieldErrors Errors => new(_saveProblem, FieldTexts, RuleTexts, Subject);

    // The name of a collection, where the content of the last saving listed it; none for a collection added since.
    private string CollectionField(CollectionEntry collection) =>
        _sentCollections.IndexOf(collection.Key) is var index and >= 0 ? $"/collections/{index}/name" : "";

    // The three categories told apart at first glance, each with what the user can do about it (visuel/saisie-editeur/contenu.md).
    private RenderFragment? SaveProblem => _saveProblem is not { } problem ? null
        : @<SaveError Problem="problem" Conflict="@L["Problem.Functional.Conflict"]" NotFound="@L["Problem.Functional.NotFound"]"
                      Technical="@L["Problem.Technical.Text"]" CanReload="@(Entry!.Id is not null)" OnReload="ReloadAsync" OnShowChanges="ShowChangesAsync"
                      OnRetry="SaveAsync" Business="@RefusedRemoval(problem)" RefusalHint="RefusalHint" />;

    // The removal of a collection refused, as any deletion is, naming the collection the error designates, which the content
    // no longer cited (visuel/saisie-editeur/contenu.md, decision of the user, #471); its lines say what blocks it.
    private string? RefusedRemoval(ApiProblem problem) =>
        problem is { RuleCode: "PublisherCollection.InUse", Record: { } id } && Entry!.Collections.FirstOrDefault(c => c.Id == id) is { } collection
            ? L["Collection.Refusal.Lead", Label(collection)].Value
            : null;

    // What to do about the records of a type blocking the removal of a collection (« rattachez-les à une autre collection, ou
    // supprimez-les »).
    private string RefusalHint(string kind) => L[$"Collection.Refusal.Hint.{kind}"];

    private RenderFragment? Dates => Entry is { CreatedAt: { } created, ModifiedAt: { } modified }
        ? @<text>@L["Dates.Created"] <LocalDateTime Value="created" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>
        : null;

    // The data of the publisher, in the order of the form, compared on what is entered against what was read
    // (visuel/saisie-album/contenu.md, données modifiées): for their mark, « Voir mes changements » and the entry left behind
    // at a reload. The tracker reads them from the list Track fills at each reading.
    private EntryTracker<PublisherEntry> Tracker => _tracker ??= new(() => ReadEntry, () => Entry, _data);

    // The data of the publisher as read: its name, its website, the name of each collection read, which renaming it modifies,
    // and the collections it keeps, those it adds or removes, whose lines « Nouvelle » and « Retirée à l'enregistrement »
    // already tell apart, unmarked. Those of the collections are those of the reading, rebuilt at each: a collection deleted
    // meanwhile offers nothing to take again.
    private void Track(PublisherEntry read)
    {
        _data.Clear();
        _data.Add(new(NameKey, L["Name"], e => e.Name, e => e.Name, (from, to) => to.Name = from.Name));
        _data.Add(new(WebsiteKey, L["Website"], e => e.Website, e => e.Website, (from, to) => to.Website = from.Website));
        _data.AddRange(read.Collections.Where(c => c.Id is not null).Select(c => CollectionName(c.Id!.Value, L["Changes.Collection", Label(c)])));
        var present = read.Collections.Select(c => c.Id).OfType<Guid>().ToHashSet();
        _data.Add(new(CollectionsKey, L["Changes.Collections"], e => CollectionsChanged(e, present), e => string.Join(", ", e.Kept.Select(c => c.Name ?? "")),
            TakeCollections));
    }

    private static string CollectionKey(Guid id) => $"collection-{id}";

    private static CollectionEntry? Collection(PublisherEntry entry, Guid id) => entry.Collections.FirstOrDefault(c => c.Id == id);

    // The name of a collection read, taken back into the same collection, if the record reloaded still has it.
    private static EntryDatum<PublisherEntry> CollectionName(Guid id, string label) => new(
        CollectionKey(id), label, e => Collection(e, id)?.Name, e => Collection(e, id)?.Name, (from, to) =>
        {
            if (Collection(to, id) is { } collection)
                collection.Name = Collection(from, id)?.Name;
        });

    // What the entry changes to the collections read: those it removes and those it adds, nothing for the record as read. Told
    // against the collections read rather than listing those kept, so that what is taken back into a record reloaded equals
    // what was entered, whatever collections the other modification added; in no particular order, the collections being read
    // by name, which the other modification may change; and only for the collections the record read now has, a removal of one
    // deleted meanwhile being done already.
    private static string CollectionsChanged(PublisherEntry entry, IReadOnlySet<Guid> present) =>
        string.Join(' ', entry.Collections
            .Select(c => c switch
            {
                { Id: null } => $"+{c.Key}",
                { Removed: true, Id: { } id } when present.Contains(id) => $"-{id}",
                _ => null,
            })
            .OfType<string>().Order(StringComparer.Ordinal));

    // The removals and additions entered, made again in the record reloaded: a collection added is copied, under its key, so that
    // the entry left behind stays as it was.
    private static void TakeCollections(PublisherEntry from, PublisherEntry to)
    {
        foreach (var removed in from.Collections.Where(c => c.Removed))
        {
            if (Collection(to, removed.Id!.Value) is { } collection)
                collection.Removed = true;
        }
        to.Collections.AddRange(from.Collections
            .Where(c => c.Id is null && to.Collections.TrueForAll(o => o.Key != c.Key))
            .Select(c => new CollectionEntry { Key = c.Key, Name = c.Name }));
    }

    // Nothing is modified on a new publisher, all of which is new, as its save bar says (« Nouvelle fiche »).
    private EntryDatumState? DatumState(string key) => Entry!.Id is null ? null : Tracker.State(key, this);

    // A collection read is a datum, its name; one added is not, its tag « Nouvelle » saying so.
    private EntryDatumState? CollectionState(CollectionEntry collection) => collection.Id is { } id ? DatumState(CollectionKey(id)) : null;
}
