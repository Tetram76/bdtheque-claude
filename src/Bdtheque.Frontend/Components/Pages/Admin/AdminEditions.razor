@attribute [Route(AppPaths.AdminEditions)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Deletion
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<AdminEditions> L
@inject ApiClient Api
@inject AdminRecordCounts RecordCounts
@inject RecordLabels Labels
@inject ValueLabels Values
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The list of the editions of the administration (visuel/listes/liste-par-liste.md), after the model of the list of the albums
   (visuel/listes/listes-de-l-administration.md): the editions of the collection only, an edition targeted by a purchase intent
   being one of the intents (fonctionnel/regles-metier/intention-d-achat.md). Rendered statically, every criterion, the panel
   of the filters and the dialogs are carried by its address (Lists/EditionListQuery.cs); only the choice of a record of the
   filters is interactive. Its styles read the contracts of the base theme only (visuel/listes/declinaison-par-theme.md). *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.AdminEditions" />

<ListLayout Title="@L["ListTitle"]" Kicker="@L["Kicker"]" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_counts?.Editions" NewHref="@AppPaths.AdminNewEdition" NewLabel="@L["New"]" />
    </Heading>
    <ChildContent>
        <ListSearch Action="@AppPaths.AdminEditions" FieldId="editions-search" TextName="@AdminListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" PanelId="editions-filters"
                    FiltersName="@AdminListQuery.FiltersName" FiltersOpenValue="@AdminListQuery.FiltersOpenValue"
                    FiltersOpen="_query.FiltersOpen" FilterCount="_query.ActiveFilterCount" Panel="FiltersPanel" HiddenFilters="KeptFilters" />

        <ActiveFilters Filters="ActiveFilterTags()" ClearHref="@_query.WithoutFilters().Href()" />

        <ListSummary Count="@CountText()" Narrowed="@(_query.Text is not null || _query.ActiveFilterCount > 0)"
                     WholeCount="_counts?.Editions" Order="@L["Order"]" />

        @if (_list!.Editions.Items.Count == 0)
        {
            <EmptyList Message="@(_query.Text is { } text ? L["Empty.Text", text] : L["Empty.Criteria"])" Hint="@L["Empty.Hint"]">
                <Actions>
                    @if (_query.Text is not null)
                    {
                        <Button Href="@((ListOnly with { Text = null, Page = 1 }).Href())" Label="@L["Empty.Clear"]" />
                        <Button Href="@AppPaths.AdminNewEdition" Variant="ButtonVariant.Primary" Label="@L["New"]" />
                    }
                    else
                    {
                        <Button Href="@_query.WithoutFilters().Href()" Label="@L["Empty.ClearFilters"]" />
                    }
                </Actions>
            </EmptyList>
        }
        else
        {
            <div class="edition-rows" role="table" aria-label="@L["Title"]">
                <div class="edition-row edition-row-head" role="row">
                    <span class="edition-cover" role="columnheader"><span class="visually-hidden">@L["Column.Cover"]</span></span>
                    <span class="edition-main" role="columnheader">@L["Column.Edition"]</span>
                    <span class="edition-year" role="columnheader">@L["Column.Year"]</span>
                    <span class="edition-category" role="columnheader">@L["Column.Category"]</span>
                    <span class="edition-acquisition" role="columnheader">@L["Column.Acquisition"]</span>
                    <span class="edition-modified" role="columnheader">@L["Column.Modified"]</span>
                    <span class="edition-actions" role="columnheader"><span class="visually-hidden">@L["Column.Actions"]</span></span>
                </div>
                @foreach (var row in _list.Editions.Items)
                {
                    var label = Labels.Edition(row.Edition);
                    <div class="edition-row" role="row">
                        <span class="edition-cover" role="cell"><Cover VisualId="row.Cover?.VisualId" /></span>
                        <span class="edition-main" role="cell">
                            <a class="edition-label" href="@AppPaths.AdminEditEdition(row.Album.Id, row.Edition.Id)">@label</a>
                            <span class="edition-album">@AlbumLabel(row.Album)</span>
                        </span>
                        <span class="edition-meta">
                            <span class="edition-year" role="cell">
                                @* The space after the name of the column, which Razor would trim before a block of code. *@
                                <span class="edition-caption">@($"{L["Column.Year"]} ")</span>
                                @if (row.Edition.PublicationYear is { } year)
                                {
                                    @year
                                }
                                else
                                {
                                    <NotSet Gender="GrammaticalGender.Feminine" />
                                }
                            </span>
                            <span class="edition-category" role="cell">
                                @if (row.Category is { } category)
                                {
                                    @Values.Of(category)
                                }
                                else
                                {
                                    <NotSet Gender="GrammaticalGender.Feminine" />
                                }
                            </span>
                            <span class="edition-acquisition" role="cell">@AcquisitionText(row)</span>
                        </span>
                        <span class="edition-modified" role="cell"><LocalDateTime Value="row.ModifiedAt" DateOnly="true" /></span>
                        <span class="edition-actions" role="cell">
                            <Button Href="@AppPaths.AdminEditEdition(row.Album.Id, row.Edition.Id)" Icon="IconName.Edit" Label="@L["Edit"]"
                                    IconOnlyOnSmartphone="true" aria-label="@L["Edit.Label", label]" />
                            <ActionsMenu Id="@($"edition-actions-{row.Edition.Id:N}")" Label="@L["More", label]">
                                <MenuItem Href="@AppPaths.Album(row.Album.Id)" Icon="IconName.Exit" Label="@L["Menu.View"]" />
                                <MenuItem Href="@((ListOnly with { Merge = row.Edition.Id }).Href())" Icon="IconName.Merge" Label="@L["Menu.Merge"]" />
                                <MenuSeparator />
                                <MenuItem Href="@((ListOnly with { Delete = row.Edition.Id }).Href())" Icon="IconName.Delete" Label="@L["Menu.Delete"]"
                                          Variant="ButtonVariant.Delete" />
                            </ActionsMenu>
                        </span>
                    </div>
                }
            </div>

            <Pagination Number="_list.Editions.Number" Size="_list.Editions.Size" TotalCount="_list.Editions.TotalCount"
                        ItemsLabel="@L["Title"]" PageHref="@(page => (ListOnly with { Page = page }).Href())" />
        }
    </ChildContent>
    <Dialogs>
        @if (_dialogEdition is not null)
        {
            var subject = Labels.Edition(_dialogEdition.Edition);
            if (_query.Merge is not null)
            {
                <MergeDialog Id="edition-merge" Title="@L["Merge.Title"]" Subject="@subject" Lead="@L["Merge.Lead"]" CloseHref="@ListOnly.Href()"
                             Action="@AppPaths.AdminEditions" Criteria="@((ListOnly with { Merge = _dialogEdition.Edition.Id }).Parameters())"
                             Text="@_query.MergeText" SearchLabel="@L["Merge.Search"]" Placeholder="@L["Merge.Placeholder"]"
                             Candidates="_candidates" Prompt="@L["Merge.Prompt"]" None="@L["Merge.None", _query.MergeText ?? ""]"
                             CandidatesLabel="@L["Merge.Candidates"]" Note="@L["Merge.Note"]" ContinueAction="@AppPaths.AdminMergeEditions"
                             SubjectName="edition" SubjectId="_dialogEdition.Edition.Id" />
            }
            else
            {
                <DeletionDialog Id="edition-deletion" FormName="@DeletionFormName" Title="@L["Deletion.Title"]" Subject="@subject"
                                CloseHref="@ListOnly.Href()" Lead="@L["Deletion.Lead"]" RefusalLead="@L["Refusal.Lead"]"
                                RefusalHint="@(kind => L[$"Refusal.Hint.{kind}"].Value)" Impact="_impact" Problem="_deletionProblem"
                                Version="_dialogEdition.AlbumVersion" OnConfirm="DeleteAsync" />
            }
        }
    </Dialogs>
</ListLayout>

@code {
    private const string DeletionFormName = "edition-deletion";

    /// <summary>How many other editions the merge dialog proposes: enough to choose, few enough to read at a glance.</summary>
    internal const int CandidateCount = 10;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The version of the album of the edition whose deletion is confirmed: the edition belongs to its aggregate.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.VersionName)]
    private uint? Version { get; set; }

    /// <summary>The fingerprint of the impact of the deletion the administrator confirmed.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.FingerprintName)]
    private string? Fingerprint { get; set; }

    private EditionListQuery _query = new();
    private RecordCounts? _counts;
    private ApplicationSettings? _settings;
    private EditionAdminList? _list;
    private ApiProblem? _problem;
    private EditionAdminListItem? _dialogEdition;
    private DeletionImpact? _impact;
    private ApiProblem? _deletionProblem;
    private IReadOnlyList<MergeDialog.MergeCandidate>? _candidates;

    // The list with its criteria, without its dialogs: where a link of the list, or the closing of a dialog, leads.
    private EditionListQuery ListOnly => _query with { Delete = null, Merge = null, MergeText = null };

    protected override async Task OnInitializedAsync()
    {
        _query = EditionListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            // The number of editions is the one of the menu, read once per request; without it, the list goes on.
            _counts = await RecordCounts.TryGetAsync();
            _settings = await Api.GetAsync<ApplicationSettings>("/catalog/settings");
            _list = await Api.GetAsync<EditionAdminList>(_query.ApiPath());
            // A page beyond the last one (the page of its only edition once deleted, an old address) is no empty list: its
            // editions are on the pages before it, the last of which it leads to, with the same criteria.
            if (_list.Editions is { Items.Count: 0, TotalCount: > 0 } editions && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (editions.TotalCount + editions.Size - 1) / editions.Size }).Href());
                return;
            }
            // A dialog opens on an edition of the page, from its row: an address written by hand on another edition opens none.
            _dialogEdition = _list.Editions.Items.FirstOrDefault(row => row.Edition.Id == (_query.Delete ?? _query.Merge));
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        if (_dialogEdition is not null && _query.Delete is not null)
            await LoadImpactAsync(_dialogEdition);
        else if (_dialogEdition is not null && _query.MergeText is { } text)
            _candidates = await LoadCandidatesAsync(text);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    // An edition is addressed by its album, the root of its aggregate.
    private static string EditionPath(EditionAdminListItem row) => $"/admin/albums/{row.Album.Id}/editions/{row.Edition.Id}";

    private async Task LoadImpactAsync(EditionAdminListItem row)
    {
        try
        {
            _impact = await Api.GetAsync<DeletionImpact>($"{EditionPath(row)}/deletion-impact");
        }
        catch (ApiProblemException exception)
        {
            _deletionProblem = exception.Problem;
        }
    }

    // The other editions found by the search of the dialog, on their ISBN, the edition itself excepted.
    private async Task<IReadOnlyList<MergeDialog.MergeCandidate>?> LoadCandidatesAsync(string text)
    {
        var found = await Api.GetAsync<EditionAdminList>(_query.MergeCandidatesApiPath(text, CandidateCount));
        return
        [
            .. found.Editions.Items
                .Where(row => row.Edition.Id != _dialogEdition!.Edition.Id)
                .Take(CandidateCount)
                .Select(row => new MergeDialog.MergeCandidate(row.Edition.Id, Labels.Edition(row.Edition), CandidateDetail(row))),
        ];
    }

    private async Task DeleteAsync()
    {
        if (_dialogEdition is null || Version is not { } version || Fingerprint is null)
            return;

        try
        {
            await Api.DeleteAsync($"{EditionPath(_dialogEdition)}?version={version}&fingerprint={Uri.EscapeDataString(Fingerprint)}");
        }
        catch (ApiProblemException exception)
        {
            // A deletion refused, or whose impact changed since its confirmation, announces the current impact, to confirm
            // again or to resolve; any other error is presented as it is.
            _deletionProblem = exception.Problem;
            _impact = exception.Problem.Impact;
            if (_impact is { BlockedBy.Count: > 0 })
                _deletionProblem = null;
            return;
        }

        await Recorder.RecordActionAsync(AudienceFunctions.AdminEditionsDeleted, $"edition={_dialogEdition.Edition.Id}", HttpContext?.RequestAborted ?? default);
        Navigation.NavigateTo(ListOnly.Href());
    }

    private string AlbumLabel(AlbumSummary album) => Labels.Album(album, _settings!.AlbumLabelFormat);

    private string CountText() => _list!.Editions.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // « Achat, 2004 »: the mode of the acquisition, and its year when its date is known.
    private string AcquisitionText(EditionAdminListItem row) => row.AcquisitionYear is { } year
        ? L["Acquisition.WithYear", Values.Of(row.AcquisitionMode), year]
        : Values.Of(row.AcquisitionMode);

    private string CandidateDetail(EditionAdminListItem candidate) => $"{AlbumLabel(candidate.Album)} · {AcquisitionText(candidate)}";

    // The filters chosen, each with the list without it; a record that no longer exists is no filter of the list.
    private IReadOnlyList<ActiveFilters.ActiveFilter> ActiveFilterTags()
    {
        var filters = _list!.Filters;
        var tags = new List<ActiveFilters.ActiveFilter>();
        void Add(string name, string? value, EditionListQuery without)
        {
            if (value is not null)
                tags.Add(new(L[$"Filter.{name}"].Value, value, (without with { Page = 1 }).Href()));
        }

        var list = ListOnly;
        Add("Album", filters.Album is { } album ? AlbumLabel(album) : null, list with { AlbumId = null });
        Add("Publisher", filters.Publisher?.Name, list with { PublisherId = null });
        Add("PublisherCollection", filters.PublisherCollection?.Name, list with { PublisherCollectionId = null });
        return tags;
    }

    // The fields of the filters: each record chosen by typing its name, interactive.
    private RenderFragment FiltersPanel => @<ListFilters Note="@L["Filters.Note"]">
            <Field Id="filter-album" Label="@L["Filter.Album"]" Context="control">
                <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Album" Name="@EditionListQuery.AlbumName"
                              Value="@Option(_list!.Filters.Album, a => new(a.Id, AlbumLabel(a), null))" Placeholder="@L["Filter.Any"]" />
            </Field>
            <Field Id="filter-publisher" Label="@L["Filter.Publisher"]" Context="control">
                <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Publisher" Name="@EditionListQuery.PublisherName"
                              Value="@Option(_list!.Filters.Publisher, p => new(p.Id, p.Name, null))" Placeholder="@L["Filter.Any"]" />
            </Field>
            <Field Id="filter-collection" Label="@L["Filter.PublisherCollection"]" Context="control">
                <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.PublisherCollection"
                              Name="@EditionListQuery.PublisherCollectionName"
                              Value="@Option(_list!.Filters.PublisherCollection, c => new(c.Id, c.Name, c.PublisherName))" Placeholder="@L["Filter.Any"]" />
            </Field>
        </ListFilters>;

    private static RecordOption? Option<T>(T? item, Func<T, RecordOption> option) where T : class => item is null ? null : option(item);

    // The filters chosen, kept by the search while their panel is folded.
    private RenderFragment KeptFilters => @<QueryFields Parameters="@((_query with { Text = null, Page = 1 }).Parameters())" />;
}
