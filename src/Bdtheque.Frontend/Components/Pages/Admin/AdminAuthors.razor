@attribute [Route(AppPaths.AdminAuthors)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Deletion
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<AdminAuthors> L
@inject ApiClient Api
@inject AdminRecordCounts RecordCounts
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The list of the authors of the administration (visuel/listes/liste-par-liste.md), after the model of the list of the albums
   (visuel/listes/listes-de-l-administration.md): rendered statically, every criterion and the dialogs are carried by its
   address (Lists/AuthorListQuery.cs); the list has no filters. An author is entered in a side panel over the list
   (visuel/listes/saisie-selon-l-entite.md, visuel/saisie-auteur/), which the address opens, its form sent to the list, whose
   error is presented in place. Its styles read the contracts of the base theme only (visuel/listes/declinaison-par-theme.md). *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.AdminAuthors" />

<ListLayout Title="@L["ListTitle"]" Kicker="@L["Kicker"]" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_counts?.Authors" NewHref="@NewHref" NewLabel="@L["New"]" />
    </Heading>
    <ChildContent>
        <ListSearch Action="@AppPaths.AdminAuthors" FieldId="authors-search" TextName="@AdminListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" />

        <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (ListOnly with { Entry = entry, Page = 1 }).Href())" />

        <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@(_query.Text is not null)" WholeCount="_counts?.Authors"
                     Order="@L["Order"]" />

        @if (_list!.Items.Count == 0)
        {
            @* The authors have no filters: their list is empty under a search, an entry, or nothing. *@
            switch (_query.EmptyReason)
            {
                case EmptyListReason.Search:
                    <EmptyList Message="@L["Empty.Text", _query.Text!]" Hint="@L["Empty.Hint"]">
                        <Actions>
                            <Button Href="@((ListOnly with { Text = null, Page = 1 }).Href())" Label="@L["Empty.Clear"]" />
                            <Button Href="@NewHref" Variant="ButtonVariant.Primary" Label="@L["Empty.Create", _query.Text!]" />
                        </Actions>
                    </EmptyList>
                    break;
                case EmptyListReason.Entry:
                    <EmptyList Message="@L["Empty.Entry"]">
                        <Actions>
                            <Button Href="@AppPaths.AdminAuthors" Label="@L["Empty.All"]" />
                        </Actions>
                    </EmptyList>
                    break;
                default:
                    <EmptyList Message="@L["Empty.None"]">
                        <Actions>
                            <Button Href="@NewHref" Variant="ButtonVariant.Primary" Icon="IconName.Add" Label="@L["New"]" />
                        </Actions>
                    </EmptyList>
                    break;
            }
        }
        else
        {
            <div class="author-rows" role="table" aria-label="@L["Title"]">
                <div class="author-row author-row-head" role="row">
                    <span class="author-monogram" role="columnheader"><span class="visually-hidden">@L["Column.Monogram"]</span></span>
                    <span class="author-main" role="columnheader">@L["Column.Author"]</span>
                    <span class="author-nationality" role="columnheader">@L["Column.Nationality"]</span>
                    <span class="author-albums" role="columnheader">@L["Column.Albums"]</span>
                    <span class="author-roles" role="columnheader">@L["Column.Roles"]</span>
                    <span class="author-modified" role="columnheader">@L["Column.Modified"]</span>
                    <span class="author-actions" role="columnheader"><span class="visually-hidden">@L["Column.Actions"]</span></span>
                </div>
                @foreach (var row in _list.Items)
                {
                    var name = Name(row);
                    <div class="author-row" role="row">
                        <span class="author-monogram" role="cell">
                            <Monogram LastName="@row.LastName" FirstName="@row.FirstName" Pseudonym="@row.Pseudonym" />
                        </span>
                        <span class="author-main" role="cell">
                            <RowEntry>@name</RowEntry>
                            @if (Identity(row) is { } identity)
                            {
                                <span class="author-identity">@identity</span>
                            }
                        </span>
                        <span class="author-meta">
                            <span class="author-nationality" role="cell">
                                @if (row.Nationality is { } nationality)
                                {
                                    @nationality
                                }
                                else
                                {
                                    <NotSet Gender="GrammaticalGender.Feminine" Brief="true" />
                                }
                            </span>
                            <span class="author-albums" role="cell" data-empty="@(row.CreditedAlbumCount == 0)">
                                @if (row.CreditedAlbumCount == 0)
                                {
                                    @* A count of none is a datum missing from the row: a dash, as in any list
                                       (visuel/charte-graphique/convivialite-et-efficacite.md), said in full to a screen reader. *@
                                    <span class="not-set"><span aria-hidden="true">—</span><span class="visually-hidden">@L["Albums.None"]</span></span>
                                }
                                else
                                {
                                    @AlbumsText(row)
                                }
                            </span>
                            <span class="author-roles" role="cell" data-empty="@(row.Roles.Count == 0)">@RolesText(row)</span>
                        </span>
                        <span class="author-modified" role="cell"><LocalDateTime Value="row.ModifiedAt" DateOnly="true" /></span>
                        <span class="author-actions" role="cell">
                            <Button Href="@((ListOnly with { Edit = row.Id }).Href())" Icon="IconName.Edit" Label="@L["Edit"]"
                                    IconOnlyOnSmartphone="true" aria-label="@L["Edit.Label", name]" />
                            <ActionsMenu Id="@($"author-actions-{row.Id:N}")" Label="@L["More", name]">
                                <MenuItem Href="@AppPaths.AuthorRecord(row.Id)" Icon="IconName.Exit" Label="@L["Menu.View"]" />
                                <MenuItem Href="@((ListOnly with { Merge = row.Id }).Href())" Icon="IconName.Merge" Label="@L["Menu.Merge"]" />
                                <MenuSeparator />
                                <MenuItem Href="@((ListOnly with { Delete = row.Id }).Href())" Icon="IconName.Delete" Label="@L["Menu.Delete"]"
                                          Variant="ButtonVariant.Delete" />
                            </ActionsMenu>
                        </span>
                    </div>
                }
            </div>

            <Pagination Number="_list.Number" Size="_list.Size" TotalCount="_list.TotalCount"
                        ItemsLabel="@L["Title"]" PageHref="@(page => (ListOnly with { Page = page }).Href())" />
        }
    </ChildContent>
    <Dialogs>
        @if (_query.Edit is not null && _author is not null || _query.Edit is null && _query.Adding)
        {
            <form class="side-panel-form" method="post" @formname="@EntryFormName" @onsubmit="SaveAsync">
                <AntiforgeryToken />
                @if (_author is not null)
                {
                    <input type="hidden" name="@VersionName" value="@EntryVersion" />
                }
                <SidePanel Id="author-panel" Title="@(_author is null ? L["Panel.New"] : L["Panel.Edit"])" CloseHref="@ListOnly.Href()">
                    <ChildContent>
                        @if (OtherProblem is { } problem)
                        {
                            <ErrorMessage Problem="problem" />
                        }
                        @if (_author is not null)
                        {
                            <p class="side-panel-dates">
                                @L["Dates.Created"] <LocalDateTime Value="_author.CreatedAt" />@L["Dates.Modified"] <LocalDateTime Value="_author.ModifiedAt" />.
                            </p>
                        }
                        <div class="author-panel-names">
                            <Field Id="author-first-name" Label="@L["FirstName"]" Context="control">
                                <input id="@control.Id" type="text" name="@FirstNameName" autofocus @bind="EntryFirstName" />
                            </Field>
                            <Field Id="author-last-name" Label="@L["LastName"]" Error="@LastNameError" Context="control">
                                <input id="@control.Id" type="text" name="@LastNameName" aria-describedby="@control.DescribedBy"
                                       aria-invalid="@control.Invalid" @bind="EntryLastName" />
                            </Field>
                        </div>
                        <Field Id="author-pseudonym" Label="@L["Pseudonym"]" Help="@L["Pseudonym.Help"]" Error="@PseudonymError" Context="control">
                            @* An author without last name nor pseudonym, said once under the last name, concerns the pseudonym as much:
                               bordered, and described by it too. *@
                            <input id="@control.Id" type="text" name="@PseudonymName" aria-describedby="@PseudonymDescribedBy(control.DescribedBy)"
                                   aria-invalid="@(PseudonymError is not null || IsProblem(RequiredRule) ? "true" : null)" @bind="EntryPseudonym" />
                        </Field>
                        <Field Id="author-nationality" Label="@L["Nationality"]" Characters="18" Context="control">
                            <input id="@control.Id" type="text" name="@NationalityName" @bind="EntryNationality" />
                        </Field>
                        <Field Id="author-biography" Label="@L["Biography"]" Context="control">
                            <textarea id="@control.Id" name="@BiographyName" rows="6" placeholder="@L["Biography.Placeholder"]">@EntryBiography</textarea>
                        </Field>
                    </ChildContent>
                    <Actions>
                        <Button Type="submit" Variant="ButtonVariant.Primary" Label="@(_author is null ? L["Create"] : L["Save"])" />
                    </Actions>
                </SidePanel>
            </form>
        }
        else if (_dialogAuthor is not null)
        {
            if (_query.Merge is not null)
            {
                <MergeDialog Id="author-merge" Title="@L["Merge.Title"]" Subject="@Name(_dialogAuthor)" Lead="@L["Merge.Lead"]"
                             CloseHref="@ListOnly.Href()" Action="@AppPaths.AdminAuthors"
                             Criteria="@((ListOnly with { Merge = _dialogAuthor.Id }).Parameters())" Text="@_query.MergeText"
                             SearchLabel="@L["Merge.Search"]" Placeholder="@L["Merge.Placeholder"]" Candidates="_candidates"
                             Prompt="@L["Merge.Prompt"]" None="@L["Merge.None", _query.MergeText ?? ""]" CandidatesLabel="@L["Merge.Candidates"]"
                             Note="@L["Merge.Note"]" ContinueAction="@AppPaths.AdminMergeAuthors" SubjectName="author" SubjectId="_dialogAuthor.Id" />
            }
            else
            {
                <DeletionDialog Id="author-deletion" FormName="@DeletionFormName" Title="@L["Deletion.Title"]" Subject="@Name(_dialogAuthor)"
                                CloseHref="@ListOnly.Href()" Lead="@L["Deletion.Lead"]" RefusalLead="@L["Refusal.Lead"]"
                                RefusalHint="@(kind => L[$"Refusal.Hint.{kind}"].Value)" Impact="_impact" Problem="_deletionProblem"
                                Version="_dialogAuthor.Version" OnConfirm="DeleteAsync" />
            }
        }
    </Dialogs>
</ListLayout>

@code {
    private const string DeletionFormName = "author-deletion";
    private const string EntryFormName = "author-entry";
    private const string LastNameName = "lastName";
    private const string FirstNameName = "firstName";
    private const string PseudonymName = "pseudonym";
    private const string NationalityName = "nationality";
    private const string BiographyName = "biography";
    private const string VersionName = "version";

    /// <summary>How many other authors the merge dialog proposes: enough to choose, few enough to read at a glance.</summary>
    internal const int CandidateCount = 10;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The version of the author whose deletion is confirmed.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.VersionName)]
    private uint? Version { get; set; }

    /// <summary>The fingerprint of the impact of the deletion the administrator confirmed.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.FingerprintName)]
    private string? Fingerprint { get; set; }

    [SupplyParameterFromForm(FormName = EntryFormName, Name = LastNameName)]
    private string? EntryLastName { get; set; }

    [SupplyParameterFromForm(FormName = EntryFormName, Name = FirstNameName)]
    private string? EntryFirstName { get; set; }

    [SupplyParameterFromForm(FormName = EntryFormName, Name = PseudonymName)]
    private string? EntryPseudonym { get; set; }

    [SupplyParameterFromForm(FormName = EntryFormName, Name = NationalityName)]
    private string? EntryNationality { get; set; }

    [SupplyParameterFromForm(FormName = EntryFormName, Name = BiographyName)]
    private string? EntryBiography { get; set; }

    /// <summary>The version of the author changed, as its panel read it.</summary>
    [SupplyParameterFromForm(FormName = EntryFormName, Name = VersionName)]
    private uint? EntryVersion { get; set; }

    private AuthorListQuery _query = new();
    private RecordCounts? _counts;
    private Page<AuthorAdminListItem>? _list;
    private ApiProblem? _problem;
    private AuthorAdminListItem? _dialogAuthor;
    private DeletionImpact? _impact;
    private ApiProblem? _deletionProblem;
    private IReadOnlyList<MergeDialog.MergeCandidate>? _candidates;
    private AuthorForm? _author;
    private ApiProblem? _entryProblem;

    // The list with its criteria, without its dialogs nor its panel: where a link of the list, or their closing, leads.
    private AuthorListQuery ListOnly => _query with { Delete = null, Merge = null, MergeText = null, Edit = null, Adding = false };

    private string NewHref => (ListOnly with { Adding = true }).Href();

    // A form sent back, whose fields, even emptied, are those typed.
    private bool IsPost => HttpContext is { } context && HttpMethods.IsPost(context.Request.Method);

    protected override async Task OnInitializedAsync()
    {
        _query = AuthorListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            // The number of authors is the one of the menu, read once per request; without it, the list goes on.
            _counts = await RecordCounts.TryGetAsync();
            _list = await Api.GetAsync<Page<AuthorAdminListItem>>(_query.ApiPath());
            // A page beyond the last one (the page of its only author once deleted, an old address) is no empty list: its
            // authors are on the pages before it, the last of which it leads to, with the same criteria.
            if (_list is { Items.Count: 0, TotalCount: > 0 } authors && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (authors.TotalCount + authors.Size - 1) / authors.Size }).Href());
                return;
            }
            // A dialog opens on an author of the page, from its row: an address written by hand on another author opens none.
            _dialogAuthor = _list.Items.FirstOrDefault(row => row.Id == (_query.Delete ?? _query.Merge));
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        await LoadEntryAsync();

        if (_dialogAuthor is not null && _query.Delete is { } deleted)
            await LoadImpactAsync(deleted);
        else if (_dialogAuthor is not null && _query.MergeText is { } text)
            _candidates = await LoadCandidatesAsync(text);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    // The entry of the panel, if the address opens it: the author changed, read once, or what a form sent back holds.
    private async Task LoadEntryAsync()
    {
        // The panel opens over the list wherever the author is in it, an author deleted meanwhile opening none.
        if (_query.Edit is { } edited)
            _author = await FindAsync(edited);
        // Read once, from the author; a form sent back keeps what was typed, the version always among it.
        if (_author is not null && EntryVersion is null)
        {
            (EntryLastName, EntryFirstName, EntryPseudonym) = (_author.LastName, _author.FirstName, _author.Pseudonym);
            (EntryNationality, EntryBiography, EntryVersion) = (_author.Nationality, _author.Biography, _author.Version);
        }
        // A new author opened on a search that finds none is the author searched (« Créer l'auteur « … » »), its name split as
        // when created on the spot, unless names sent back, even emptied, are to be corrected.
        if (_query is { Adding: true, Edit: null, Text: { } searched } && _list!.Items.Count == 0 && !IsPost)
            (EntryFirstName, EntryLastName) = AuthorNames.Split(searched);
    }

    // The author, or none if it no longer exists: the list is then shown without its panel.
    private async Task<AuthorForm?> FindAsync(Guid id)
    {
        try
        {
            return await Api.GetAsync<AuthorForm>($"/admin/authors/{id}");
        }
        catch (ApiProblemException exception) when (exception.Problem.Status == StatusCodes.Status404NotFound)
        {
            return null;
        }
    }

    private async Task SaveAsync()
    {
        AuthorForm saved;
        try
        {
            saved = _author is not null && EntryVersion is { } version
                ? await Api.PutAsync<UpdateAuthorRequest, AuthorForm>(
                    $"/admin/authors/{_author.Id}",
                    new UpdateAuthorRequest(EntryLastName, EntryFirstName, EntryPseudonym, EntryBiography, EntryNationality, version))
                : await Api.PostAsync<CreateAuthorRequest, AuthorForm>(
                    "/admin/authors", new CreateAuthorRequest(EntryLastName, EntryFirstName, EntryPseudonym, EntryBiography, EntryNationality));
        }
        catch (ApiProblemException exception)
        {
            _entryProblem = exception.Problem;
            return;
        }

        await Recorder.RecordActionAsync(
            _author is null ? AudienceFunctions.AdminAuthorCreated : AudienceFunctions.AdminAuthorSaved, $"author={saved.Id}",
            HttpContext?.RequestAborted ?? default);
        Navigation.NavigateTo(ListOnly.Href());
    }

    private const string RequiredRule = "Author.LastNameOrPseudonymRequired";
    private const string DuplicateRule = "Author.DisplayNameAlreadyUsed";

    // The name the author is displayed under, which two authors never share: the pseudonym if any, otherwise the names
    // (fonctionnel/presentation/tri-et-navigation-par-initiale.md#artistes).
    private bool UnderPseudonym => !string.IsNullOrWhiteSpace(EntryPseudonym);

    // An author without last name nor pseudonym, refused at both fields; a display name already taken, at the field it comes
    // from (visuel/saisie-auteur/contenu.md).
    private string? LastNameError
    {
        get
        {
            if (IsProblem(RequiredRule))
                return L[$"FieldError.{RequiredRule}"].Value;
            return IsProblem(DuplicateRule) && !UnderPseudonym ? DuplicateText : null;
        }
    }

    private string? PseudonymError => IsProblem(DuplicateRule) && UnderPseudonym ? DuplicateText : null;

    private string DuplicateText =>
        L[$"FieldError.{DuplicateRule}", RecordSearch.AuthorName(EntryLastName?.Trim(), EntryFirstName?.Trim(), EntryPseudonym?.Trim())].Value;

    // Any other error, presented at the top of the panel: an author changed or deleted meanwhile, a text too long, a technical error.
    private ApiProblem? OtherProblem => IsProblem(RequiredRule) || IsProblem(DuplicateRule) ? null : _entryProblem;

    private string? PseudonymDescribedBy(string? own) =>
        IsProblem(RequiredRule) ? string.Join(' ', new[] { "author-last-name-error", own }.OfType<string>()) : own;

    private bool IsProblem(string ruleCode) => _entryProblem is { Category: ProblemCategory.Business } problem && problem.RuleCode == ruleCode;

    private async Task LoadImpactAsync(Guid authorId)
    {
        try
        {
            _impact = await Api.GetAsync<DeletionImpact>($"/admin/authors/{authorId}/deletion-impact");
        }
        catch (ApiProblemException exception)
        {
            _deletionProblem = exception.Problem;
        }
    }

    // The other authors found by the search of the dialog, the author itself excepted.
    private async Task<IReadOnlyList<MergeDialog.MergeCandidate>?> LoadCandidatesAsync(string text)
    {
        var found = await Api.GetAsync<Page<AuthorAdminListItem>>(_query.MergeCandidatesApiPath(text, CandidateCount));
        return
        [
            .. found.Items
                .Where(row => row.Id != _dialogAuthor!.Id)
                .Take(CandidateCount)
                .Select(row => new MergeDialog.MergeCandidate(row.Id, Name(row), CandidateDetail(row))),
        ];
    }

    private async Task DeleteAsync()
    {
        if (_dialogAuthor is null || Version is not { } version || Fingerprint is null)
            return;

        try
        {
            await Api.DeleteAsync($"/admin/authors/{_dialogAuthor.Id}?version={version}&fingerprint={Uri.EscapeDataString(Fingerprint)}");
        }
        catch (ApiProblemException exception)
        {
            // A deletion refused, or whose impact changed since its confirmation, announces the current impact, to confirm
            // again or to resolve; any other error is presented as it is.
            _deletionProblem = exception.Problem;
            _impact = exception.Problem.Impact;
            if (_impact is { BlockedBy.Count: > 0 })
                _deletionProblem = null;
            return;
        }

        await Recorder.RecordActionAsync(AudienceFunctions.AdminAuthorsDeleted, $"author={_dialogAuthor.Id}", HttpContext?.RequestAborted ?? default);
        Navigation.NavigateTo(ListOnly.Href());
    }

    private string CountText() => _list!.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // The main identifier of the author (fonctionnel/presentation/tri-et-navigation-par-initiale.md#artistes).
    private static string Name(AuthorAdminListItem row) => RecordSearch.AuthorName(row.LastName, row.FirstName, row.Pseudonym);

    // Under a pseudonym, the first name and the last name, if any, below it (visuel/listes/liste-par-liste.md).
    private static string? Identity(AuthorAdminListItem row) =>
        row.Pseudonym is null || RecordSearch.AuthorName(row.LastName, row.FirstName, null) is not { Length: > 0 } identity ? null : identity;

    private string AlbumsText(AuthorAdminListItem row) => row.CreditedAlbumCount switch
    {
        0 => L["Albums.None"],
        1 => L["Albums.One"],
        var count => L["Albums.Other", Format.Number(count)],
    };

    // « Scénario · Dessin », in role order; « — » for an author credited on nothing.
    private string RolesText(AuthorAdminListItem row) =>
        row.Roles.Count == 0 ? L["Roles.None"] : string.Join(" · ", row.Roles.Select(role => L[$"Role.{role}"].Value));

    private string CandidateDetail(AuthorAdminListItem candidate) => string.Join(" · ", new[]
    {
        candidate.Nationality,
        AlbumsText(candidate),
        candidate.Roles.Count == 0 ? null : RolesText(candidate),
    }.Where(part => part is not null));
}
