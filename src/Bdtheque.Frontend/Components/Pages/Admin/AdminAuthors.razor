@attribute [Route(AppPaths.AdminAuthors)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Deletion
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<AdminAuthors> L
@inject ApiClient Api
@inject AdminRecordCounts RecordCounts
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The list of the authors of the administration (visuel/listes/liste-par-liste.md), after the model of the list of the albums
   (visuel/listes/listes-de-l-administration.md): rendered statically, every criterion and the dialogs are carried by its
   address (Lists/AuthorListQuery.cs); the list has no filters. Its styles read the contracts of the base theme only
   (visuel/listes/declinaison-par-theme.md). *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.AdminAuthors" />

<ListLayout Title="@L["ListTitle"]" Kicker="@L["Kicker"]" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_counts?.Authors" NewHref="@AppPaths.AdminNewAuthor" NewLabel="@L["New"]" />
    </Heading>
    <ChildContent>
        <ListSearch Action="@AppPaths.AdminAuthors" FieldId="authors-search" TextName="@AdminListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" />

        <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (ListOnly with { Entry = entry, Page = 1 }).Href())" />

        <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@(_query.Text is not null)" WholeCount="_counts?.Authors"
                     Order="@L["Order"]" />

        @if (_list!.Items.Count == 0)
        {
            @* Without any criterion, the list is merely empty: nothing to clear, nor search to recall (#315). *@
            if (_query.Text is { } text)
            {
                <EmptyList Message="@L["Empty.Text", text]" Hint="@L["Empty.Hint"]">
                    <Actions>
                        <Button Href="@((ListOnly with { Text = null, Page = 1 }).Href())" Label="@L["Empty.Clear"]" />
                        <Button Href="@AppPaths.AdminNewAuthor" Variant="ButtonVariant.Primary" Label="@L["Empty.Create", text]" />
                    </Actions>
                </EmptyList>
            }
            else if (_query.Entry is not null)
            {
                <EmptyList Message="@L["Empty.Entry"]">
                    <Actions>
                        <Button Href="@AppPaths.AdminAuthors" Label="@L["Empty.All"]" />
                    </Actions>
                </EmptyList>
            }
            else
            {
                <EmptyList Message="@L["Empty.None"]" />
            }
        }
        else
        {
            <div class="author-rows" role="table" aria-label="@L["Title"]">
                <div class="author-row author-row-head" role="row">
                    <span class="author-monogram" role="columnheader"><span class="visually-hidden">@L["Column.Monogram"]</span></span>
                    <span class="author-main" role="columnheader">@L["Column.Author"]</span>
                    <span class="author-nationality" role="columnheader">@L["Column.Nationality"]</span>
                    <span class="author-albums" role="columnheader">@L["Column.Albums"]</span>
                    <span class="author-roles" role="columnheader">@L["Column.Roles"]</span>
                    <span class="author-modified" role="columnheader">@L["Column.Modified"]</span>
                    <span class="author-actions" role="columnheader"><span class="visually-hidden">@L["Column.Actions"]</span></span>
                </div>
                @foreach (var row in _list.Items)
                {
                    var name = Name(row);
                    <div class="author-row" role="row">
                        <span class="author-monogram" role="cell">
                            <Monogram LastName="@row.LastName" FirstName="@row.FirstName" Pseudonym="@row.Pseudonym" />
                        </span>
                        <span class="author-main" role="cell">
                            <a class="author-name" href="@AppPaths.AdminEditAuthor(row.Id)">@name</a>
                            @if (Identity(row) is { } identity)
                            {
                                <span class="author-identity">@identity</span>
                            }
                        </span>
                        <span class="author-meta">
                            <span class="author-nationality" role="cell">
                                @if (row.Nationality is { } nationality)
                                {
                                    @nationality
                                }
                                else
                                {
                                    <NotSet Gender="GrammaticalGender.Feminine" Brief="true" />
                                }
                            </span>
                            <span class="author-albums" role="cell" data-empty="@(row.CreditedAlbumCount == 0)">@AlbumsText(row)</span>
                            <span class="author-roles" role="cell" data-empty="@(row.Roles.Count == 0)">@RolesText(row)</span>
                        </span>
                        <span class="author-modified" role="cell"><LocalDateTime Value="row.ModifiedAt" DateOnly="true" /></span>
                        <span class="author-actions" role="cell">
                            <Button Href="@AppPaths.AdminEditAuthor(row.Id)" Icon="IconName.Edit" Label="@L["Edit"]"
                                    IconOnlyOnSmartphone="true" aria-label="@L["Edit.Label", name]" />
                            <ActionsMenu Id="@($"author-actions-{row.Id:N}")" Label="@L["More", name]">
                                <MenuItem Href="@AppPaths.AuthorRecord(row.Id)" Icon="IconName.Exit" Label="@L["Menu.View"]" />
                                <MenuItem Href="@((ListOnly with { Merge = row.Id }).Href())" Icon="IconName.Merge" Label="@L["Menu.Merge"]" />
                                <MenuSeparator />
                                <MenuItem Href="@((ListOnly with { Delete = row.Id }).Href())" Icon="IconName.Delete" Label="@L["Menu.Delete"]"
                                          Variant="ButtonVariant.Delete" />
                            </ActionsMenu>
                        </span>
                    </div>
                }
            </div>

            <Pagination Number="_list.Number" Size="_list.Size" TotalCount="_list.TotalCount"
                        ItemsLabel="@L["Title"]" PageHref="@(page => (ListOnly with { Page = page }).Href())" />
        }
    </ChildContent>
    <Dialogs>
        @if (_dialogAuthor is not null)
        {
            if (_query.Merge is not null)
            {
                <MergeDialog Id="author-merge" Title="@L["Merge.Title"]" Subject="@Name(_dialogAuthor)" Lead="@L["Merge.Lead"]"
                             CloseHref="@ListOnly.Href()" Action="@AppPaths.AdminAuthors"
                             Criteria="@((ListOnly with { Merge = _dialogAuthor.Id }).Parameters())" Text="@_query.MergeText"
                             SearchLabel="@L["Merge.Search"]" Placeholder="@L["Merge.Placeholder"]" Candidates="_candidates"
                             Prompt="@L["Merge.Prompt"]" None="@L["Merge.None", _query.MergeText ?? ""]" CandidatesLabel="@L["Merge.Candidates"]"
                             Note="@L["Merge.Note"]" ContinueAction="@AppPaths.AdminMergeAuthors" SubjectName="author" SubjectId="_dialogAuthor.Id" />
            }
            else
            {
                <DeletionDialog Id="author-deletion" FormName="@DeletionFormName" Title="@L["Deletion.Title"]" Subject="@Name(_dialogAuthor)"
                                CloseHref="@ListOnly.Href()" Lead="@L["Deletion.Lead"]" RefusalLead="@L["Refusal.Lead"]"
                                RefusalHint="@(kind => L[$"Refusal.Hint.{kind}"].Value)" Impact="_impact" Problem="_deletionProblem"
                                Version="_dialogAuthor.Version" OnConfirm="DeleteAsync" />
            }
        }
    </Dialogs>
</ListLayout>

@code {
    private const string DeletionFormName = "author-deletion";

    /// <summary>How many other authors the merge dialog proposes: enough to choose, few enough to read at a glance.</summary>
    internal const int CandidateCount = 10;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The version of the author whose deletion is confirmed.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.VersionName)]
    private uint? Version { get; set; }

    /// <summary>The fingerprint of the impact of the deletion the administrator confirmed.</summary>
    [SupplyParameterFromForm(FormName = DeletionFormName, Name = DeletionDialog.FingerprintName)]
    private string? Fingerprint { get; set; }

    private AuthorListQuery _query = new();
    private RecordCounts? _counts;
    private Page<AuthorAdminListItem>? _list;
    private ApiProblem? _problem;
    private AuthorAdminListItem? _dialogAuthor;
    private DeletionImpact? _impact;
    private ApiProblem? _deletionProblem;
    private IReadOnlyList<MergeDialog.MergeCandidate>? _candidates;

    // The list with its criteria, without its dialogs: where a link of the list, or the closing of a dialog, leads.
    private AuthorListQuery ListOnly => _query with { Delete = null, Merge = null, MergeText = null };

    protected override async Task OnInitializedAsync()
    {
        _query = AuthorListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            // The number of authors is the one of the menu, read once per request; without it, the list goes on.
            _counts = await RecordCounts.TryGetAsync();
            _list = await Api.GetAsync<Page<AuthorAdminListItem>>(_query.ApiPath());
            // A page beyond the last one (the page of its only author once deleted, an old address) is no empty list: its
            // authors are on the pages before it, the last of which it leads to, with the same criteria.
            if (_list is { Items.Count: 0, TotalCount: > 0 } authors && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (authors.TotalCount + authors.Size - 1) / authors.Size }).Href());
                return;
            }
            // A dialog opens on an author of the page, from its row: an address written by hand on another author opens none.
            _dialogAuthor = _list.Items.FirstOrDefault(row => row.Id == (_query.Delete ?? _query.Merge));
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        if (_dialogAuthor is not null && _query.Delete is { } deleted)
            await LoadImpactAsync(deleted);
        else if (_dialogAuthor is not null && _query.MergeText is { } text)
            _candidates = await LoadCandidatesAsync(text);

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    private async Task LoadImpactAsync(Guid authorId)
    {
        try
        {
            _impact = await Api.GetAsync<DeletionImpact>($"/admin/authors/{authorId}/deletion-impact");
        }
        catch (ApiProblemException exception)
        {
            _deletionProblem = exception.Problem;
        }
    }

    // The other authors found by the search of the dialog, the author itself excepted.
    private async Task<IReadOnlyList<MergeDialog.MergeCandidate>?> LoadCandidatesAsync(string text)
    {
        var found = await Api.GetAsync<Page<AuthorAdminListItem>>(_query.MergeCandidatesApiPath(text, CandidateCount));
        return
        [
            .. found.Items
                .Where(row => row.Id != _dialogAuthor!.Id)
                .Take(CandidateCount)
                .Select(row => new MergeDialog.MergeCandidate(row.Id, Name(row), CandidateDetail(row))),
        ];
    }

    private async Task DeleteAsync()
    {
        if (_dialogAuthor is null || Version is not { } version || Fingerprint is null)
            return;

        try
        {
            await Api.DeleteAsync($"/admin/authors/{_dialogAuthor.Id}?version={version}&fingerprint={Uri.EscapeDataString(Fingerprint)}");
        }
        catch (ApiProblemException exception)
        {
            // A deletion refused, or whose impact changed since its confirmation, announces the current impact, to confirm
            // again or to resolve; any other error is presented as it is.
            _deletionProblem = exception.Problem;
            _impact = exception.Problem.Impact;
            if (_impact is { BlockedBy.Count: > 0 })
                _deletionProblem = null;
            return;
        }

        await Recorder.RecordActionAsync(AudienceFunctions.AdminAuthorsDeleted, $"author={_dialogAuthor.Id}", HttpContext?.RequestAborted ?? default);
        Navigation.NavigateTo(ListOnly.Href());
    }

    private string CountText() => _list!.TotalCount switch
    {
        0 => L["Count.None"],
        1 => L["Count.One"],
        var count => L["Count.Other", Format.Number(count)],
    };

    // The main identifier of the author (fonctionnel/presentation/tri-et-navigation-par-initiale.md#artistes).
    private static string Name(AuthorAdminListItem row) => RecordSearch.AuthorName(row.LastName, row.FirstName, row.Pseudonym);

    // Under a pseudonym, the first name and the last name, if any, below it (visuel/listes/liste-par-liste.md).
    private static string? Identity(AuthorAdminListItem row) =>
        row.Pseudonym is null || RecordSearch.AuthorName(row.LastName, row.FirstName, null) is not { Length: > 0 } identity ? null : identity;

    private string AlbumsText(AuthorAdminListItem row) => row.CreditedAlbumCount switch
    {
        0 => L["Albums.None"],
        1 => L["Albums.One"],
        var count => L["Albums.Other", Format.Number(count)],
    };

    // « Scénario · Dessin », in role order; « — » for an author credited on nothing.
    private string RolesText(AuthorAdminListItem row) =>
        row.Roles.Count == 0 ? L["Roles.None"] : string.Join(" · ", row.Roles.Select(role => L[$"Role.{role}"].Value));

    private string CandidateDetail(AuthorAdminListItem candidate) => string.Join(" · ", new[]
    {
        candidate.Nationality,
        AlbumsText(candidate),
        candidate.Roles.Count == 0 ? null : RolesText(candidate),
    }.Where(part => part is not null));
}
