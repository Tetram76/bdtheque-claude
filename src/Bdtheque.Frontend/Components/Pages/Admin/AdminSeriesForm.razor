@attribute [Route(AppPaths.AdminNewSeries)]
@attribute [Route("/admin/series/{Id:guid}")]
@rendermode InteractiveServer
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Entries
@inject IStringLocalizer<AdminSeriesForm> L
@inject IStringLocalizer<FieldMessages> FieldTexts
@inject IStringLocalizer<RuleMessages> RuleTexts
@inject ApiClient Api
@inject ValueLabels Values
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The entry form of a series (visuel/saisie-serie/contenu.md), on the model of the entry form of an album, whose frame, errors,
   authors, genres and universes it shares: interactive, its title and sort key follow the typing, and the records it references
   are chosen by typing their name. No side column: the albums of a series are entered on their own form. It applies no rule of
   the series, which the domain alone holds (choix-implementation/ecritures/erreurs-metier-fonctionnelles-et-techniques.md): the
   error of its saving says what to correct, and points to the field concerned. Its styles read the contracts of the base theme
   only (visuel/saisie-serie/declinaison-par-theme.md). *@
<PageTitle>@PageTitle</PageTitle>
<AudienceScreen Function="@(Id is null ? AudienceFunctions.AdminNewSeriesForm : AudienceFunctions.AdminSeriesForm)"
                Record="@(Id is { } id ? new PresentedRecord(RecordType.Series, id) : null)" />

@if (Entry is null)
{
    @if (_loadProblem is not null)
    {
        <Breadcrumb Items="@([new(L["Administration"], AppPaths.AdminHome), new(L["Series"], AppPaths.AdminSeries), new(L["Breadcrumb.Unknown"])])" />
        <ErrorMessage Problem="_loadProblem" />
    }
}
else
{
    <EntryForm @key="_reading" @ref="_form" HasRedo="Tracker.HasRedo" Breadcrumb="@([new(L["Administration"], AppPaths.AdminHome), new(L["Series"], AppPaths.AdminSeries), new(Entry.Id is null ? L["New"] : Subject)])"
               Title="@(Entry.Id is null ? L["New"] : L["Edit"])" Subject="@Subject" State="State" Saving="_saving"
               SaveLabel="@(Entry.Id is null ? L["Create"] : L["Save"])" CancelHref="@ReturnHref" OnSave="SaveAsync"
               Problem="@SaveProblem" Dates="@Dates">
        <Block Title="@L["Block.Series"]" Kicker="@L["Kicker.Series"]">
            <div class="series-fields">
                <Field Id="series-title" Label="@L["Title"]" Required State="@DatumState("title")" Error="@Errors.For("/title")" Context="control">
                    <input id="@control.Id" type="text" placeholder="@L["Title.Placeholder"]" aria-describedby="@control.DescribedBy"
                           aria-invalid="@control.Invalid" @bind="Entry.Title" @bind:event="oninput" />
                </Field>
                <TitleSortKeyField Id="series-sort-key" Title="@Entry.Title" StoredKey="@Entry.StoredSortKey" @bind-ManualKey="Entry.ManualSortKey"
                                   UntitledHelp="@L["SortKey.Help"]" Error="@Errors.For("/manualSortKey")" State="@DatumState("sortKey")" />
                <Field Id="series-status" Label="@L["Status"]" Help="@L["Status.Help"]" State="@DatumState("status")" Context="control">
                    <select id="@control.Id" class="series-list" aria-describedby="@control.DescribedBy" @bind="Entry.Status">
                        <option value="">@L["Status.None"]</option>
                        @foreach (var status in Enum.GetValues<SeriesStatus>())
                        {
                            <option value="@status">@Values.Of(status)</option>
                        }
                    </select>
                </Field>
            </div>
        </Block>

        <div class="series-pair">
            <Block Title="@L["Block.Progress"]" Kicker="@L["Kicker.Progress"]">
                <div class="series-fields">
                    <Field Id="series-volumes" Label="@L["Volumes"]" Help="@L["Volumes.Help"]" Characters="4" Error="@Errors.For("/theoreticalVolumeCount")" State="@DatumState("volumes")" Context="control">
                        <input id="@control.Id" type="text" inputmode="numeric" maxlength="4" aria-describedby="@control.DescribedBy"
                               aria-invalid="@control.Invalid" @bind="Entry.TheoreticalVolumeCount" />
                    </Field>
                    <div class="series-choice">
                        <Choice Id="series-complete" Label="@L["Complete"]" State="@DatumState("complete")"><input type="checkbox" aria-describedby="series-complete-help" @bind="Entry.IsComplete" /></Choice>
                        <p id="series-complete-help" class="series-help">@L["Complete.Help"]</p>
                    </div>
                </div>
            </Block>
            <Block Title="@L["Block.Computations"]" Kicker="@L["Kicker.Computations"]">
                <div class="series-fields">
                    <div class="series-choice">
                        <Choice Id="series-exclude-missing" Label="@L["ExcludeFromMissingVolumes"]" State="@DatumState("excludeFromMissingVolumes")">
                            <input type="checkbox" aria-describedby="series-computations-help" @bind="Entry.ExcludeFromMissingVolumes" />
                        </Choice>
                        <Choice Id="series-exclude-estimates" Label="@L["ExcludeFromReleaseEstimates"]" State="@DatumState("excludeFromReleaseEstimates")">
                            <input type="checkbox" aria-describedby="series-computations-help" @bind="Entry.ExcludeFromReleaseEstimates" />
                        </Choice>
                        <p id="series-computations-help" class="series-help">@L["Computations.Help"]</p>
                    </div>
                </div>
            </Block>
        </div>

        <Block Title="@L["Block.Authors"]" Kicker="@L["Kicker.Authors"]">
            <div class="series-fields">
                <RoleCredits Id="series" Records="Entry.Cited" Read="ReadCited" StateOf="DatumState" ErrorOf="AddedError" Help="@L["Authors.Help"]" AuthorCreated="AudienceFunctions.AdminSeriesAuthorCreated"
                             OnChange="StateHasChanged" />
            </div>
        </Block>

        <Block Title="@L["Block.Publisher"]" Kicker="@L["Kicker.Publisher"]">
            <div class="series-fields">
                <div class="series-publisher">
                    <Field Id="series-publisher" Label="@L["Publisher"]" State="PublisherState" Error="@(Entry.Publisher is { } chosen ? AddedError(chosen.Id) : null)"
                           Context="control">
                        <RecordPicker Id="@control.Id" Kind="RecordKind.Publisher" Value="Entry.Publisher" ValueChanged="ChoosePublisherAsync"
                                      Placeholder="@L["Publisher.Placeholder"]" OnCreate="text => _publisherCreation = text"
                                      CreateLabel="@(text => L["Publisher.Create", text].Value)" Pending="PendingPublishers"
                                      aria-describedby="@(control.DescribedBy is { } described ? $"{described} series-publisher-help" : "series-publisher-help")"
                                      aria-invalid="@control.Invalid" />
                    </Field>
                    @* One of the collections of the publisher, in the list of them all, which ends with the creation of a new one:
                       unavailable until one is chosen, and removed when it changes. *@
                    <Field Id="series-collection" Label="@L["Collection"]" State="CollectionState" Error="@CollectionError" Failure="CollectionsProblem"
                           FailureText="@L["Collection.Unread"]" Context="control">
                        <ListPicker Id="@control.Id" Label="@L["Collection"]" Options="CollectionOptions" Value="Entry.PublisherCollection"
                                    ValueChanged="collection => Entry.PublisherCollection = collection" Disabled="@(Entry.Publisher is null)"
                                    NoneLabel="@(Entry.Publisher is null ? L["Collection.NoPublisher"] : L["Collection.None"])"
                                    CreateLabel="@L["Collection.Create"]" OnCreate="() => _collectionCreation = true"
                                    aria-describedby="@(control.DescribedBy is { } described ? $"{described} series-publisher-help" : "series-publisher-help")"
                                    aria-invalid="@control.Invalid" />
                    </Field>
                </div>
                <p id="series-publisher-help" class="series-help">@L["Publisher.Help"]</p>
            </div>
        </Block>

        <Block Title="@L["Block.Classification"]" Kicker="@L["Kicker.Classification"]">
            <div class="series-fields">
                <ClassificationTags Id="series" Records="Entry.Cited" Read="ReadCited" GenresState="@DatumState(CitedRecords.GenresKey)" UniversesState="@DatumState(CitedRecords.UniversesKey)" ErrorOf="AddedError" Help="@L["Classification.Help"]" OnChange="StateHasChanged"
                                    GenreCreated="AudienceFunctions.AdminSeriesGenreCreated" UniverseCreated="AudienceFunctions.AdminSeriesUniverseCreated" />
            </div>
        </Block>

        <Block Title="@L["Block.Reading"]" Kicker="@L["Kicker.Reading"]">
            <div class="series-fields">
                <Field Id="series-summary" Label="@L["Summary"]" State="@DatumState("summary")" Context="control">
                    <textarea id="@control.Id" rows="4" placeholder="@L["Summary.Placeholder"]" @bind="Entry.Summary"></textarea>
                </Field>
                <Field Id="series-notes" Label="@L["Notes"]" State="@DatumState("notes")" Context="control">
                    <textarea id="@control.Id" rows="3" placeholder="@L["Notes.Placeholder"]" @bind="Entry.PersonalNotes"></textarea>
                </Field>
            </div>
        </Block>

        @* What the new editions of the albums of the series are proposed (fonctionnel/regles-metier/initialisation-d-une-nouvelle-edition-depuis-la-serie.md):
           each value a list sized to its longest choice, « — » proposing nothing; the color too, of three choices. *@
        <Block Title="@L["Block.Template"]" Kicker="@L["Kicker.Template"]">
            <div class="series-fields">
                @if (Entry.Id is null)
                {
                    <div class="series-template-notice">
                        <Notice Icon="IconName.Copy">@L["Template.Proposed"]</Notice>
                    </div>
                }
                <div class="series-template">
                    @TemplateList("series-category", "category", L["Category"], () => Entry.Category, value => Entry.Category = value)
                    @TemplateList("series-condition", "condition", L["Condition"], () => Entry.Condition, value => Entry.Condition = value)
                    @TemplateList("series-binding", "binding", L["Binding"], () => Entry.Binding, value => Entry.Binding = value)
                    @TemplateList("series-format", "format", L["Format"], () => Entry.Format, value => Entry.Format = value)
                    @TemplateList("series-orientation", "orientation", L["Orientation"], () => Entry.Orientation, value => Entry.Orientation = value)
                    @TemplateList("series-direction", "readingDirection", L["ReadingDirection"], () => Entry.ReadingDirection, value => Entry.ReadingDirection = value)
                    <Field Id="series-color" Label="@L["Color"]" State="@DatumState("color")" Context="control">
                        @* Blazor binds no nullable boolean to a list: its value is written and read as its options name it. *@
                        <select id="@control.Id" class="series-list" value="@(Entry.IsColor switch { true => "true", false => "false", null => "" })"
                                @onchange="args => Entry.IsColor = bool.TryParse(args.Value as string, out var isColor) ? isColor : null">
                            <option value="">@L["Template.None"]</option>
                            <option value="true">@L["Color.Color"]</option>
                            <option value="false">@L["Color.BlackAndWhite"]</option>
                        </select>
                    </Field>
                </div>
                <p class="series-help">@L["Template.Help"]</p>
            </div>
        </Block>
    </EntryForm>

    @if (_publisherCreation is { } publisherName)
    {
        <PublisherCreationDialog Id="series-publisher-creation" Text="@publisherName" OnCreated="PublisherCreatedAsync"
                                 OnCancel="() => _publisherCreation = null" />
    }
    @if (_collectionCreation && Entry.Publisher is { } collectionPublisher)
    {
        <PublisherCollectionCreationDialog Id="series-collection-creation" PublisherId="collectionPublisher.Id" OnCreated="CollectionCreatedAsync"
                                           OnCancel="() => _collectionCreation = false" />
    }
    @if (_changesShown)
    {
        <ChangesDialog Id="series-changes" Subject="@Subject" Changes="Tracker.Changes()" OnClose="() => _changesShown = false" />
    }
}

@code {
    private ApiProblem? _loadProblem;
    private ApiProblem? _saveProblem;
    // The records added on the spot that the last saving sent, in the order of its content, where its error designates them.
    private NewRecords? _sentRecords;
    private EntryForm? _form;
    private bool _revealProblem;
    private bool _saving;
    private string? _savedFingerprint;
    private bool _changesShown;
    private EntryTracker<SeriesEntry>? _tracker;
    // The number of the reading of the series: the form is rendered anew for each, its controls reading the record reloaded.
    private int _reading;
    private int _publisherChoice;
    // The name typed in the choice of the publisher, while its creation on the spot is being confirmed.
    private string? _publisherCreation;
    // Whether the creation of a collection on the spot is being confirmed.
    private bool _collectionCreation;

    /// <summary>The series to modify; none for a new series.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The page the form was opened from, when not its list (<see cref="AppPaths.FromParameter"/>).</summary>
    [SupplyParameterFromQuery(Name = AppPaths.FromParameter)]
    public string? From { get; set; }

    // Where a record saved, created or modified, or cancelled, leads (visuel/saisie-album/contenu.md, decisions of the user): the
    // record of the series in the consultation when the form was opened from it (#658), the list otherwise.
    private string ReturnHref => Id is { } id && AppPaths.IsFromRecord(From) ? AppPaths.SeriesRecord(id) : AppPaths.AdminSeries;

    /// <summary>For a new series, the text searched in its list, which found nothing: its title (AppPaths.NewWithSearched).</summary>
    [SupplyParameterFromQuery(Name = AppPaths.SearchedParameter)]
    public string? Searched { get; set; }

    /// <summary>The series as the form holds it, read once, by the prerendering.</summary>
    [PersistentState]
    public SeriesEntry? Entry { get; set; }

    /// <summary>The series as it was read or last saved: what the user changed since.</summary>
    [PersistentState]
    public SeriesEntry? ReadEntry { get; set; }

    /// <summary>
    /// The collections of the publisher chosen, by name, which its collection is chosen among; none without publisher, nor
    /// while they are read, nor if they could not be.
    /// </summary>
    [PersistentState]
    public List<RecordOption>? PublisherCollections { get; set; }

    /// <summary>
    /// The error the reading of the collections of the publisher chosen met, which the field presents; none once they are
    /// read. Persisted with the form, so that collections not read by the prerendering stay so once interactive.
    /// </summary>
    [PersistentState]
    public ApiProblem? CollectionsProblem { get; set; }

    // The title of the series, as typed; « <Sans titre> » while nothing is.
    private string Subject => string.IsNullOrWhiteSpace(Entry!.Title) ? L["Untitled"] : Entry.Title.Trim();

    private string PageTitle => Entry is null || Entry.Id is null ? L["New"] : L["PageTitle", Subject];

    private SaveBarState State => Entry!.Id is null ? SaveBarState.New : SavedState;

    // The state of a series already saved: whether its form still holds what was last read or saved.
    private SaveBarState SavedState => Entry!.Fingerprint() == _savedFingerprint ? SaveBarState.Unchanged : SaveBarState.Unsaved;

    protected override async Task OnInitializedAsync()
    {
        if (Entry is null)
        {
            try
            {
                Entry = Id is { } id
                    ? SeriesEntry.Of(await Api.GetAsync<SeriesForm>($"/admin/series/{id}"))
                    : SeriesEntry.New(await Api.GetAsync<SeriesContent>("/admin/series/new"), Searched);
                ReadEntry = Entry.Copy();
                if (Entry.Publisher is { } publisher)
                    (PublisherCollections, CollectionsProblem) = await CollectionsOfAsync(publisher.Id);
            }
            catch (ApiProblemException exception)
            {
                _loadProblem = exception.Problem;
                return;
            }
        }

        _savedFingerprint = ReadEntry!.Fingerprint();
    }

    // A value proposed to the new editions, a list of its values, « — » proposing nothing.
    private RenderFragment TemplateList<TEnum>(string id, string key, string label, Func<TEnum?> get, Action<TEnum?> set) where TEnum : struct, Enum =>
        @<Field Id="@id" Label="@label" State="@DatumState(key)" Context="control">
            <select id="@control.Id" class="series-list" value="@(get()?.ToString() ?? "")"
                    @onchange="args => set(Enum.TryParse<TEnum>(args.Value as string, out var value) ? value : null)">
                <option value="">@L["Template.None"]</option>
                @foreach (var value in Enum.GetValues<TEnum>())
                {
                    <option value="@value">@Values.Of(value)</option>
                }
            </select>
        </Field>;

    // The collection is removed when the publisher changes, and is chosen among those of the new one. Each choice is numbered,
    // as the choice of a series on the form of an album: only the collections of the last publisher chosen are listed.
    private async Task ChoosePublisherAsync(RecordOption? publisher)
    {
        var choice = ++_publisherChoice;
        var changed = publisher?.Id != Entry!.Publisher?.Id;
        Entry.ChoosePublisher(publisher);
        if (!changed)
            return;
        // None while those of the new one are read; none at all for a publisher added on the spot, which does not exist yet.
        (PublisherCollections, CollectionsProblem) = ([], null);
        if (publisher is null || Entry.PublisherIsNew)
            return;
        var read = await CollectionsOfAsync(publisher.Id);
        if (choice == _publisherChoice)
            (PublisherCollections, CollectionsProblem) = read;
    }

    // The publisher added on the spot, created only with the series when it is saved: cancelling creates none of them. It is
    // chosen as any publisher.
    private async Task PublisherCreatedAsync(NewPublisher publisher)
    {
        _publisherCreation = null;
        Entry!.NewPublishers.Add(publisher);
        await ChoosePublisherAsync(new RecordOption(publisher.Key, publisher.Name, null));
        await Recorder.RecordActionAsync(AudienceFunctions.AdminSeriesPublisherCreated);
    }

    // Suggested again once replaced, rather than created twice, as the search does not know them.
    private IReadOnlyList<RecordOption> PendingPublishers => [.. Entry!.NewPublishers.Select(p => new RecordOption(p.Key, p.Name, null))];

    // The collections of a publisher, by name; none, with the error met, if they cannot be read.
    private async Task<(List<RecordOption> Collections, ApiProblem? Problem)> CollectionsOfAsync(Guid publisherId)
    {
        try
        {
            var collections = await Api.GetAsync<List<PublisherCollectionForm>>($"/admin/publishers/{publisherId}/collections");
            return ([.. collections.Select(c => new RecordOption(c.Id, c.Name, null))], null);
        }
        catch (ApiProblemException exception)
        {
            return ([], exception.Problem);
        }
    }

    // The collections of the publisher chosen, with those added to it on the spot, which the search does not know.
    private IReadOnlyList<RecordOption> CollectionOptions =>
        CollectionChoice.Options(PublisherCollections, Entry!.NewPublisherCollections, Entry.Publisher);

    // The collection added on the spot, created only with the series when it is saved, in its publisher: cancelling creates none
    // of them. It is chosen as any collection.
    private async Task CollectionCreatedAsync(NewPublisherCollection collection)
    {
        _collectionCreation = false;
        Entry!.NewPublisherCollections.Add(collection);
        Entry.PublisherCollection = new RecordOption(collection.Key, collection.Name, null);
        await Recorder.RecordActionAsync(AudienceFunctions.AdminSeriesCollectionCreated);
    }

    // The collection to correct: the one chosen, or the one added on the spot that the saving refused.
    private string? CollectionError =>
        Errors.For("/editionTemplate/publisherCollectionId") ?? (Entry!.PublisherCollection is { } chosen ? AddedError(chosen.Id) : null);

    private async Task SaveAsync()
    {
        if (_saving)
            return;
        _saving = true;
        _saveProblem = null;
        var content = Entry!.ToContent();
        _sentRecords = content.NewRecords;
        try
        {
            if (Entry.Id is { } id)
            {
                await Api.PutAsync<UpdateSeriesRequest, SeriesForm>($"/admin/series/{id}", new UpdateSeriesRequest(content, Entry.Version));
                await Recorder.RecordActionAsync(AudienceFunctions.AdminSeriesSaved, $"series={id}");
            }
            else
            {
                var created = await Api.PostAsync<SeriesContent, SeriesForm>("/admin/series", content);
                await Recorder.RecordActionAsync(AudienceFunctions.AdminSeriesCreated, $"series={created.Id}");
            }

            Navigation.NavigateTo(ReturnHref);
        }
        catch (ApiProblemException exception)
        {
            _saveProblem = exception.Problem;
            _revealProblem = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // Once the error of a saving is rendered, what is to correct is brought into view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealProblem && _form is not null)
        {
            _revealProblem = false;
            await _form.RevealProblemAsync();
        }
    }

    private async Task ShowChangesAsync()
    {
        _changesShown = true;
        await Recorder.RecordActionAsync(AudienceFunctions.AdminSeriesChanges, $"series={Entry!.Id}");
    }

    // The record as it is now, read anew within the circuit: the entry left behind offers again, under each datum, what the
    // user had entered (visuel/saisie-album/contenu.md, #329). The form is rendered anew, its controls reading the record reloaded.
    private async Task ReloadAsync()
    {
        try
        {
            var reloaded = SeriesEntry.Of(await Api.GetAsync<SeriesForm>($"/admin/series/{Entry!.Id!.Value}"));
            var collections = reloaded.Publisher is { } publisher ? await CollectionsOfAsync(publisher.Id) : ([], null);
            Tracker.Abandon();
            Entry = reloaded;
            ReadEntry = reloaded.Copy();
            (PublisherCollections, CollectionsProblem) = collections;
            _savedFingerprint = ReadEntry.Fingerprint();
            _saveProblem = null;
            _publisherChoice++;
            _reading++;
        }
        catch (ApiProblemException exception)
        {
            // Deleted meanwhile, or unreadable: said as the error of the saving was, the entry staying as it is.
            _saveProblem = exception.Problem;
        }
    }
    // What to correct in each field the error of the saving designates (visuel/saisie-album/contenu.md).
    private FieldErrors Errors => new(_saveProblem, FieldTexts, RuleTexts, Subject);

    // A record added on the spot that the saving refused, designated by its tag (visuel/saisie-album/contenu.md).
    private string? AddedError(Guid key) => Errors.ForAdded(_sentRecords, key);

    // The three categories told apart at first glance, each with what the user can do about it (visuel/saisie-serie/contenu.md).
    private RenderFragment? SaveProblem => _saveProblem is not { } problem ? null
        : @<SaveError Problem="problem" Conflict="@L["Problem.Functional.Conflict"]" NotFound="@L["Problem.Functional.NotFound"]"
                      Technical="@L["Problem.Technical.Text"]" CanReload="@(Entry!.Id is not null)" OnReload="ReloadAsync" OnShowChanges="ShowChangesAsync"
                      OnRetry="SaveAsync" />;

    private RenderFragment? Dates => Entry is { CreatedAt: { } created, ModifiedAt: { } modified }
        ? @<text>@L["Dates.Created"] <LocalDateTime Value="created" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>
        : null;

    // The data of the series, in the order of the form, compared on what is entered against what was read
    // (visuel/saisie-album/contenu.md, données modifiées): for their mark, « Voir mes changements » and the entry left behind
    // at a reload.
    private EntryTracker<SeriesEntry> Tracker => _tracker ??= new(() => ReadEntry, () => Entry,
    [
        new("title", L["Title"], e => e.Title, e => e.Title, (from, to) => to.Title = from.Title),
        new("sortKey", L["Changes.SortKey"], e => e.ManualSortKey, e => e.ManualSortKey ?? L["Changes.SortKey.Auto"],
            (from, to) => to.ManualSortKey = from.ManualSortKey),
        new("status", L["Status"], e => e.Status?.ToString(), e => Named(e.Status), (from, to) => to.Status = from.Status),
        new("volumes", L["Volumes"], e => e.TheoreticalVolumeCount?.ToString(CultureInfo.InvariantCulture),
            e => e.TheoreticalVolumeCount?.ToString(CultureInfo.CurrentCulture), (from, to) => to.TheoreticalVolumeCount = from.TheoreticalVolumeCount),
        new("complete", L["Complete"], e => Checked(e.IsComplete), e => Checked(e.IsComplete), (from, to) => to.IsComplete = from.IsComplete),
        new("excludeFromMissingVolumes", L["ExcludeFromMissingVolumes"], e => Checked(e.ExcludeFromMissingVolumes),
            e => Checked(e.ExcludeFromMissingVolumes), (from, to) => to.ExcludeFromMissingVolumes = from.ExcludeFromMissingVolumes),
        new("excludeFromReleaseEstimates", L["ExcludeFromReleaseEstimates"], e => Checked(e.ExcludeFromReleaseEstimates),
            e => Checked(e.ExcludeFromReleaseEstimates), (from, to) => to.ExcludeFromReleaseEstimates = from.ExcludeFromReleaseEstimates),
        .. CitedRecords.AuthorData<SeriesEntry>(e => e.Cited, Values.Of),
        new("publisher", L["Publisher"], e => e.Publisher?.Id.ToString(), e => e.Publisher?.Label, (from, to) =>
            to.NewPublishers.AddRange(from.NewPublishers.Where(p => p.Key == from.Publisher?.Id && to.NewPublishers.All(o => o.Key != p.Key)))),
        new("collection", L["Collection"], e => e.PublisherCollection?.Id.ToString(), e => e.PublisherCollection?.Label, (from, to) =>
        {
            to.PublisherCollection = from.PublisherCollection;
            to.NewPublisherCollections.AddRange(from.NewPublisherCollections.Where(c =>
                c.Key == from.PublisherCollection?.Id && to.NewPublisherCollections.All(o => o.Key != c.Key)));
        }),
        .. CitedRecords.ClassificationData<SeriesEntry>(e => e.Cited, L["Genres"], L["Universes"]),
        new("summary", L["Summary"], e => e.Summary, e => e.Summary, (from, to) => to.Summary = from.Summary),
        new("notes", L["Notes"], e => e.PersonalNotes, e => e.PersonalNotes, (from, to) => to.PersonalNotes = from.PersonalNotes),
        Template("category", L["Category"], e => e.Category, (e, v) => e.Category = v),
        Template("condition", L["Condition"], e => e.Condition, (e, v) => e.Condition = v),
        Template("binding", L["Binding"], e => e.Binding, (e, v) => e.Binding = v),
        Template("format", L["Format"], e => e.Format, (e, v) => e.Format = v),
        Template("orientation", L["Orientation"], e => e.Orientation, (e, v) => e.Orientation = v),
        Template("readingDirection", L["ReadingDirection"], e => e.ReadingDirection, (e, v) => e.ReadingDirection = v),
        new("color", L["Color"], e => e.IsColor?.ToString(),
            e => e.IsColor switch { true => L["Color.Color"].Value, false => L["Color.BlackAndWhite"].Value, null => null },
            (from, to) => to.IsColor = from.IsColor),
    ]);

    private EntryDatum<SeriesEntry> Template<TEnum>(string key, string label, Func<SeriesEntry, TEnum?> get, Action<SeriesEntry, TEnum?> set)
        where TEnum : struct, Enum =>
        new(key, label, e => get(e)?.ToString(), e => Named(get(e)), (from, to) => set(to, get(from)));

    // Nothing is modified on a new series, all of which is new, as its save bar says (« Nouvelle fiche »).
    private EntryDatumState? DatumState(string key) => Entry!.Id is null ? null : Tracker.State(key, this);

    // Taking the publisher chooses it again, as the user would: the collections offered are then its own.
    private EntryDatumState? PublisherState => DatumState("publisher") is { } state
        ? state with { Take = EventCallback.Factory.Create(this, TakePublisherAsync) }
        : null;

    private async Task TakePublisherAsync()
    {
        var publisher = Tracker.Entered!.Publisher;
        Tracker.Take("publisher");
        await ChoosePublisherAsync(publisher);
    }

    // Taking a collection takes its publisher first, when the entry left behind had another: a collection is one of the
    // collections of its publisher, and choosing the publisher again removes the collection, which is then put back. A collection
    // emptied is that of no publisher: the publisher reloaded stays.
    private EntryDatumState? CollectionState => DatumState("collection") is { } state
        ? state with { Take = EventCallback.Factory.Create(this, TakeCollectionAsync) }
        : null;

    private async Task TakeCollectionAsync()
    {
        var entered = Tracker.Entered!;
        if (entered.PublisherCollection is not null && entered.Publisher?.Id != Entry!.Publisher?.Id)
            await TakePublisherAsync();
        Tracker.Take("collection");
    }
    private CitedRecords? ReadCited => Entry!.Id is null ? null : ReadEntry!.Cited;
    private string? Named<TEnum>(TEnum? value) where TEnum : struct, Enum => value is { } named ? Values.Of(named) : null;

    private string Checked(bool value) => value ? L["Changes.Checked"] : L["Changes.Unchecked"];
}
