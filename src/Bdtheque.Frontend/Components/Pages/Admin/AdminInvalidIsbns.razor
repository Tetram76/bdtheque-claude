@attribute [Route(AppPaths.AdminInvalidIsbns)]
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<AdminInvalidIsbns> L
@inject ApiClient Api
@inject RecordLabels Labels
@inject ValueLabels Values
@inject RecordSearch Search
@inject DisplayFormatter Format
@inject IsbnFormatter Isbns
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The editions whose ISBN has an inconsistent check digit (visuel/listes/liste-par-liste.md,
   fonctionnel/regles-metier/validation-de-l-isbn.md), from the block « À vérifier » of the home page of the administration:
   owned or targeted by a purchase intent, the errors to correct by default, the errors accepted on demand, then each telling
   its state. Its search, navigation and filters are those of the list of the editions, carried by its address
   (Lists/InvalidIsbnListQuery.cs). Nothing is created here; each row corrects its ISBN, or accepts its error, at once, by a
   form of its own under the version of its album, and leads to the entry form of its edition. *@
<PageTitle>@L["Title"]</PageTitle>
<AudienceScreen Function="AudienceFunctions.AdminInvalidIsbns" />

<ListLayout Title="@L["ListTitle"]" Set="RecordSet.Checks" Problem="_problem" Loaded="@(_list is not null)">
    <Heading>
        <ListHeading Title="@L["Title"]" TotalCount="_checks?.InvalidIsbnCount" Note="@L["Note"]" />
    </Heading>
    <ChildContent>
        @if (_actionProblem is not null)
        {
            <ErrorMessage Problem="_actionProblem" />
        }

        <ListSearch Action="@AppPaths.AdminInvalidIsbns" FieldId="invalid-isbns-search" TextName="@ListQuery.TextName" Text="@_query.Text"
                    SearchLabel="@L["Search.Label"]" Placeholder="@L["Search.Placeholder"]" ClearHref="@_query.WithoutSearchHref()" PanelId="invalid-isbns-filters"
                    FiltersName="@ListQuery.FiltersName" FiltersOpenValue="@ListQuery.FiltersOpenValue"
                    FiltersOpen="_query.FiltersOpen" FilterCount="_query.ActiveFilterCount" Panel="FiltersPanel" HiddenFilters="KeptFilters" />

        <ActiveFilters Filters="ActiveFilterTags()" ClearHref="@_query.WithoutFilters().Href()" />

        <InitialNavigation Current="@_query.Entry" EntryHref="@(entry => (_query with { Entry = entry, Page = 1 }).Href())" />

        <ListSummary Count="@CountText()" Entry="@_query.Entry" Narrowed="@_query.IsNarrowed"
                     WholeCount="@(_query.ShownState == InvalidIsbnState.ToCorrect ? _checks?.InvalidIsbnCount : null)" Order="@L["Order"]" />

        @if (_list!.Editions.Items.Count == 0)
        {
            switch (_query.EmptyReason)
            {
                case EmptyListReason.Search:
                    <EmptyList Message="@L["Empty.Text", _query.Text!]" Hint="@L["Empty.Hint"]">
                        <Actions>
                            <Button Href="@_query.WithoutSearchHref()" Label="@L["Empty.Clear"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case EmptyListReason.Filters:
                    <EmptyList Message="@L["Empty.Criteria"]">
                        <Actions>
                            <Button Href="@_query.WithoutFilters().Href()" Label="@L["Empty.ClearFilters"]" />
                        </Actions>
                    </EmptyList>
                    break;
                case EmptyListReason.Entry:
                    <EmptyList Message="@L["Empty.Entry"]">
                        <Actions>
                            <Button Href="@AppPaths.AdminInvalidIsbns" Label="@L["Empty.All"]" />
                        </Actions>
                    </EmptyList>
                    break;
                default:
                    <EmptyList Message="@L["Empty.None"]" />
                    break;
            }
        }
        else
        {
            var states = _query.ShownState == InvalidIsbnState.All;
            <div class="isbn-rows" role="table" aria-label="@L["Title"]" data-states="@(states ? "true" : null)">
                <div class="isbn-row isbn-row-head" role="row">
                    <span class="isbn-cover" role="columnheader"><span class="visually-hidden">@L["Column.Cover"]</span></span>
                    <span class="isbn-main" role="columnheader">@L["Column.Edition"]</span>
                    @if (states)
                    {
                        <span class="isbn-state" role="columnheader">@L["Column.State"]</span>
                    }
                    <span class="isbn-corrected" role="columnheader">@L["Column.Corrected"]</span>
                    <span class="isbn-acquisition" role="columnheader">@L["Column.Acquisition"]</span>
                    <span class="isbn-modified" role="columnheader">@L["Column.Modified"]</span>
                    <span class="isbn-actions" role="columnheader"><span class="visually-hidden">@L["Column.Actions"]</span></span>
                </div>
                @foreach (var row in _list.Editions.Items)
                {
                    var label = Labels.Edition(row.Edition);
                    var edit = L[row.IsOwned ? "Edit.Edition" : "Edit.Intent"].Value;
                    <div class="isbn-row" role="row" data-accepted="@(row.IsAccepted ? "true" : null)">
                        <span class="isbn-cover" role="cell"><Cover VisualId="row.Cover?.VisualId" /></span>
                        <span class="isbn-main" role="cell">
                            <RowEntry Detail="@AlbumLabel(row.Album)"><LabelText Text="@label" /></RowEntry>
                        </span>
                        <span class="isbn-meta">
                            @if (states)
                            {
                                <span class="isbn-state" role="cell">
                                    @if (row.IsAccepted)
                                    {
                                        <Tag Text="@L["State.Accepted"]" Variant="TagVariant.Dashed" />
                                    }
                                    else
                                    {
                                        <span class="isbn-to-correct">@L["State.ToCorrect"]</span>
                                    }
                                </span>
                            }
                            <span class="isbn-corrected" role="cell">
                                @if (row.CorrectedIsbn is { } corrected)
                                {
                                    <span class="isbn-caption">@($"{L["Column.Corrected"]} ")</span>
                                    <span class="isbn-value">@Isbns.Format(corrected)</span>
                                }
                                else
                                {
                                    <NotSet Brief="true" Mention="@L["Corrected.None"]" />
                                }
                            </span>
                            <span class="isbn-acquisition" role="cell">
                                @if (row.IsOwned)
                                {
                                    @AcquisitionText(row)
                                }
                                else
                                {
                                    <Tag Text="@L["Intent"]" Variant="TagVariant.Dashed" Icon="IconName.PurchaseIntent" />
                                }
                            </span>
                        </span>
                        <span class="isbn-modified" role="cell"><LocalDateTime Value="row.ModifiedAt" DateOnly="true" /></span>
                        <span class="isbn-actions" role="cell">
                            @if (row.CorrectedIsbn is not null)
                            {
                                @* Written at once, nothing being entered: the ISBN supposed put in place of the ISBN entered. *@
                                <form method="post" @formname="@FormName(Correction, row)" @onsubmit="() => ActAsync(row, Correction)">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="@VersionName" value="@row.AlbumVersion" />
                                    <Button Type="submit" Icon="IconName.Swap" Label="@L["Correct"]" IconOnlyOnSmartphone="true"
                                            aria-label="@L["Correct.Label", label]" />
                                </form>
                            }
                            else
                            {
                                <Button Href="@AppPaths.AdminEditEdition(row.Album.Id, row.Edition.Id)" Icon="IconName.Edit" Label="@edit"
                                        IconOnlyOnSmartphone="true" aria-label="@($"{edit} : {label}")" />
                            }
                            <ActionsMenu Id="@($"isbn-actions-{row.Edition.Id:N}")" Label="@L["More", label]">
                                @if (row.CorrectedIsbn is not null)
                                {
                                    <MenuItem Href="@AppPaths.AdminEditEdition(row.Album.Id, row.Edition.Id)" Icon="IconName.Edit" Label="@edit" />
                                }
                                @{ var acceptance = row.IsAccepted ? Revocation : Acceptance; }
                                <form method="post" @formname="@FormName(acceptance, row)" @onsubmit="() => ActAsync(row, acceptance)">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="@VersionName" value="@row.AlbumVersion" />
                                    <MenuItem Type="submit" Icon="IconName.Check" Label="@L[row.IsAccepted ? "Revoke" : "Accept"]" />
                                </form>
                                <MenuItem Href="@AppPaths.Album(row.Album.Id)" Icon="IconName.Exit" Label="@L["Menu.View"]" />
                            </ActionsMenu>
                        </span>
                    </div>
                }
            </div>

            <Pagination Number="_list.Editions.Number" Size="_list.Editions.Size" TotalCount="_list.Editions.TotalCount"
                        ItemsLabel="@L["Items"]" PageHref="@(page => (_query with { Page = page }).Href())" />
        }
    </ChildContent>
</ListLayout>

@code {
    // The actions of a row, each a form of its own, named by it and by its edition: a static page tells which one is sent
    // by its name.
    private const string Correction = "correction";
    private const string Acceptance = "acceptance";
    private const string Revocation = "revocation";

    private const string VersionName = "version";

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    /// <summary>The version of the album of the edition, as the row read it, which the action sends back.</summary>
    [SupplyParameterFromForm(Name = VersionName)]
    private uint? Version { get; set; }

    private InvalidIsbnListQuery _query = new();
    private AdminChecks? _checks;
    private ApplicationSettings? _settings;
    private InvalidIsbnList? _list;
    private ApiProblem? _problem;
    private ApiProblem? _actionProblem;

    private static string FormName(string action, InvalidIsbnListItem row) => $"isbn-{action}-{row.Edition.Id:N}";

    protected override async Task OnInitializedAsync()
    {
        _query = InvalidIsbnListQuery.Parse(new Uri(Navigation.Uri).Query);
        try
        {
            // The number of errors to correct, that of the home page of the administration.
            _checks = await Api.GetAsync<AdminChecks>("/admin/checks");
            _settings = await Api.GetAsync<ApplicationSettings>("/catalog/settings");
            _list = await Api.GetAsync<InvalidIsbnList>(_query.ApiPath());
            // A page beyond the last one (the page of its only edition once corrected, an old address) is no empty list: its
            // editions are on the pages before it, the last of which it leads to, with the same criteria.
            if (_list.Editions is { Items.Count: 0, TotalCount: > 0 } editions && _query.Page > 1)
            {
                Navigation.NavigateTo((_query with { Page = (editions.TotalCount + editions.Size - 1) / editions.Size }).Href());
                return;
            }
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _list = null;
            return;
        }

        if (HttpContext is { } context && HttpMethods.IsGet(context.Request.Method) && _query.Action is { } action)
            await Recorder.RecordActionAsync(action.Function, action.Parameters, context.RequestAborted);
    }

    private async Task ActAsync(InvalidIsbnListItem row, string action)
    {
        if (Version is not { } version)
            return;

        var edition = $"/admin/albums/{row.Album.Id}/editions/{row.Edition.Id}";
        try
        {
            switch (action)
            {
                case Correction:
                    await Api.PostAsync($"{edition}/isbn-correction", new IsbnActionRequest(version));
                    break;
                case Acceptance:
                    await Api.PostAsync($"{edition}/isbn-acceptance", new IsbnActionRequest(version));
                    break;
                default:
                    await Api.DeleteAsync($"{edition}/isbn-acceptance?version={version}");
                    break;
            }
        }
        catch (ApiProblemException exception)
        {
            // Refused (the edition corrected or modified in the meantime, an ISBN no check character corrects): said above the
            // list, which presents the editions as they are now.
            _actionProblem = exception.Problem;
            return;
        }

        var function = action switch
        {
            Correction => AudienceFunctions.AdminInvalidIsbnCorrected,
            Acceptance => AudienceFunctions.AdminInvalidIsbnAccepted,
            _ => AudienceFunctions.AdminInvalidIsbnRevoked,
        };
        await Recorder.RecordActionAsync(function, $"edition={row.Edition.Id}", HttpContext?.RequestAborted ?? default);
        Navigation.NavigateTo(_query.Href());
    }

    private string AlbumLabel(AlbumSummary album) => Labels.Album(album, _settings!.AlbumLabelFormat);

    // « 6 éditions dont 1 acceptée », when the errors accepted are presented with those to correct.
    private string CountText()
    {
        var count = _list!.Editions.TotalCount;
        var editions = count switch
        {
            0 => L["Count.None"].Value,
            1 => L["Count.One"].Value,
            _ => L["Count.Other", Format.Number(count)].Value,
        };
        return _query.ShownState == InvalidIsbnState.All && _list.AcceptedCount > 0
            ? L[_list.AcceptedCount == 1 ? "Count.Accepted.One" : "Count.Accepted.Other", editions, Format.Number(_list.AcceptedCount)]
            : editions;
    }

    // « Achat, 2004 »: the mode of the acquisition, and its year when its date is known.
    private string AcquisitionText(InvalidIsbnListItem row)
    {
        var mode = Values.Of(row.AcquisitionMode!.Value);
        return row.AcquisitionYear is { } year ? L["Acquisition.WithYear", mode, year] : mode;
    }

    // The filters chosen, each with the list without it; a record that no longer exists is no filter of the list.
    private IReadOnlyList<ActiveFilters.ActiveFilter> ActiveFilterTags()
    {
        var filters = _list!.Filters;
        var tags = new List<ActiveFilters.ActiveFilter>();
        void Add(string name, string? value, InvalidIsbnListQuery without)
        {
            if (value is not null)
                tags.Add(new(L[$"Filter.{name}"].Value, value, (without with { Page = 1 }).Href()));
        }

        Add("State", _query.State is { } state ? L[$"State.Option.{state}"].Value : null, _query with { State = null });
        Add("Series", filters.Series?.Title, _query with { SeriesId = null });
        Add("Album", filters.Album is { } album ? AlbumLabel(album) : null, _query with { AlbumId = null });
        Add("Publisher", filters.Publisher?.Name, _query with { PublisherId = null });
        Add("PublisherCollection", filters.PublisherCollection?.Name, _query with { PublisherCollectionId = null });
        return tags;
    }

    // The fields of the filters: the state chosen in a list, each record chosen by typing its name, interactive.
    private RenderFragment FiltersPanel => @<ListFilters Note="@L["Filters.Note"]">
            <Field Id="filter-isbn-state" Label="@L["Filter.State"]" Context="control">
                <FilterSelect Id="@control.Id" Name="@InvalidIsbnListQuery.StateName" Selected="@(_query.State?.ToString() ?? "")" Options="@StateOptions" />
            </Field>
            @* An album belongs to a series, if any, a collection to its publisher: each pair linked. *@
            <LinkedFilters @rendermode="InteractiveServer"
                           ParentKind="RecordKind.Series" ParentId="filter-series" ParentName="@EditionListQuery.SeriesName" ParentLabel="@L["Filter.Series"]"
                           Parent="@Option(_list!.Filters.Series, s => new(s.Id, s.Title, null))"
                           ChildKind="RecordKind.Album" ChildId="filter-album" ChildName="@EditionListQuery.AlbumName" ChildLabel="@L["Filter.Album"]"
                           Child="@Option(_list!.Filters.Album, a => Search.AlbumOption(a, _settings!.AlbumLabelFormat))" Placeholder="@L["Filter.Any"]" />
            <LinkedFilters @rendermode="InteractiveServer"
                           ParentKind="RecordKind.Publisher" ParentId="filter-publisher" ParentName="@EditionListQuery.PublisherName"
                           ParentLabel="@L["Filter.Publisher"]" Parent="@Option(_list!.Filters.Publisher, p => new(p.Id, p.Name, null))"
                           ChildKind="RecordKind.PublisherCollection" ChildId="filter-collection" ChildName="@EditionListQuery.PublisherCollectionName"
                           ChildLabel="@L["Filter.PublisherCollection"]" Child="@Option(_list!.Filters.PublisherCollection, RecordSearch.CollectionOption)"
                           Placeholder="@L["Filter.Any"]" />
        </ListFilters>;

    private IReadOnlyList<FilterSelect.FilterOption> StateOptions =>
    [
        new("", L["State.Option.ToCorrect"]),
        new(nameof(InvalidIsbnState.Accepted), L["State.Option.Accepted"]),
        new(nameof(InvalidIsbnState.All), L["State.Option.All"]),
    ];

    private static RecordOption? Option<T>(T? item, Func<T, RecordOption> option) where T : class => item is null ? null : option(item);

    // The filters chosen, kept by the search while their panel is folded.
    private RenderFragment KeptFilters => @<QueryFields Parameters="@((_query with { Text = null, Page = 1 }).Parameters())" />;
}
