@attribute [Route(AppPaths.AdminNewAlbum)]
@attribute [Route("/admin/albums/{Id:guid}")]
@rendermode InteractiveServer
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Entries
@inject IStringLocalizer<AdminAlbumForm> L
@inject IStringLocalizer<FieldMessages> FieldTexts
@inject IStringLocalizer<RuleMessages> RuleTexts
@inject ApiClient Api
@inject RecordLabels Labels
@inject ValueLabels Values
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The entry form of an album (visuel/saisie-album/contenu.md), model of the other entry forms: interactive, its label and
   the sort key of its title follow the typing, and the records it references are chosen by typing their name. It applies no
   rule of the album, which the domain alone holds (choix-implementation/ecritures/erreurs-metier-fonctionnelles-et-techniques.md):
   the error of its saving says what to correct, and points to the field concerned. Its styles read the contracts of the base
   theme only (visuel/saisie-album/declinaison-par-theme.md). *@
<PageTitle>@PageTitle</PageTitle>
<AudienceScreen Function="@(Id is null ? AudienceFunctions.AdminNewAlbum : AudienceFunctions.AdminAlbum)"
                Record="@(Id is { } id ? new PresentedRecord(RecordType.Album, id) : null)" />

@if (Entry is null)
{
    @if (_loadProblem is not null)
    {
        <Breadcrumb Items="@([new(L["Administration"], AppPaths.AdminHome), new(L["Albums"], AppPaths.AdminAlbums), new(L["Breadcrumb.Unknown"])])" />
        <ErrorMessage Problem="_loadProblem" />
    }
}
else
{
    <EntryForm @ref="_form" Breadcrumb="@([new(L["Administration"], AppPaths.AdminHome), new(L["Albums"], AppPaths.AdminAlbums), new(Entry.Id is null ? L["New"] : Label)])"
               Title="@(Entry.Id is null ? L["New"] : L["Edit"])" Subject="@Label" State="State" Saving="_saving"
               SaveLabel="@(Entry.Id is null ? L["Create"] : L["Save"])" CancelHref="@AppPaths.AdminAlbums" OnSave="SaveAsync"
               Problem="@SaveProblem" Dates="@Dates" Status="@Status">
        <Block Title="@L["Block.Album"]" Kicker="@L["Kicker.Album"]">
            <div class="album-fields">
                <Field Id="album-series" Label="@L["Series"]" Help="@(Entry.Series is null ? L["Series.Help.None"] : L["Series.Help"])" Context="control">
                    <RecordPicker Id="@control.Id" Kind="RecordKind.Series" Value="Entry.Series" ValueChanged="ChooseSeriesAsync"
                                  Placeholder="@L["Series.Placeholder"]" aria-describedby="@control.DescribedBy" />
                </Field>
                <Field Id="album-title" Label="@L["Title"]" Note="@(Entry.Series is null ? L["Title.Note.Required"] : L["Title.Note.Optional"])"
                       Error="@Errors.For("/title")" Context="control">
                    <input id="@control.Id" type="text" placeholder="@(Entry.Series is null ? L["Title.Placeholder"] : L["Title.Placeholder.Series"])"
                           aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid" @bind="Entry.Title" @bind:event="oninput" />
                </Field>
                <TitleSortKeyField Id="album-sort-key" Title="@Entry.Title" StoredKey="@Entry.StoredSortKey" @bind-ManualKey="Entry.ManualSortKey"
                                   UntitledPlaceholder="@(Entry.Series is null ? L["SortKey.Placeholder"] : L["SortKey.Placeholder.Series"])"
                                   UntitledHelp="@(Entry.Series is null ? L["SortKey.Help.None"] : L["SortKey.Help.Series"])" Error="@Errors.For("/manualSortKey")" />
            </div>
        </Block>

        <div class="album-pair">
            <Block Title="@L["Block.Volume"]" Kicker="@L["Kicker.Volume"]">
                <div class="album-volume">
                    <Field Id="album-volume" Label="@(Entry.IsOmnibus ? L["Volume.Omnibus"] : L["Volume"])" Characters="4" Error="@Errors.For("/volumeNumber")" Context="control">
                        <input id="@control.Id" type="text" inputmode="numeric" maxlength="4" aria-describedby="@control.DescribedBy"
                               aria-invalid="@control.Invalid" @bind="Entry.VolumeNumber" />
                    </Field>
                    @* Next to the volumes covered it shows (visuel/saisie-album/contenu.md). *@
                    <div class="album-flag">
                        <Choice Label="@L["Type.Omnibus"]"><input type="checkbox" @bind="Entry.IsOmnibus" /></Choice>
                    </div>
                    @if (Entry.IsOmnibus)
                    {
                        <fieldset class="album-range" aria-describedby="album-range-help">
                            <legend>@L["Range"]</legend>
                            <div class="album-range-fields">
                                <label class="visually-hidden" for="album-range-start">@L["Range.Start"]</label>
                                <input id="album-range-start" type="text" inputmode="numeric" maxlength="4" aria-invalid="@RangeInvalid"
                                       @bind="Entry.StartVolumeNumber" />
                                <span aria-hidden="true">@L["Range.To"]</span>
                                <label class="visually-hidden" for="album-range-end">@L["Range.End"]</label>
                                <input id="album-range-end" type="text" inputmode="numeric" maxlength="4" aria-invalid="@RangeInvalid"
                                       @bind="Entry.EndVolumeNumber" />
                            </div>
                            @if (RangeError is { } rangeError)
                            {
                                <p class="album-field-error"><Icon Name="IconName.Alert" />@rangeError</p>
                            }
                            <p id="album-range-help" class="album-help">@L["Range.Help"]</p>
                        </fieldset>
                    }
                    <div class="album-flag">
                        <Choice Label="@L["Type.SpecialIssue"]"><input type="checkbox" @bind="Entry.IsSpecialIssue" /></Choice>
                    </div>
                </div>
            </Block>
            <Block Title="@L["Block.Publication"]" Kicker="@L["Kicker.Publication"]">
                <PartialDateInput Id="album-publication" Legend="@L["Publication"]" @bind-Year="Entry.FirstPublicationYear"
                                  @bind-Month="Entry.FirstPublicationMonth" Error="@Errors.For("/firstPublicationYear", "/firstPublicationMonth")" />
            </Block>
        </div>

        <Block Title="@L["Block.Authors"]" Kicker="@L["Kicker.Authors"]">
            <div class="album-fields">
                @if (_authorsCopiedFrom is { } series)
                {
                    <Notice Icon="IconName.Copy">@L["Authors.Copied", series]</Notice>
                }
                <RoleCredits Id="album" Records="Entry.Cited" Help="@L["Authors.Help"]" AuthorCreated="AudienceFunctions.AdminAlbumAuthorCreated"
                             OnChange="AuthorsChanged" />
            </div>
        </Block>

        <Block Title="@L["Block.Classification"]" Kicker="@L["Kicker.Classification"]">
            <div class="album-fields">
                <ClassificationTags Id="album" Records="Entry.Cited" Help="@L["Classification.Help"]" OnChange="StateHasChanged" InheritedLabel="@L["BySeries"]"
                                    InheritedGenres="Entry.SeriesGenres" InheritedUniverses="Entry.SeriesUniverses"
                                    GenreCreated="AudienceFunctions.AdminAlbumGenreCreated" UniverseCreated="AudienceFunctions.AdminAlbumUniverseCreated" />
            </div>
        </Block>

        <Block Title="@L["Block.Reading"]" Kicker="@L["Kicker.Reading"]">
            <div class="album-fields">
                <Field Id="album-summary" Label="@L["Summary"]" Context="control">
                    <textarea id="@control.Id" rows="4" placeholder="@L["Summary.Placeholder"]" @bind="Entry.Summary"></textarea>
                </Field>
                <Field Id="album-notes" Label="@L["Notes"]" Context="control">
                    <textarea id="@control.Id" rows="3" placeholder="@L["Notes.Placeholder"]" @bind="Entry.PersonalNotes"></textarea>
                </Field>
                <RatingInput Id="album-rating" Legend="@L["Rating"]" @bind-Value="Entry.Rating" />
            </div>
        </Block>
    </EntryForm>

    @if (_changesShown)
    {
        <ChangesDialog Id="album-changes" Subject="@Label" Changes="Changes()" OnClose="() => _changesShown = false" />
    }
}

@code {
    private ApiProblem? _loadProblem;
    private ApiProblem? _saveProblem;
    private EntryForm? _form;
    private bool _revealProblem;
    private int _seriesChoice;
    private Task _seriesChoiceInProgress = Task.CompletedTask;
    private bool _saving;
    private string? _savedFingerprint;
    private string? _authorsCopiedFrom;
    private bool _changesShown;

    /// <summary>The album to modify; none for a new album.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>For a new album, the text searched in its list, which found nothing: its title (AppPaths.NewWithSearched).</summary>
    [SupplyParameterFromQuery(Name = AppPaths.SearchedParameter)]
    public string? Searched { get; set; }

    /// <summary>The album as the form holds it, read once, by the prerendering.</summary>
    [PersistentState]
    public AlbumEntry? Entry { get; set; }

    /// <summary>The album as it was read or last saved: what the user changed since.</summary>
    [PersistentState]
    public AlbumEntry? ReadEntry { get; set; }

    /// <summary>The format of the labels of the albums, a setting of the application.</summary>
    [PersistentState]
    public AlbumLabelFormat Format { get; set; }

    private string Label => Labels.Record(new AlbumLabel(
        string.IsNullOrWhiteSpace(Entry!.Title) ? null : Entry.Title.Trim(), Entry.Series?.Label,
        Entry.IsOmnibus ? AlbumType.Omnibus : AlbumType.Regular, Entry.IsSpecialIssue, Entry.VolumeNumber,
        Entry.IsOmnibus ? Entry.StartVolumeNumber : null, Entry.IsOmnibus ? Entry.EndVolumeNumber : null), Format);

    private string PageTitle => Entry is null || Entry.Id is null ? L["New"] : L["PageTitle", Label];

    private SaveBarState State => Entry!.Id is null ? SaveBarState.New : SavedState;

    private SaveBarState SavedState => Entry!.Fingerprint() == _savedFingerprint ? SaveBarState.Unchanged : SaveBarState.Unsaved;

    // The volumes an omnibus covers, entered together.
    private string? RangeError => Errors.For("/startVolumeNumber", "/endVolumeNumber");

    private string? RangeInvalid => RangeError is null ? null : "true";

    protected override async Task OnInitializedAsync()
    {
        if (Entry is null)
        {
            try
            {
                Format = (await Api.GetAsync<ApplicationSettings>("/catalog/settings")).AlbumLabelFormat;
                Entry = Id is { } id ? await ReadAsync(id) : AlbumEntry.New(Searched);
                ReadEntry = Entry.Copy();
            }
            catch (ApiProblemException exception)
            {
                _loadProblem = exception.Problem;
                return;
            }
        }

        _savedFingerprint = ReadEntry!.Fingerprint();
    }

    private async Task<AlbumEntry> ReadAsync(Guid id)
    {
        var form = await Api.GetAsync<AlbumForm>($"/admin/albums/{id}");
        return AlbumEntry.Of(form, await SeriesAsync(form.Content.SeriesId));
    }

    private async Task<SeriesDetail?> SeriesAsync(Guid? seriesId) =>
        seriesId is { } id ? await Api.GetAsync<SeriesDetail>($"/catalog/series/{id}") : null;

    // What the album displays through its series, once chosen or saved: a series that can no longer be read shows nothing
    // through it, and fails neither the choice nor the saving, which tells what became of it.
    private async Task<SeriesDetail?> SeriesOrNoneAsync(Guid? seriesId)
    {
        try
        {
            return await SeriesAsync(seriesId);
        }
        catch (ApiProblemException)
        {
            return null;
        }
    }

    // The authors of the series are taken as soon as it is chosen, as the domain decides: by an album without authors, or by
    // a new album whose authors are still those of the series it received them from, which they replace, even when no series
    // was chosen in between (fonctionnel/regles-metier/initialisation-des-contributions-depuis-la-serie.md). The user sees them
    // before saving. A series that cannot be read gives none, and the saving tells what became of it.
    // Each choice is numbered, as the suggestions of the choice of a record (choix-implementation/socle/frontend.md): the circuit
    // handles the next choice while one awaits, and only the answers of the last one apply, to the authors it was asked about.
    // The choice in progress, which a saving waits for: it is part of the form saved.
    private Task ChooseSeriesAsync(RecordOption? series) => _seriesChoiceInProgress = ApplySeriesAsync(series);

    private async Task ApplySeriesAsync(RecordOption? series)
    {
        var choice = ++_seriesChoice;
        Entry!.Series = series;
        _authorsCopiedFrom = null;
        var shown = await SeriesOrNoneAsync(series?.Id);
        if (choice != _seriesChoice)
            return;
        Entry.ShowSeries(shown);
        if (series is null)
            return;
        try
        {
            var credits = Entry.ToContent().Contributions;
            var given = await Api.PostAsync<SeriesAlbumContributionsRequest, SeriesAlbumContributions>(
                $"/admin/series/{series.Id}/album-contributions",
                new SeriesAlbumContributionsRequest(Entry.Id is null, Entry.AuthorsSeriesId, credits));
            if (choice == _seriesChoice && given.Applied && Entry.ToContent().Contributions.SequenceEqual(credits))
            {
                Entry.Cited.CreditOnly(given.Contributions);
                Entry.AuthorsSeriesId = series.Id;
                if (given.Contributions.Count > 0)
                    _authorsCopiedFrom = series.Label;
            }
        }
        catch (ApiProblemException)
        {
            // Nothing taken from a series that cannot be read.
        }
    }

    // Authors changed are personalized: the notice of those taken from the series no longer applies
    // (fonctionnel/regles-metier/initialisation-des-contributions-depuis-la-serie.md).
    private void AuthorsChanged() => _authorsCopiedFrom = null;

    private async Task SaveAsync()
    {
        if (_saving)
            return;
        _saving = true;
        _saveProblem = null;
        // The form disabled, what it was still doing is finished before it is taken: a series chosen gives its authors first.
        await _seriesChoiceInProgress;
        _authorsCopiedFrom = null;
        var content = Entry!.ToContent();
        try
        {
            if (Entry.Id is { } id)
            {
                await Api.PutAsync<UpdateAlbumRequest, AlbumForm>($"/admin/albums/{id}", new UpdateAlbumRequest(content, Entry.Version));
                await Recorder.RecordActionAsync(AudienceFunctions.AdminAlbumSaved, $"album={id}");
            }
            else
            {
                var created = await Api.PostAsync<AlbumContent, AlbumForm>("/admin/albums", content);
                await Recorder.RecordActionAsync(AudienceFunctions.AdminAlbumCreated, $"album={created.Id}");
            }

            // A record saved, created or modified, leads back to the list (visuel/saisie-album/contenu.md, decision of the user).
            Navigation.NavigateTo(AppPaths.AdminAlbums);
        }
        catch (ApiProblemException exception)
        {
            _saveProblem = exception.Problem;
            _revealProblem = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // Once the error of a saving is rendered, what is to correct is brought into view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealProblem && _form is not null)
        {
            _revealProblem = false;
            await _form.RevealProblemAsync();
        }
    }

    private async Task ShowChangesAsync()
    {
        _changesShown = true;
        await Recorder.RecordActionAsync(AudienceFunctions.AdminAlbumChanges, $"album={Entry!.Id}");
    }

    // The record as it is now, the changes of the form left behind: a navigation that loads the page anew.
    private void Reload() => Navigation.NavigateTo(AppPaths.AdminEditAlbum(Entry!.Id!.Value), forceLoad: true);

    // What to correct in each field the error of the saving designates (visuel/saisie-album/contenu.md).
    private FieldErrors Errors => new(_saveProblem, FieldTexts, RuleTexts, Label);

    // The three categories told apart at first glance, each with what the user can do about it (visuel/saisie-album/contenu.md).
    private RenderFragment? SaveProblem => _saveProblem is not { } problem ? null
        : @<SaveError Problem="problem" Conflict="@L["Problem.Functional.Conflict"]" NotFound="@L["Problem.Functional.NotFound"]"
                      Technical="@L["Problem.Technical.Text"]" CanReload="@(Entry!.Id is not null)" OnReload="Reload" OnShowChanges="ShowChangesAsync"
                      OnRetry="SaveAsync" />;

    // An album not in the collection, at first glance; nothing for a new album, not saved yet.
    private RenderFragment? Status => Entry!.CollectionState is { } state ? @<CollectionStatus State="state" /> : null;

    private RenderFragment? Dates => Entry is { CreatedAt: { } created, ModifiedAt: { } modified }
        ? @<text>@L["Dates.Created"] <LocalDateTime Value="created" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>
        : null;

    // Each field the user changed since the album was read, with what they entered, to enter it again once the album is reloaded:
    // block by block of the form.
    private List<EntryChange> Changes() =>
        [.. AlbumChanges(ReadEntry!, Entry!), .. CreditAndClassificationChanges(ReadEntry!.Cited, Entry!.Cited), .. ReadingChanges(ReadEntry!, Entry!)];

    private IEnumerable<EntryChange> AlbumChanges(AlbumEntry read, AlbumEntry entry)
    {
        if (read.Series?.Id != entry.Series?.Id)
            yield return new(L["Series"], entry.Series?.Label);
        if (read.Title != entry.Title)
            yield return new(L["Title"], entry.Title);
        if (read.ManualSortKey != entry.ManualSortKey)
            yield return new(L["Changes.SortKey"], entry.ManualSortKey ?? L["Changes.SortKey.Auto"]);
        if ((read.IsOmnibus, read.IsSpecialIssue) != (entry.IsOmnibus, entry.IsSpecialIssue))
            yield return new(L["Type"], TypeText(entry));
        if (read.VolumeNumber != entry.VolumeNumber)
            yield return new(L["Volume"], entry.VolumeNumber?.ToString(CultureInfo.CurrentCulture));
        if (entry.IsOmnibus && (read.StartVolumeNumber, read.EndVolumeNumber) != (entry.StartVolumeNumber, entry.EndVolumeNumber))
            yield return new(L["Range"], L["Changes.Range", Bound(entry.StartVolumeNumber), Bound(entry.EndVolumeNumber)]);
        if ((read.FirstPublicationYear, read.FirstPublicationMonth) != (entry.FirstPublicationYear, entry.FirstPublicationMonth))
            yield return new(L["Publication"], PublicationText(entry));
    }

    private IEnumerable<EntryChange> CreditAndClassificationChanges(CitedRecords read, CitedRecords cited)
    {
        foreach (var role in cited.RolesChangedSince(read))
            yield return new(Values.Of(role), EntryChange.Names(cited.AuthorsOf(role)));
        if (cited.GenresChangedSince(read))
            yield return new(L["Genres"], EntryChange.Names(cited.Genres));
        if (cited.UniversesChangedSince(read))
            yield return new(L["Universes"], EntryChange.Names(cited.Universes));
    }

    private IEnumerable<EntryChange> ReadingChanges(AlbumEntry read, AlbumEntry entry)
    {
        if (read.Summary != entry.Summary)
            yield return new(L["Summary"], entry.Summary);
        if (read.PersonalNotes != entry.PersonalNotes)
            yield return new(L["Notes"], entry.PersonalNotes);
        if (read.Rating != entry.Rating)
            yield return new(L["Rating"], entry.Rating is { } rating ? Values.Of(rating) : L["Rating.None"]);
    }

    // A bound of the range, « — » when empty, inside the text of the range.
    private string Bound(int? volume) => volume?.ToString(CultureInfo.CurrentCulture) ?? L["Changes.Empty"];

    private string TypeText(AlbumEntry entry) =>
        string.Join(", ", new[] { entry.IsOmnibus ? L["Type.Omnibus"].Value : null, entry.IsSpecialIssue ? L["Type.SpecialIssue"].Value : null }
            .OfType<string>().DefaultIfEmpty(L["Type.Regular"]));

    private static string PublicationText(AlbumEntry entry) => string.Join(' ', new[]
    {
        entry.FirstPublicationMonth is { } month ? CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month) : null,
        entry.FirstPublicationYear?.ToString(CultureInfo.InvariantCulture),
    }.OfType<string>());
}
