@attribute [Route(AppPaths.AdminNewAlbumEditionRoute)]
@attribute [Route(AppPaths.AdminNewPurchaseIntentRoute)]
@attribute [Route(AppPaths.AdminEditEditionRoute)]
@rendermode InteractiveServer
@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@using Bdtheque.Frontend.Entries
@inject IStringLocalizer<AdminEditionForm> L
@inject IStringLocalizer<FieldMessages> FieldTexts
@inject IStringLocalizer<RuleMessages> RuleTexts
@inject ApiClient Api
@inject ValueLabels Values
@inject RecordLabels Labels
@inject DisplayFormatter Format
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The entry form of an edition, and of an edition targeted by a purchase intent (visuel/saisie-edition/contenu.md), on the
   model of the entry form of an album, whose frame and errors it shares: interactive, its label follows the typing, its
   publisher is chosen by typing its name, its collection in the list of those of the publisher, and its ISBN is checked as it
   is entered. An edition targeted by an intent is entered with the minimum of fields, without copy nor value
   (fonctionnel/regles-metier/intention-d-achat.md#réalisation-dune-intention). It applies no rule of the edition, which the
   domain alone holds (choix-implementation/ecritures/erreurs-metier-fonctionnelles-et-techniques.md): the error of its saving
   says what to correct, and points to the field concerned. Neither deletion, nor confirmation of a purchase, nor removal of an
   intent: those are the page of the editions of the album's. Its styles read the contracts of the base theme only
   (visuel/saisie-edition/declinaison-par-theme.md). *@
<PageTitle>@PageTitle</PageTitle>
<AudienceScreen Function="ScreenFunction" Record="ScreenRecord" />

@if (Entry is null)
{
    @if (_loadProblem is not null)
    {
        <Breadcrumb Items="@([new(L["Administration"], AppPaths.AdminHome), new(L["Albums"], AppPaths.AdminAlbums), new(L["Breadcrumb.Unknown"])])" />
        <ErrorMessage Problem="_loadProblem" />
    }
}
else
{
    <EntryForm @ref="_form" Breadcrumb="Breadcrumb" Title="@Title" Subject="@Subject" State="State" Saving="_saving"
               SaveLabel="@SaveLabel" CancelHref="@AppPaths.AdminAlbumEditions(Entry.AlbumId)" OnSave="SaveAsync" Problem="@SaveProblem"
               Dates="@Dates">
        <Status>
            <p class="edition-album">@L["OfTheAlbum"] <a href="@AppPaths.AdminEditAlbum(Entry.AlbumId)">@AlbumLabel</a></p>
        </Status>
        <ChildContent>
            @if (Entry.Id is null)
            {
                <div class="edition-preset">
                    <Notice Icon="IconName.Copy">@PresetNotice</Notice>
                </div>
            }

            <Block Title="@L["Block.Edition"]" Kicker="@L["Kicker.Edition"]">
                <div class="edition-fields">
                    <div class="edition-publisher">
                        <Field Id="edition-publisher" Label="@L["Publisher"]" Note="@L["Required"]" Error="@Errors.For("/publisherId")" Context="control">
                            <RecordPicker Id="@control.Id" Kind="RecordKind.Publisher" Value="Entry.Publisher" ValueChanged="ChoosePublisherAsync"
                                          Placeholder="@L["Publisher.Placeholder"]" aria-describedby="@control.DescribedBy"
                                          aria-invalid="@control.Invalid" />
                        </Field>
                        @* One of the collections of the publisher, in the list of them all: unavailable until one is chosen, and
                           removed when it changes (choix-implementation/socle/frontend.md, Fiches de saisie). *@
                        <Field Id="edition-collection" Label="@L["Collection"]" Error="@Errors.For("/publisherCollectionId")"
                               Help="@(CollectionsUnread ? L["Collection.Unread"].Value : L["Collection.Help"].Value)" Context="control">
                            <select id="@control.Id" class="edition-collection" disabled="@(Entry.Publisher is null)"
                                    aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                                    value="@(Entry.PublisherCollection?.Id.ToString() ?? "")" @onchange="ChooseCollection">
                                <option value="">@(Entry.Publisher is null ? L["Collection.NoPublisher"] : L["None"])</option>
                                @foreach (var collection in PublisherCollections ?? [])
                                {
                                    <option value="@collection.Id">@collection.Label</option>
                                }
                            </select>
                        </Field>
                    </div>
                    <div class="edition-row">
                        <Field Id="edition-year" Label="@L["Year"]" Characters="4" Error="@Errors.For("/publicationYear")" Context="control">
                            <input id="@control.Id" type="text" inputmode="numeric" maxlength="4" placeholder="@L["Year.Placeholder"]"
                                   aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid" @bind="Entry.PublicationYear" />
                        </Field>
                        <IsbnField Id="edition-isbn" @bind-Value="Entry.Isbn" ReadCheck="Entry.IsbnChecksumValid" Error="@Errors.For("/isbn")" />
                        @EnumList("edition-category", L["Category"], () => Entry.Category, value => Entry.Category = value)
                    </div>
                </div>
            </Block>

            <Block Title="@L["Block.Making"]" Kicker="@L["Kicker.Making"]">
                <div class="edition-fields">
                    <div class="edition-row">
                        @EnumList("edition-format", L["Format"], () => Entry.Format, value => Entry.Format = value)
                        @EnumList("edition-binding", L["Binding"], () => Entry.Binding, value => Entry.Binding = value)
                        @EnumList("edition-orientation", L["Orientation"], () => Entry.Orientation, value => Entry.Orientation = value)
                        @EnumList("edition-direction", L["ReadingDirection"], () => Entry.ReadingDirection, value => Entry.ReadingDirection = value)
                        <Field Id="edition-pages" Label="@L["Pages"]" Characters="4" Error="@Errors.For("/pageCount")" Context="control">
                            <input id="@control.Id" type="text" inputmode="numeric" maxlength="4" aria-describedby="@control.DescribedBy"
                                   aria-invalid="@control.Invalid" @bind="Entry.PageCount" />
                        </Field>
                        <div class="edition-flag">
                            <Choice Label="@L["Color"]"><input type="checkbox" @bind="Entry.IsColor" /></Choice>
                        </div>
                    </div>
                </div>
            </Block>

            @if (!Entry.IsPurchaseIntent)
            {
                <Block Title="@L["Block.Copy"]" Kicker="@L["Kicker.Copy"]">
                    <div class="edition-fields">
                        <div class="edition-row">
                            <Field Id="edition-mode" Label="@L["Mode"]" Note="@L["Required"]" Error="@Errors.For("/acquisitionMode")" Context="control">
                                <select id="@control.Id" class="edition-list" aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                                        value="@(Entry.AcquisitionMode?.ToString() ?? "")"
                                        @onchange="args => Entry.ChooseAcquisitionMode(Enum.TryParse<AcquisitionMode>(args.Value as string, out var mode) ? mode : null)">
                                    <option value="">@L["None"]</option>
                                    @foreach (var mode in Enum.GetValues<AcquisitionMode>())
                                    {
                                        <option value="@mode">@Values.Of(mode)</option>
                                    }
                                </select>
                            </Field>
                            <Field Id="edition-date" Label="@DateLabel" Error="@Errors.For("/acquisitionDate")" Context="control">
                                <input id="@control.Id" type="date" class="edition-date" aria-describedby="@control.DescribedBy"
                                       aria-invalid="@control.Invalid" @bind="Entry.AcquisitionDate" />
                            </Field>
                            @EnumList("edition-condition", L["Condition"], () => Entry.Condition, value => Entry.Condition = value)
                            <div class="edition-flag edition-flags">
                                <Choice Label="@L["SecondHand"]"><input type="checkbox" @bind="Entry.IsSecondHand" /></Choice>
                                <Choice Label="@L["Dedicated"]"><input type="checkbox" @bind="Entry.IsDedicated" /></Choice>
                            </div>
                            <Field Id="edition-reference" Label="@L["Reference"]" Characters="12" Error="@Errors.For("/personalReference")"
                                   Context="control">
                                <input id="@control.Id" type="text" placeholder="@L["Reference.Placeholder"]" aria-describedby="@control.DescribedBy"
                                       aria-invalid="@control.Invalid" @bind="Entry.PersonalReference" />
                            </Field>
                        </div>
                        <Field Id="edition-notes" Label="@L["Notes"]" Error="@Errors.For("/personalNotes")" Context="control">
                            <textarea id="@control.Id" rows="2" placeholder="@L["Notes.Placeholder"]" aria-describedby="@control.DescribedBy"
                                      aria-invalid="@control.Invalid" @bind="Entry.PersonalNotes"></textarea>
                        </Field>
                    </div>
                </Block>

                <Block Title="@L["Block.Value"]" Kicker="@L["Kicker.Value"]">
                    <div class="edition-row">
                        <AmountField Id="edition-price" Label="@AmountLabel" @bind-Amount="Entry.AcquisitionAmount" @bind-Currency="Entry.AcquisitionCurrency"
                                     DefaultCurrency="@EditionEntry.DefaultCurrency" Disabled="Entry.IsFree" Error="@Errors.For("/acquisitionAmount", "/acquisitionCurrency")"
                                     Help="@(IsPurchase ? L["Price.Help.Purchase"] : L["Price.Help.Other"])" />
                        <AmountField Id="edition-initial" Label="@L["InitialValue"]" @bind-Amount="Entry.InitialValueAmount"
                                     @bind-Currency="Entry.InitialValueCurrency" DefaultCurrency="@EditionEntry.DefaultCurrency" Disabled="Entry.IsFree"
                                     Error="@Errors.For("/initialValueAmount", "/initialValueCurrency")" Help="@L["InitialValue.Help"]" />
                        @* A free edition has no value: its amounts are emptied and disabled; a purchase is never free, the box
                           disabled by the mode « Achat » (fonctionnel/presentation/libelles-contextuels-sur-l-edition.md). *@
                        <div class="edition-flag edition-free">
                            <Choice Label="@L["Free"]">
                                <input id="edition-free" type="checkbox" checked="@Entry.IsFree" disabled="@IsPurchase" aria-describedby="edition-free-help"
                                       @onchange="args => Entry.SetFree(args.Value is true)" />
                            </Choice>
                            <p class="edition-help" id="edition-free-help">@FreeHelp</p>
                        </div>
                    </div>
                </Block>
            }

            <EditionVisualsEditor Id="edition-visuals" Visuals="Entry.Visuals" VisualsChanged="StateHasChanged" Limits="Limits!"
                                  SendingChanged="sending => _sendingVisuals = sending" Functions="VisualFunctions" />
        </ChildContent>
    </EntryForm>

    @if (_changesShown)
    {
        <ChangesDialog Id="edition-changes" Subject="@Subject" Changes="Changes()" OnClose="() => _changesShown = false" />
    }
}

@code {
    private ApiProblem? _loadProblem;
    private ApiProblem? _saveProblem;
    private EntryForm? _form;
    private bool _revealProblem;
    private bool _saving;
    // Files on their way to api: the visuals they add are not yet in the form, which is not saved before them.
    private bool _sendingVisuals;
    private string? _savedFingerprint;
    private bool _changesShown;
    private int _publisherChoice;

    /// <summary>The album of the edition, which addresses it.</summary>
    [Parameter]
    public Guid AlbumId { get; set; }

    /// <summary>The edition to modify; none for a new edition, owned, or targeted by a new purchase intent.</summary>
    [Parameter]
    public Guid? Id { get; set; }

    /// <summary>The edition as the form holds it, read once, by the prerendering.</summary>
    [PersistentState]
    public EditionEntry? Entry { get; set; }

    /// <summary>The edition as it was read: what the user changed since.</summary>
    [PersistentState]
    public EditionEntry? ReadEntry { get; set; }

    /// <summary>The format of the labels of the albums, from the settings (fonctionnel/presentation/libelle-d-un-album.md).</summary>
    [PersistentState]
    public AlbumLabelFormat AlbumFormat { get; set; }

    /// <summary>
    /// The collections of the publisher chosen, by name, which its collection is chosen among; none without publisher, and
    /// none either if they could not be read, which the field then says. Persisted with the form, so that collections not read
    /// by the prerendering stay so once interactive.
    /// </summary>
    [PersistentState]
    public List<RecordOption>? PublisherCollections { get; set; }

    /// <summary>What api accepts and keeps of the visuals added, which their block announces.</summary>
    [PersistentState]
    public VisualLimits? Limits { get; set; }

    // Whether the page creates a purchase intent on a new edition, which it tells by its address.
    private bool IsNewPurchaseIntent => Id is null && AppPaths.IsNewPurchaseIntent(new Uri(Navigation.Uri).AbsolutePath);

    private bool IsPurchaseIntent => Entry?.IsPurchaseIntent ?? IsNewPurchaseIntent;

    private bool IsPurchase => Entry!.AcquisitionMode == AcquisitionMode.Purchase;

    private bool CollectionsUnread => Entry!.Publisher is not null && PublisherCollections is null;

    private AudienceFunction ScreenFunction => (Id, IsPurchaseIntent) switch
    {
        (null, true) => AudienceFunctions.AdminNewPurchaseIntentForm,
        (null, false) => AudienceFunctions.AdminNewEditionForm,
        (_, true) => AudienceFunctions.AdminPurchaseIntentForm,
        _ => AudienceFunctions.AdminEditionForm,
    };

    // A new edition presents the album it is added to; an intent, the intent itself; an edition, the edition.
    private PresentedRecord ScreenRecord => (Id, Entry?.PurchaseIntentId) switch
    {
        (null, _) => new PresentedRecord(RecordType.Album, AlbumId),
        (_, { } intent) => new PresentedRecord(RecordType.PurchaseIntent, intent),
        ({ } id, _) => new PresentedRecord(RecordType.Edition, id),
    };

    // The label of the edition as entered (fonctionnel/presentation/libelle-d-une-edition.md), from a publisher to choose.
    private string Subject => EditionLabel(withIsbn: true);

    private string AlbumLabel => Labels.Album(Entry!.Album, AlbumFormat);

    private string Title => (Entry!.Id, Entry.IsPurchaseIntent) switch
    {
        (null, true) => L["New.PurchaseIntent"],
        (null, false) => L["New.Edition"],
        (_, true) => L["Edit.PurchaseIntent"],
        _ => L["Edit.Edition"],
    };

    private string PageTitle => Entry switch
    {
        null => L["Breadcrumb.Unknown"],
        { Id: null } => Title,
        _ => L["PageTitle", Title, Subject],
    };

    private string SaveLabel => (Entry!.Id, Entry.IsPurchaseIntent) switch
    {
        (null, true) => L["Create.PurchaseIntent"],
        (null, false) => L["Create.Edition"],
        _ => L["Save"],
    };

    // The page of the editions of the album, to which the album of the breadcrumb leads, as every breadcrumb of the
    // administration leads back to a list (visuel/saisie-edition/contenu.md).
    private IReadOnlyList<BreadcrumbItem> Breadcrumb =>
    [
        new(L["Administration"], AppPaths.AdminHome),
        new(L["Albums"], AppPaths.AdminAlbums),
        new(AlbumLabel, AppPaths.AdminAlbumEditions(Entry!.AlbumId)),
        new(Entry.Id is null ? Title : EditionLabel(withIsbn: false)),
    ];

    private SaveBarState State => Entry!.Id switch
    {
        _ when _sendingVisuals => SaveBarState.Sending,
        null => SaveBarState.New,
        _ when Entry.Fingerprint() == _savedFingerprint => SaveBarState.Unchanged,
        _ => SaveBarState.Unsaved,
    };

    private string DateLabel => IsPurchase ? L["Date.Purchase"] : L["Date.Other"];

    private string AmountLabel => IsPurchase ? L["Price.Purchase"] : L["Price.Other"];

    private string FreeHelp => (IsPurchase, Entry!.IsFree) switch
    {
        (true, _) => L["Free.Help.Purchase"],
        (_, true) => L["Free.Help.Free"],
        _ => L["Free.Help"],
    };

    protected override async Task OnInitializedAsync()
    {
        if (Entry is null)
        {
            try
            {
                var format = (await Api.GetAsync<ApplicationSettings>("/catalog/settings")).AlbumLabelFormat;
                var entry = Id switch
                {
                    { } id => EditionEntry.Of(await Api.GetAsync<EditionForm>($"/admin/albums/{AlbumId}/editions/{id}")),
                    _ when IsNewPurchaseIntent => EditionEntry.NewPurchaseIntent(
                        await Api.GetAsync<NewPurchaseIntentForm>($"/admin/albums/{AlbumId}/purchase-intents/new")),
                    _ => EditionEntry.New(await Api.GetAsync<NewEditionForm>($"/admin/albums/{AlbumId}/editions/new")),
                };
                // Read after the edition: a write between both readings leaves the form the older version of the album, which its
                // saving sends, refused as a conflict rather than writing over what it did not read.
                if (entry.Id is { } edition)
                    entry.Visuals = [.. (await Api.GetAsync<EditionVisualsForm>($"/admin/albums/{AlbumId}/editions/{edition}/visuals")).Visuals.Select(VisualItem.Of)];
                var limits = await Api.GetAsync<VisualLimits>("/admin/visuals/limits");
                var collections = entry.Publisher is { } publisher ? await CollectionsOfAsync(publisher.Id) : null;

                // Published once all of it is read: the form is shown only whole, a reading that fails showing the error instead.
                AlbumFormat = format;
                Limits = limits;
                PublisherCollections = collections;
                ReadEntry = entry.Copy();
                Entry = entry;
            }
            catch (ApiProblemException exception)
            {
                _loadProblem = exception.Problem;
                return;
            }
        }

        _savedFingerprint = ReadEntry!.Fingerprint();
    }

    private string EditionLabel(bool withIsbn)
    {
        if (Entry!.Publisher is not { } publisher)
            return L["NoPublisher"];
        return Labels.Edition(new EditionSummary(
            Entry.Id ?? Guid.Empty, publisher.Id, publisher.Label, Entry.PublisherCollection?.Id, Entry.PublisherCollection?.Label,
            Entry.PublicationYear, withIsbn ? Entry.Isbn : null));
    }

    // A list of the values of an enumeration, « — » leaving the data empty, sized to its longest choice.
    private RenderFragment EnumList<TEnum>(string id, string label, Func<TEnum?> get, Action<TEnum?> set) where TEnum : struct, Enum =>
        @<Field Id="@id" Label="@label" Context="control">
            <select id="@control.Id" class="edition-list" value="@(get()?.ToString() ?? "")"
                    @onchange="args => set(Enum.TryParse<TEnum>(args.Value as string, out var value) ? value : null)">
                <option value="">@L["None"]</option>
                @foreach (var value in Enum.GetValues<TEnum>())
                {
                    <option value="@value">@Values.Of(value)</option>
                }
            </select>
        </Field>;

    // What the series pre-filled, which are only proposals (fonctionnel/regles-metier/initialisation-d-une-nouvelle-edition-
    // depuis-la-serie.md): the fields its template gives a value, those of a copy aside for an intent; or the values proposed to
    // any new edition, for an album without series.
    private string PresetNotice
    {
        get
        {
            if (Entry!.SeriesTemplate is not { } template)
                return L["Preset.Defaults"];
            string?[] fields =
            [
                template.PublisherId is null ? null : L["Preset.Publisher"].Value,
                template.PublisherCollectionId is null ? null : L["Preset.Collection"].Value,
                template.Category is null ? null : L["Preset.Category"].Value,
                template.Condition is null || Entry.IsPurchaseIntent ? null : L["Preset.Condition"].Value,
                template.Binding is null ? null : L["Preset.Binding"].Value,
                template.Orientation is null ? null : L["Preset.Orientation"].Value,
                template.ReadingDirection is null ? null : L["Preset.ReadingDirection"].Value,
                template.Format is null ? null : L["Preset.Format"].Value,
                template.IsColor is null ? null : L["Preset.Color"].Value,
            ];
            var named = fields.OfType<string>().ToList();
            var series = Entry.Album.SeriesTitle ?? "";
            return named.Count switch
            {
                0 => L["Preset.Nothing", series],
                1 => L["Preset.Series", series, named[0]],
                _ => L["Preset.Series", series, L["Preset.Fields", string.Join(", ", named[..^1]), named[^1]]],
            };
        }
    }

    // The collection is removed when the publisher changes, and is chosen among those of the new one. Each choice is numbered,
    // as the choice of a series on the form of an album: only the collections of the last publisher chosen are listed.
    private async Task ChoosePublisherAsync(RecordOption? publisher)
    {
        var choice = ++_publisherChoice;
        var changed = publisher?.Id != Entry!.Publisher?.Id;
        Entry.ChoosePublisher(publisher);
        if (!changed)
            return;
        // None while those of the new one are read.
        PublisherCollections = [];
        if (publisher is null)
            return;
        var collections = await CollectionsOfAsync(publisher.Id);
        if (choice == _publisherChoice)
            PublisherCollections = collections;
    }

    // The collections of a publisher, by name; null if they cannot be read.
    private async Task<List<RecordOption>?> CollectionsOfAsync(Guid publisherId)
    {
        try
        {
            var collections = await Api.GetAsync<List<PublisherCollectionForm>>($"/admin/publishers/{publisherId}/collections");
            return [.. collections.Select(c => new RecordOption(c.Id, c.Name, null))];
        }
        catch (ApiProblemException)
        {
            return null;
        }
    }

    private void ChooseCollection(ChangeEventArgs args) =>
        Entry!.PublisherCollection = Guid.TryParse(args.Value as string, out var id) ? PublisherCollections?.Find(c => c.Id == id) : null;

    private async Task SaveAsync()
    {
        if (_saving || _sendingVisuals)
            return;
        _saving = true;
        _saveProblem = null;
        var entry = Entry!;
        try
        {
            if (entry.Id is { } id)
            {
                await Api.PutAsync<UpdateEditionRequest, EditionForm>(
                    $"/admin/albums/{entry.AlbumId}/editions/{id}", new UpdateEditionRequest(entry.ToContent(), entry.AlbumVersion, entry.VisualEntries()));
                await (entry.PurchaseIntentId is { } intent
                    ? Recorder.RecordActionAsync(AudienceFunctions.AdminPurchaseIntentSaved, $"purchase-intent={intent}")
                    : Recorder.RecordActionAsync(AudienceFunctions.AdminEditionSaved, $"edition={id}"));
            }
            else if (entry.IsPurchaseIntent)
            {
                await Api.PostAsync<CreatePurchaseIntentRequest, PurchaseIntentsForm>(
                    $"/admin/albums/{entry.AlbumId}/purchase-intents",
                    new CreatePurchaseIntentRequest(entry.ToPurchaseIntentContent(), entry.AlbumVersion, entry.VisualEntries()));
                await Recorder.RecordActionAsync(AudienceFunctions.AdminPurchaseIntentCreated, $"album={entry.AlbumId}");
            }
            else
            {
                var created = await Api.PostAsync<CreateEditionRequest, EditionForm>(
                    $"/admin/albums/{entry.AlbumId}/editions", new CreateEditionRequest(entry.ToContent(), entry.AlbumVersion, entry.VisualEntries()));
                await Recorder.RecordActionAsync(AudienceFunctions.AdminEditionCreated, $"edition={created.Id}");
            }

            // A record saved, created or modified, leads back to its list (visuel/saisie-album/contenu.md, decision of the user):
            // for an edition, the page of the editions of its album, to which its breadcrumb leads.
            Navigation.NavigateTo(AppPaths.AdminAlbumEditions(entry.AlbumId));
        }
        catch (ApiProblemException exception)
        {
            _saveProblem = exception.Problem;
            _revealProblem = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // Once the error of a saving is rendered, what is to correct is brought into view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealProblem && _form is not null)
        {
            _revealProblem = false;
            await _form.RevealProblemAsync();
        }
    }

    private async Task ShowChangesAsync()
    {
        _changesShown = true;
        // A new edition or intent has no identifier yet: its album designates it.
        var entry = Entry!;
        await (entry switch
        {
            { IsPurchaseIntent: true, PurchaseIntentId: { } intent } =>
                Recorder.RecordActionAsync(AudienceFunctions.AdminPurchaseIntentChanges, $"purchase-intent={intent}"),
            { IsPurchaseIntent: true } => Recorder.RecordActionAsync(AudienceFunctions.AdminPurchaseIntentChanges, $"album={entry.AlbumId}"),
            { Id: { } edition } => Recorder.RecordActionAsync(AudienceFunctions.AdminEditionChanges, $"edition={edition}"),
            _ => Recorder.RecordActionAsync(AudienceFunctions.AdminEditionChanges, $"album={entry.AlbumId}"),
        });
    }


    private EditionVisualsEditor.VisualFunctions VisualFunctions => Entry!.IsPurchaseIntent
        ? new(AudienceFunctions.AdminPurchaseIntentVisualAdded, AudienceFunctions.AdminPurchaseIntentVisualsArranged,
            AudienceFunctions.AdminPurchaseIntentVisualTypeChanged, AudienceFunctions.AdminPurchaseIntentVisualDeletion,
            AudienceFunctions.AdminPurchaseIntentVisualDeleted)
        : new(AudienceFunctions.AdminEditionVisualAdded, AudienceFunctions.AdminEditionVisualsArranged,
            AudienceFunctions.AdminEditionVisualTypeChanged, AudienceFunctions.AdminEditionVisualDeletion,
            AudienceFunctions.AdminEditionVisualDeleted);

    // The record as it is now, the changes of the form left behind: a navigation that loads the page anew, the same page, which
    // reads anew the edition or, for a new one, the album and what the series pre-fills.
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    // What to correct in each field the error of the saving designates (visuel/saisie-album/contenu.md); an amount and its
    // currency, entered side by side, are a single field of the form.
    private FieldErrors Errors => new(_saveProblem, FieldTexts, RuleTexts, Subject);

    // The three categories told apart at first glance, each with what the user can do about it (visuel/saisie-edition/contenu.md).
    // A conflict can always be reloaded: a new edition or intent is written, as a modified one, under the version of its album,
    // which the form read and which only a reload reads anew.
    private RenderFragment? SaveProblem => _saveProblem is not { } problem ? null
        : @<SaveError Problem="problem" Conflict="@L["Problem.Functional.Conflict"]" NotFound="@L["Problem.Functional.NotFound"]"
                      Technical="@L["Problem.Technical.Text"]" CanReload="true" OnReload="Reload" OnShowChanges="ShowChangesAsync"
                      OnRetry="SaveAsync" />;

    // Just above the first block, as on the other entry forms (decision of the user, #209): those of the edition, or, for an
    // edition targeted by an intent, when the intent was set and when its edition was last modified.
    private RenderFragment? Dates => Entry switch
    {
        { PurchaseIntentCreatedAt: { } set, ModifiedAt: { } modified } =>
            @<text>@L["Dates.IntentSet"] <LocalDateTime Value="set" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>,
        { CreatedAt: { } created, ModifiedAt: { } modified, EnteredCollectionAt: { } entered } =>
            @<text>@L["Dates.Created"] <LocalDateTime Value="created" />@L["Dates.Entered"] <LocalDateTime Value="entered" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>,
        _ => null,
    };

    // Each field the user changed since the edition was read, with what they entered, to enter it again once the edition is
    // reloaded: block by block of the form.
    private List<EntryChange> Changes() => [.. EditionChanges(ReadEntry!, Entry!), .. CopyChanges(ReadEntry!, Entry!), .. VisualChanges(ReadEntry!, Entry!)];

    // Les visuels: their number, whichever were added, removed, ordered or retyped, to add again once the edition is reloaded.
    private IEnumerable<EntryChange> VisualChanges(EditionEntry read, EditionEntry entry)
    {
        if (!read.VisualEntries().SequenceEqual(entry.VisualEntries()))
            yield return new(L["Visuals"], entry.Visuals.Count switch
            {
                0 => L["Visuals.None"],
                1 => L["Visuals.One"],
                var count => L["Visuals.Other", count],
            });
    }

    // L'édition, Fabrication.
    private IEnumerable<EntryChange> EditionChanges(EditionEntry read, EditionEntry entry)
    {
        if (read.Publisher?.Id != entry.Publisher?.Id)
            yield return new(L["Publisher"], entry.Publisher?.Label);
        if (read.PublisherCollection?.Id != entry.PublisherCollection?.Id)
            yield return new(L["Collection"], entry.PublisherCollection?.Label);
        if (read.PublicationYear != entry.PublicationYear)
            yield return new(L["Year"], entry.PublicationYear?.ToString(CultureInfo.CurrentCulture));
        if (read.Isbn != entry.Isbn)
            yield return new(L["Isbn"], entry.Isbn);
        if (read.Category != entry.Category)
            yield return new(L["Category"], Named(entry.Category));
        if (read.Format != entry.Format)
            yield return new(L["Format"], Named(entry.Format));
        if (read.Binding != entry.Binding)
            yield return new(L["Binding"], Named(entry.Binding));
        if (read.Orientation != entry.Orientation)
            yield return new(L["Orientation"], Named(entry.Orientation));
        if (read.ReadingDirection != entry.ReadingDirection)
            yield return new(L["ReadingDirection"], Named(entry.ReadingDirection));
        if (read.PageCount != entry.PageCount)
            yield return new(L["Pages"], entry.PageCount?.ToString(CultureInfo.CurrentCulture));
        if (read.IsColor != entry.IsColor)
            yield return new(L["Color"], Checked(entry.IsColor));
    }

    // L'exemplaire, Valeur.
    private IEnumerable<EntryChange> CopyChanges(EditionEntry read, EditionEntry entry)
    {
        if (read.AcquisitionMode != entry.AcquisitionMode)
            yield return new(L["Mode"], Named(entry.AcquisitionMode));
        if (read.AcquisitionDate != entry.AcquisitionDate)
            yield return new(DateLabel, entry.AcquisitionDate is { } date ? Format.Date(date) : null);
        if (read.Condition != entry.Condition)
            yield return new(L["Condition"], Named(entry.Condition));
        if (read.IsSecondHand != entry.IsSecondHand)
            yield return new(L["SecondHand"], Checked(entry.IsSecondHand));
        if (read.IsDedicated != entry.IsDedicated)
            yield return new(L["Dedicated"], Checked(entry.IsDedicated));
        if (read.PersonalReference != entry.PersonalReference)
            yield return new(L["Reference"], entry.PersonalReference);
        if (read.PersonalNotes != entry.PersonalNotes)
            yield return new(L["Notes"], entry.PersonalNotes);
        if (read.AcquisitionAmount != entry.AcquisitionAmount || read.AcquisitionCurrency != entry.AcquisitionCurrency)
            yield return new(AmountLabel, Amount(entry.AcquisitionAmount, entry.AcquisitionCurrency));
        if (read.InitialValueAmount != entry.InitialValueAmount || read.InitialValueCurrency != entry.InitialValueCurrency)
            yield return new(L["InitialValue"], Amount(entry.InitialValueAmount, entry.InitialValueCurrency));
        if (read.IsFree != entry.IsFree)
            yield return new(L["Free"], Checked(entry.IsFree));
    }

    private string? Amount(decimal? amount, string? currency) =>
        amount is { } value ? Format.Amount(value, currency ?? EditionEntry.DefaultCurrency) : null;

    private string? Named<TEnum>(TEnum? value) where TEnum : struct, Enum => value is { } named ? Values.Of(named) : null;

    private string Checked(bool value) => value ? L["Changes.Checked"] : L["Changes.Unchecked"];
}
