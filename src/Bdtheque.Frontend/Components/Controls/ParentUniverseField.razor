@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Catalog
@using Bdtheque.Frontend.Entries
@inject ApiClient Api
@inject IStringLocalizer<ParentUniverseField> L

@* The parent of a universe, in the side panel of the universe (visuel/listes/saisie-selon-l-entite.md): chosen by typing its
   name, presented with its ancestors (« Univers Hugo Pratt › Corto Maltese »), or created on the spot by its name alone
   (« Créer l'univers « … » », choix-implementation/socle/frontend.md, création sur place), at the top of the hierarchy, created
   only by the saving of the panel. A child of the interactive panel, which holds the parent chosen and the one created on the
   spot, and receives each choice. A parent refused (a cycle, a name already taken) is presented in place, with its reason,
   until another one is chosen. Ancestors that cannot be read leave the parent named alone, the failure said under the field at
   its scale until another parent is chosen (choix-implementation/socle/frontend.md, erreur dans un contrôle). *@
<Field Id="@Id" Label="@L["Label"]" Error="@_error" Help="@(_error is null ? HelpText : null)" Failure="_failure" FailureText="@L["Failed"]"
       State="State" Context="control">
    <RecordPicker Id="@control.Id" Kind="RecordKind.Universe" Value="_value" ValueChanged="ChooseAsync" Placeholder="@L["Placeholder"]"
                  OnCreate="text => _creation = text" CreateLabel="@(text => L["Create", text].Value)" Pending="Pending"
                  aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid" />
</Field>

@if (_creation is { } typed)
{
    <UniverseCreationDialog Id="@($"{Id}-creation")" Name="@typed" OnCreated="CreatedAsync" OnCancel="() => _creation = null" />
}

@code {
    private RecordOption? _value;
    private string? _error;
    private ApiProblem? _failure;
    // The text typed, while the dialog of its creation is open.
    private string? _creation;
    private RecordOption? _valueReceived;
    private string? _errorReceived;

    /// <summary>The identifier of the field, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>The parent chosen, named with its ancestors; <c>null</c> at the top of the hierarchy.</summary>
    [Parameter]
    public RecordOption? Value { get; set; }

    /// <summary>The parent chosen by the user, then named with its ancestors once they are read.</summary>
    [Parameter]
    public EventCallback<RecordOption?> ValueChanged { get; set; }

    /// <summary>The parent created on the spot, chosen or not since: suggested again when its name is typed.</summary>
    [Parameter]
    public NewUniverse? NewParent { get; set; }

    /// <summary>The parent created on the spot by the user, which becomes the parent chosen.</summary>
    [Parameter]
    public EventCallback<NewUniverse> NewParentChanged { get; set; }

    /// <summary>Why the parent sent was refused.</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>What the panel tells of the parent (EntryTracker): its mark once modified, what was entered before a reload.</summary>
    [Parameter]
    public EntryDatumState? State { get; set; }

    private IReadOnlyList<RecordOption> Pending => NewParent is { } created ? [UniverseEntry.Option(created)] : [];

    // What the panel holds (the parent read, or taken back after a reload) replaces the choice in place; the same values sent
    // again leave it as it is.
    protected override void OnParametersSet()
    {
        if (Value != _valueReceived)
        {
            _valueReceived = Value;
            _value = Value;
        }
        if (Error != _errorReceived)
        {
            _errorReceived = Error;
            _error = Error;
        }
    }

    private string HelpText => _value is null ? L["Help.None"] : L["Help.Parent", _value.Label];

    // The parent chosen by its name, then presented with its ancestors once read; one created on the spot has none.
    private async Task ChooseAsync(RecordOption? option)
    {
        await ChangeAsync(option);
        _error = null;
        _failure = null;
        if (option is null || option.Id == NewParent?.Key)
            return;

        try
        {
            var parent = await Api.GetAsync<UniverseInHierarchy>($"/admin/universes/{option.Id}/hierarchy");
            // A choice made meanwhile wins over the reading of an earlier one.
            if (_value?.Id == option.Id)
                await ChangeAsync(UniverseEntry.Option(parent));
        }
        catch (ApiProblemException exception) when (_value?.Id == option.Id)
        {
            // Its ancestors unread (deleted meanwhile, the API unavailable), the parent keeps its name alone, and the failure
            // is said, the parent being presented otherwise than with its ancestors.
            _failure = exception.Problem;
        }
        catch (ApiProblemException)
        {
            // The reading for a parent chosen before no longer matters.
        }
    }

    // The parent created on the spot becomes the parent chosen; created only with the universe of the panel, when it is saved.
    private async Task CreatedAsync(NewUniverse parent)
    {
        _creation = null;
        _error = null;
        _failure = null;
        await NewParentChanged.InvokeAsync(parent);
        await ChangeAsync(UniverseEntry.Option(parent));
    }

    // The choice is the field's at once, the panel receiving it: its next rendering sends it back unchanged.
    private Task ChangeAsync(RecordOption? option)
    {
        _value = option;
        _valueReceived = option;
        return ValueChanged.InvokeAsync(option);
    }
}
