@using Bdtheque.Contracts.Admin
@inject IStringLocalizer<PublisherCreationDialog> L

@* The creation of a publisher on the spot, from the entry form of a series or of an edition that cites it
   (visuel/saisie-serie/contenu.md, visuel/saisie-edition/contenu.md): its name alone, in the common dialog of a record created
   on the spot by its name; its website and its collections are entered on its own form (modele-metier/editeur.md). *@
<NameCreationDialog Id="@Id" Title="@L["Title"]" Lead="@L["Lead"]" Label="@L["Name"]" CreateLabel="@L["Create"]" Text="@Text"
                    OnCreated="name => OnCreated.InvokeAsync(new NewPublisher(Guid.NewGuid(), name))" OnCancel="OnCancel" />

@code {
    /// <summary>The identifier of the dialog, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>The name typed in the choice of a publisher.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = null!;

    /// <summary>The publisher to create with the record that cites it, to choose it.</summary>
    [Parameter]
    public EventCallback<NewPublisher> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
