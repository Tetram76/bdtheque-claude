@* An item of an ActionsMenu: a link to another page, a button, which closes the menu as it acts, or the button that submits
   the form around it (e.g. a write done at once, without anything to enter); with a hint under its
   label when the choice it makes needs saying (e.g. « Toute édition de l'album fera l'affaire. »). *@
@if (Href is not null)
{
    @* A site outside the application opens beside it, so that the page it was opened from stays as it was. *@
    <a class="menu-item" href="@Href" data-variant="@VariantName" target="@(External ? "_blank" : null)"
       rel="@(External ? "noopener noreferrer" : null)">@Content</a>
}
else
{
    @* A submit button submits its form: the page it leads to closes the menu. *@
    <button type="@Type" class="menu-item" data-variant="@VariantName" popovertarget="@(Type == "submit" ? null : Menu?.Id)"
            popovertargetaction="@(Type == "submit" ? null : "hide")" @onclick="OnClick">
        @Content
    </button>
}

@code {
    [CascadingParameter]
    public ActionsMenu? Menu { get; set; }

    [Parameter, EditorRequired]
    public string Label { get; set; } = null!;

    /// <summary>What the choice of the item means, under its label.</summary>
    [Parameter]
    public string? Hint { get; set; }

    [Parameter]
    public IconName? Icon { get; set; }

    /// <summary><see cref="ButtonVariant.Delete"/> for a deletion, in the color of deletion of the theme.</summary>
    [Parameter]
    public ButtonVariant Variant { get; set; }

    /// <summary>The page it leads to: a link rather than a button.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>Whether <see cref="Href"/> is a site outside the application (e.g. the website of a publisher).</summary>
    [Parameter]
    public bool External { get; set; }

    /// <summary>The type of a button: <c>button</c>, or <c>submit</c> in a form.</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string VariantName => Variant.ToString().ToLowerInvariant();

    private RenderFragment Content => @<text>
        @if (Icon is { } icon)
        {
            <Icon Name="icon" />
        }
        @if (Hint is null)
        {
            <span>@Label</span>
        }
        else
        {
            <span class="menu-item-text">
                <span>@Label</span>
                <span class="menu-item-hint">@Hint</span>
            </span>
        }
    </text>;
}
