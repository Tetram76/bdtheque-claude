@inject IStringLocalizer<SaveBar> L

@* The bar of a record being entered, fixed at the bottom of the screen while its form is in view: the state of the record,
   cancel and save (visuel/saisie-album/contenu.md). Placed at the end of the form it submits. On a smartphone, it holds on
   one line, the state reduced to a few words. *@
<div class="save-bar">
    <div class="save-bar-content">
        <p class="save-bar-state" role="status" data-state="@StateName">
            <span class="save-bar-state-long">@(StateText ?? L[$"{State}.Long"])</span><span class="save-bar-state-short">@(StateShortText ?? L[$"{State}.Short"])</span>
        </p>
        <div class="save-bar-actions">
            <Button Label="@L["Cancel"]" Href="@CancelHref" />
            <Button Label="@SaveLabel" Type="submit" Variant="ButtonVariant.Primary" Disabled="@(Saving || SaveDisabled || State == SaveBarState.Sending)" />
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public SaveBarState State { get; set; }

    /// <summary>The label of the save (« Enregistrer », or « Créer l'album » for a new one).</summary>
    [Parameter, EditorRequired]
    public string SaveLabel { get; set; } = null!;

    /// <summary>The page cancelling leads back to, leaving the changes.</summary>
    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = null!;

    /// <summary>The record is being saved: it is not saved twice.</summary>
    [Parameter]
    public bool Saving { get; set; }

    /// <summary>What the bar says of the record instead of its state (e.g. the data a merge leaves to choose), and in short.</summary>
    [Parameter]
    public string? StateText { get; set; }

    /// <summary>The state in a few words, on a smartphone, with <see cref="StateText"/>.</summary>
    [Parameter]
    public string? StateShortText { get; set; }

    /// <summary>Whether the record cannot be saved yet (e.g. a merge with data left to choose).</summary>
    [Parameter]
    public bool SaveDisabled { get; set; }

    private string StateName => State.ToString().ToLowerInvariant();
}
