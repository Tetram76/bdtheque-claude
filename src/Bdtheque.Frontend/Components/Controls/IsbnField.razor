@using Bdtheque.Contracts.Admin
@using Bdtheque.Frontend.Entries
@implements IDisposable
@inject IStringLocalizer<IsbnField> L
@inject ApiClient Api

@* The ISBN of an edition, whose check digit is checked as it is entered, without blocking (fonctionnel/regles-metier/
   validation-de-l-isbn.md): correct, a tick; inconsistent, a warning that says it may be saved as it is. The check is the
   domain's, asked of the API (choix-implementation/domaine/validation-de-l-isbn.md), which also gives the ISBN as it will be
   saved, its check character in capitals, taken up as soon as it is typed: the frontend applies no rule of its own. A check
   that fails, with nothing to correct in the ISBN, is presented under the field at its scale until the next ISBN is checked
   (choix-implementation/socle/frontend.md, erreur dans un contrôle). *@
<div class="@(_checked == false ? "isbn-field isbn-field-warning" : "isbn-field")">
    <Field Id="@Id" Label="@L["Label"]" Help="@Help" Error="@Error" Failure="_failure" FailureText="@L["Failed"]" State="State" Context="control">
        <span class="isbn-field-control">
            <input id="@control.Id" type="text" inputmode="numeric" autocomplete="off" placeholder="@L["Placeholder"]" value="@Value"
                   aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                   data-warning="@(_checked == false ? "true" : null)" @oninput="EnterAsync" />
            @if (_checked is { } valid)
            {
                <Icon Name="@(valid ? IconName.Check : IconName.Alert)" />
            }
        </span>
    </Field>
</div>

@code {
    // The number of the ISBN whose check is shown: each change gets the next one, before anything is awaited, and only the
    // answer for the last ISBN is shown (as the sort key of a title, TitleSortKeyField).
    private int _number;
    private bool? _checked;
    private ApiProblem? _failure;
    private readonly CancellationTokenSource _disposal = new();

    /// <summary>The identifier of the field, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>What to correct in the ISBN, the saving of the edition refused (e.g. an ISBN longer than its column).</summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>The result of the check of the ISBN the edition was read with; <c>null</c> without ISBN.</summary>
    [Parameter]
    public bool? ReadCheck { get; set; }

    /// <summary>What the form tells of its datum (EntryTracker): its mark once modified, and what the user had entered before the record was reloaded (visuel/saisie-album/contenu.md).</summary>
    [Parameter]
    public EntryDatumState? State { get; set; }

    // The ISBN whose check is shown, or under way: another one given by the form (what the user had entered, taken back after a
    // reload) is checked as one typed.
    private string? _known;

    private string? Help => _checked switch { true => L["Valid"].Value, false => L["Inconsistent"].Value, null => null };

    protected override void OnInitialized()
    {
        _checked = ReadCheck;
        _known = Value;
    }

    protected override Task OnParametersSetAsync() => Value == _known ? Task.CompletedTask : CheckAsync(Value);

    private async Task EnterAsync(ChangeEventArgs args)
    {
        var isbn = args.Value as string;
        _known = isbn;
        await ValueChanged.InvokeAsync(isbn);
        await CheckAsync(isbn);
    }

    private async Task CheckAsync(string? isbn)
    {
        _known = isbn;
        var number = ++_number;
        // The failure was that of the check of the ISBN typed before.
        _failure = null;
        if (string.IsNullOrWhiteSpace(isbn))
        {
            _checked = null;
            return;
        }

        try
        {
            var check = await Api.GetAsync<IsbnCheck>($"/admin/editions/isbn-check?isbn={Uri.EscapeDataString(isbn)}", _disposal.Token);
            if (number == _number)
            {
                _checked = check.IsChecksumValid;
                // The check character in capitals as soon as it is typed, as it will be saved; the spaces around the ISBN,
                // which the saving also removes, are left while typing, where one may be the next separator.
                if (check.Isbn is { } saved && saved != isbn && string.Equals(saved, isbn, StringComparison.OrdinalIgnoreCase))
                {
                    _known = saved;
                    await ValueChanged.InvokeAsync(saved);
                }
            }
        }
        catch (ApiProblemException exception) when (number == _number)
        {
            // Neither correct nor inconsistent: the failure is said, the check never blocking the saving anyway.
            _checked = null;
            _failure = exception.Problem;
        }
        catch (ApiProblemException)
        {
            // The check of an earlier ISBN no longer matters.
        }
        catch (OperationCanceledException) when (_disposal.IsCancellationRequested)
        {
            // The form is gone.
        }
    }

    public void Dispose()
    {
        _disposal.Cancel();
        _disposal.Dispose();
    }
}
