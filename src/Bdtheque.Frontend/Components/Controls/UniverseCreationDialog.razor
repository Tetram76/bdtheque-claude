@using Bdtheque.Contracts.Admin
@inject IStringLocalizer<UniverseCreationDialog> L

@* The creation of a universe on the spot, from a record being entered that belongs to it (visuel/saisie-album/contenu.md,
   Genres et univers) or from the panel of a universe it contains (visuel/listes/saisie-selon-l-entite.md): its name alone, in
   the common dialog of a record created on the spot by its name. Created at the top of the hierarchy, it is attached to a
   parent from its own panel (choix-implementation/socle/frontend.md, création sur place). *@
<NameCreationDialog Id="@Id" Title="@L["Title"]" Lead="@L["Lead"]" Label="@L["Name"]" CreateLabel="@L["Create"]" Text="@Name"
                    OnCreated="name => OnCreated.InvokeAsync(new NewUniverse(Guid.NewGuid(), name))" OnCancel="OnCancel" />

@code {
    /// <summary>The identifier of the dialog, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>The name typed in the choice of a universe.</summary>
    [Parameter, EditorRequired]
    public string Name { get; set; } = null!;

    /// <summary>The universe to create with the record, to attach it to, or to attach the universe of the panel to.</summary>
    [Parameter]
    public EventCallback<NewUniverse> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }
}
