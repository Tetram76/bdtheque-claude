@implements IAsyncDisposable
@inject RecordSearch Search
@inject IStringLocalizer<RecordPicker> L
@inject IJSRuntime JS
@inject TimeProvider Clock

@* The choice of a record by typing its name (e.g. a series, an author, a publisher: visuel/liste-albums/contenu.md,
   visuel/saisie-album/contenu.md): a combobox whose list suggests the records that contain the text typed, chosen with
   the mouse, the finger or the keyboard. It needs interactivity (choix-implementation/socle/frontend.md): in a static
   page, the caller renders it in the InteractiveServer mode; in a static form, it sends the record chosen by its
   identifier (Name). The text typed is never a value: leaving the field without choosing gives back the record chosen.
   It may offer to create the record typed when none suits (e.g. an author, created on the spot from an album being
   entered), which the caller does. *@
<div class="record-picker">
    <input @ref="_input" id="@Id" type="text" role="combobox" autocomplete="off" aria-autocomplete="list"
           aria-expanded="@(IsOpen ? "true" : "false")" aria-controls="@ListId" aria-activedescendant="@ActiveOptionId"
           placeholder="@Placeholder" @bind="_text" @bind:event="oninput" @bind:after="SearchAsync" @onkeydown="OnKeyDownAsync" @onblur="Leave"
           @attributes="AdditionalAttributes" />
    @if (Value is { } value)
    {
        <button type="button" class="record-picker-clear" aria-label="@L["Clear", value.Label]" @onclick="ClearAsync"><Icon Name="IconName.Close" /></button>
    }
    else
    {
        <span class="record-picker-search"><Icon Name="IconName.Search" /></span>
    }
    @if (Name is not null)
    {
        <input type="hidden" name="@Name" value="@(Value?.Id.ToString() ?? "")" />
    }
    <ul id="@ListId" class="record-picker-list" role="listbox" aria-label="@L["Suggestions"]" hidden="@(!IsOpen)">
        @if (_status is not SearchStatus.Done)
        {
            <li class="record-picker-status" role="presentation">@L[_status.ToString()]</li>
        }
        @for (var index = 0; index < _options.Count; index++)
        {
            var option = _options[index];
            <li id="@OptionId(index)" class="record-picker-option @(IsPending(option) ? "record-picker-pending" : null)" role="option" aria-selected="@(index == _active ? "true" : "false")"
                @onmousedown:preventDefault @onclick="() => ChooseAsync(option)">
                <span>@option.Label</span>
                @if (option.Detail is not null)
                {
                    <span class="record-picker-detail">@option.Detail</span>
                }
            </li>
        }
        @if (CanCreate)
        {
            <li id="@OptionId(_options.Count)" class="record-picker-option record-picker-create" role="option"
                aria-selected="@(_active == _options.Count ? "true" : "false")" @onmousedown:preventDefault @onclick="CreateAsync">
                <Icon Name="IconName.Add" /><span>@CreateLabel!(_text.Trim())</span>
            </li>
        }
    </ul>
</div>

@code {
    /// <summary>
    /// The pause of the typing after which the text typed is searched: longer than the interval between two keystrokes of
    /// a word typed in one go, short enough for the suggestions to follow the typing.
    /// </summary>
    public static readonly TimeSpan TypingPause = TimeSpan.FromMilliseconds(500);

    private ElementReference _input;
    private IJSObjectReference? _module;
    // The number of the text shown: each change of the text, typed or not, gets the next one. Only the search of the
    // text shown asks the server and writes the suggestions.
    private int _textNumber;
    // Ends a pause or a request under way when the component is disposed.
    private readonly CancellationTokenSource _disposal = new();
    private string _text = "";
    private bool _open;
    private SearchStatus _status = SearchStatus.Done;
    private IReadOnlyList<RecordOption> _options = [];
    private int _active = -1;
    private string? _revealedOptionId;

    /// <summary>The identifier of the text field, unique in the page, which a <see cref="Field"/> labels.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    [Parameter, EditorRequired]
    public RecordKind Kind { get; set; }

    /// <summary>The record chosen; <c>null</c> for none.</summary>
    [Parameter]
    public RecordOption? Value { get; set; }

    [Parameter]
    public EventCallback<RecordOption?> ValueChanged { get; set; }

    /// <summary>The name under which a static form sends the identifier of the record chosen.</summary>
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Offers to create the record typed, once its search is done, with the text typed; the caller creates it (e.g. in a
    /// dialog) and chooses it. Requires <see cref="CreateLabel"/>.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnCreate { get; set; }

    /// <summary>
    /// The records added on the spot by the form, created only with the record it saves: the search does not know them, so
    /// they are suggested too, before the others, when their label contains the text typed, under the key the form gave them
    /// (e.g. an author added for a role, to credit with another, rather than created twice).
    /// </summary>
    [Parameter]
    public IReadOnlyList<RecordOption> Pending { get; set; } = [];

    /// <summary>The label of the creation, from the text typed (e.g. « Créer l'auteur « Moebius » »).</summary>
    [Parameter]
    public Func<string, string>? CreateLabel { get; set; }

    /// <summary>Takes the focus once rendered: a field opened by an action (e.g. « Ajouter ») is typed in at once.</summary>
    [Parameter]
    public bool AutoFocus { get; set; }

    /// <summary>The field is left without a record chosen nor created (e.g. to close a field opened by « Ajouter »).</summary>
    [Parameter]
    public EventCallback OnLeave { get; set; }

    /// <summary>Set on the text field (e.g. the <c>aria-describedby</c> and <c>aria-invalid</c> of its <see cref="Field"/>).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private enum SearchStatus
    {
        Done,
        Searching,
        NoResult,
        Failed,
    }

    private bool IsOpen => _open && !string.IsNullOrWhiteSpace(_text);

    // Offered once the search of the text shown is over, failed or not: never for a text whose suggestions are to come.
    private bool CanCreate => OnCreate.HasDelegate && CreateLabel is not null && _status is SearchStatus.Done or SearchStatus.NoResult
                              && !string.IsNullOrWhiteSpace(_text);

    // The suggestions, then the creation, if offered.
    private int OptionCount => _options.Count + (CanCreate ? 1 : 0);

    private string ListId => $"{Id}-suggestions";

    private string? ActiveOptionId => IsOpen && _active >= 0 ? OptionId(_active) : null;

    private string OptionId(int index) => $"{Id}-suggestion-{index}";

    protected override void OnParametersSet()
    {
        if (!_open && _text != (Value?.Label ?? ""))
            ShowText(Value?.Label ?? "");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["record-picker.js"]}");
            await _module.InvokeVoidAsync("keepKeysForTheList", _input);
            if (AutoFocus)
                await _input.FocusAsync();
        }

        // The focus stays on the text field: the list does not scroll by itself to the active suggestion. The suggestion
        // revealed is the one this rendering shows, noted before the call: the renderings of the keys pressed meanwhile
        // each reveal their own.
        if (ActiveOptionId is not { } active)
            _revealedOptionId = null;
        else if (_module is not null && active != _revealedOptionId)
        {
            _revealedOptionId = active;
            await _module.InvokeVoidAsync("reveal", active);
        }
    }

    private async Task SearchAsync()
    {
        // The suggestions of the earlier text are no longer valid: none is shown, nor chosen, until those of this one.
        // The text gets its number before anything is awaited, the circuit being free to handle the next keystroke at
        // any await: only the search of the last text typed asks the server and writes the suggestions, and the answer
        // to an earlier text, slower, never overwrites them (#275).
        var number = ++_textNumber;
        Suggest([], SearchStatus.Searching);
        if (string.IsNullOrWhiteSpace(_text))
        {
            Close();
            return;
        }

        _open = true;
        var cancellation = _disposal.Token;
        try
        {
            // Searched once the typing pauses: the server is not asked for each letter of a word typed in one go.
            await Task.Delay(TypingPause, Clock, cancellation);
            if (number != _textNumber)
                return;
            var found = await Search.FindAsync(Kind, _text, cancellation);
            if (number != _textNumber)
                return;
            IReadOnlyList<RecordOption> options = [.. PendingMatching(_text), .. found];
            Suggest(options, options.Count == 0 ? SearchStatus.NoResult : SearchStatus.Done);
        }
        catch (ApiProblemException) when (number == _textNumber)
        {
            Suggest([], SearchStatus.Failed);
        }
        catch (ApiProblemException)
        {
            // The failure of the search of an earlier text no longer matters.
        }
        catch (OperationCanceledException) when (cancellation.IsCancellationRequested)
        {
            // The component is disposed.
        }
    }

    // A record added on the spot: its detail says so, marked apart from the name.
    private bool IsPending(RecordOption option) => Pending.Any(p => p.Id == option.Id);

    // Compared as the search of the lists compares, whatever the case and the accents.
    private IEnumerable<RecordOption> PendingMatching(string text) =>
        Pending.Where(p => CultureInfo.CurrentCulture.CompareInfo.IndexOf(
            p.Label, text.Trim(), CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0);

    private async Task OnKeyDownAsync(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowDown" when !IsOpen && OptionCount > 0 && !string.IsNullOrWhiteSpace(_text):
                _open = true;
                break;
            case "ArrowDown" when IsOpen && OptionCount > 0:
                _active = Math.Min(_active + 1, OptionCount - 1);
                break;
            case "ArrowUp" when IsOpen && OptionCount > 0:
                _active = Math.Max(_active - 1, 0);
                break;
            case "Enter" when IsOpen && _active >= 0 && _active < _options.Count:
                await ChooseAsync(_options[_active]);
                break;
            case "Enter" when IsOpen && _active == _options.Count && CanCreate:
                await CreateAsync();
                break;
            case "Escape" when IsOpen:
                Close();
                break;
        }
    }

    private async Task ChooseAsync(RecordOption option)
    {
        Value = option;
        ShowText(option.Label);
        await ValueChanged.InvokeAsync(option);
    }

    // The text typed goes to the caller, which creates the record; the field shows the record chosen meanwhile.
    private async Task CreateAsync()
    {
        var text = _text.Trim();
        ShowText(Value?.Label ?? "");
        await OnCreate.InvokeAsync(text);
    }

    private async Task ClearAsync()
    {
        Value = null;
        ShowText("");
        await ValueChanged.InvokeAsync(null);
        await _input.FocusAsync();
    }

    private async Task Leave()
    {
        ShowText(Value?.Label ?? "");
        await OnLeave.InvokeAsync();
    }

    // The only change of the text other than typing (choice, clearing, leaving the field, a new value): the suggestions
    // are always those of the text shown, so those of the text replaced, and its search under way, end with it.
    private void ShowText(string text)
    {
        _text = text;
        _textNumber++;
        Close();
        Suggest([], SearchStatus.Done);
    }

    // The only writing of the suggestions: the active one, an index in them, never outlives them.
    private void Suggest(IReadOnlyList<RecordOption> options, SearchStatus status)
    {
        _options = options;
        _status = status;
        _active = -1;
    }

    private void Close()
    {
        _open = false;
        _active = -1;
    }

    public async ValueTask DisposeAsync()
    {
        await _disposal.CancelAsync();
        _disposal.Dispose();
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the module with it.
            }
        }
    }
}
