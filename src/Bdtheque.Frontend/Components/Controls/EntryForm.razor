@* The frame of an entry form of the administration (visuel/saisie-album/contenu.md, model of the other entry forms): its fil
   d'Ariane, its title followed by the label of the record and what it tells of it at first glance, the error of its saving above the form, the dates of the record and the blocks of the form
   in a single column, and the bar that saves it, fixed at the bottom of the screen. The
   form keeps the width it has beside a side column on the form of an edition. Interactive: the page saves the record
   itself (OnSave), and has it reveal what is to correct once a saving is refused (RevealProblemAsync). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Marked once rendered by its circuit (RendererInfo.IsInteractive, documentation of ASP.NET Core, « Render modes »): until then,
   the prerendered form answers nothing, which nothing else in the page tells. *@
<div class="entry-form" @ref="_root" data-interactive="@(RendererInfo.IsInteractive ? "true" : null)">
    <div class="entry-form-heading">
        <Breadcrumb Items="Breadcrumb" />
        <h1 class="entry-form-title">@Title</h1>
        <p class="entry-form-subject">@Subject</p>
        @Status
    </div>

    @Problem

    <form class="entry-form-body" novalidate @onsubmit="OnSave">
        @* Disabled while the record is saved: a field changed meanwhile would be overwritten by the record as saved. *@
        <fieldset class="entry-form-blocks" disabled="@Saving">
            @* Just above the first block (visuel/saisie-album/contenu.md). *@
            @if (Dates is not null)
            {
                <p class="entry-form-dates">@Dates</p>
            }
            @ChildContent
        </fieldset>
        <SaveBar State="State" SaveLabel="@SaveLabel" CancelHref="@CancelHref" Saving="Saving" />
    </form>
</div>

@code {
    private ElementReference _root;
    private IJSObjectReference? _module;

    [Parameter, EditorRequired]
    public IReadOnlyList<BreadcrumbItem> Breadcrumb { get; set; } = [];

    /// <summary>« Modifier l'album », « Nouvel album »…</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>The label of the record, computed again as it is entered.</summary>
    [Parameter, EditorRequired]
    public string Subject { get; set; } = null!;

    /// <summary>What the page tells of the record at first glance, under its title (e.g. an album not in the collection).</summary>
    [Parameter]
    public RenderFragment? Status { get; set; }

    /// <summary>The error of the last saving, if any (ErrorMessage).</summary>
    [Parameter]
    public RenderFragment? Problem { get; set; }

    /// <summary>The blocks of the form.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The dates of the creation and modification of a record already saved.</summary>
    [Parameter]
    public RenderFragment? Dates { get; set; }

    [Parameter, EditorRequired]
    public SaveBarState State { get; set; }

    [Parameter, EditorRequired]
    public string SaveLabel { get; set; } = null!;

    [Parameter, EditorRequired]
    public string CancelHref { get; set; } = null!;

    /// <summary>Whether the record is being saved: the form is then disabled, and so is its saving.</summary>
    [Parameter]
    public bool Saving { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>
    /// Brings into view what is to correct, the error of the saving being rendered: the first field in error, focused, or
    /// else the error itself (wwwroot/entry-form.js).
    /// </summary>
    public async Task RevealProblemAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["entry-form.js"]}");
        await _module.InvokeVoidAsync("revealProblem", _root);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the module with it.
            }
        }
    }
}
