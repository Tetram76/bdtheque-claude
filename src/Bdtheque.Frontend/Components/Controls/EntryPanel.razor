@implements IAsyncDisposable
@inject IJSRuntime JS

@* The frame of the side panel that enters an author or a universe (visuel/listes/saisie-selon-l-entite.md), as EntryForm is that
   of an entry form in a page: the error of its saving at the top, the dates of the record above its first field, its fields,
   then « Annuler » and its saving. Interactive: the panel saves the record itself (OnSave), and has it reveal what is to
   correct once a saving is refused (RevealProblemAsync); Enter in a field saves it, as a form does. *@
@* Marked once rendered by its circuit (RendererInfo.IsInteractive): until then, the prerendered panel answers nothing. *@
<form class="side-panel-form" novalidate @ref="_root" @onsubmit="SubmitAsync" data-interactive="@(RendererInfo.IsInteractive ? "true" : null)">
    <SidePanel Id="@Id" Title="@Title" CloseHref="@CloseHref">
        <ChildContent>
            @Problem
            @if (Dates is not null)
            {
                <p class="side-panel-dates">@Dates</p>
            }
            @ChildContent
        </ChildContent>
        <Actions>
            @* Saved from the circuit only, as an entry form (EntryForm). *@
                <Button Type="submit" Variant="ButtonVariant.Primary" Label="@SaveLabel" Disabled="@(!RendererInfo.IsInteractive)" />
        </Actions>
    </SidePanel>
</form>

@if (_redoWarned)
{
    <RedoWarning Id="@($"{Id}-redo")" OnBack="() => _redoWarned = false" OnSave="SaveAnywayAsync" />
}

@* The circuit keeps the principal it was opened with: once it finds the session over (AdminCircuitAuthenticationStateProvider),
   the panel leads back to the login, as an entry form does. *@
@if (_sessionEnded)
{
    <RedirectToLogin />
}

@code {
    private ElementReference _root;
    private bool _redoWarned;
    private IJSObjectReference? _module;
    private bool _sessionEnded;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    /// <summary>The identifier of the panel, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>« Modifier l'auteur », « Nouvel univers »…</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>The page under the panel, without it, that « Annuler » and Escape lead to.</summary>
    [Parameter, EditorRequired]
    public string CloseHref { get; set; } = null!;

    [Parameter, EditorRequired]
    public string SaveLabel { get; set; } = null!;

    /// <summary>The error of the last saving, if any (SaveError).</summary>
    [Parameter]
    public RenderFragment? Problem { get; set; }

    /// <summary>The dates of the creation and modification of a record already saved.</summary>
    [Parameter]
    public RenderFragment? Dates { get; set; }

    /// <summary>The fields of the record.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback OnSave { get; set; }

    /// <summary>
    /// Whether data of the entry left behind when the record was reloaded are still to take or reject (EntryTracker.HasRedo):
    /// the saving warns first.
    /// </summary>
    [Parameter]
    public bool HasRedo { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (RendererInfo.IsInteractive && AuthenticationState is not null)
            _sessionEnded = (await AuthenticationState).User.Identity?.IsAuthenticated != true;
    }

    /// <summary>
    /// Brings into view what is to correct, the error of the saving being rendered: the first field in error, focused, or
    /// else the error itself (wwwroot/entry-form.js).
    /// </summary>
    public async Task RevealProblemAsync()
    {
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets["entry-form.js"]}");
        await _module.InvokeVoidAsync("revealProblem", _root);
    }

    private Task SubmitAsync()
    {
        if (!HasRedo)
            return OnSave.InvokeAsync();
        _redoWarned = true;
        return Task.CompletedTask;
    }

    private Task SaveAnywayAsync()
    {
        _redoWarned = false;
        return OnSave.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and the module with it.
            }
        }
    }
}
