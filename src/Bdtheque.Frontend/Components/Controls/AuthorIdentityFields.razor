@using Bdtheque.Contracts.Admin
@implements IDisposable
@inject ApiClient Api
@inject IStringLocalizer<AuthorIdentityFields> L

@* The identity of an author, in the side panel of the list of the authors (visuel/saisie-auteur/contenu.md): its first name and
   last name side by side, then its pseudonym, sent by their names with the static form of the panel; under them, in a dashed
   frame, what derives from them, computed and never entered: the name displayed, the key the author is filed at and its
   initial (fonctionnel/presentation/tri-et-navigation-par-initiale.md#artistes), asked for to the API at each change of a name,
   never computed here (choix-implementation/socle/frontend.md, no rule of entry in the frontend). It needs interactivity to
   follow the typing: the caller renders it in the InteractiveServer mode, and passes it only what serializes. An author without
   last name nor pseudonym, refused, has both fields bordered with the alert color until one of them changes. *@
<div class="author-identity">
    <div class="author-identity-names">
        <Field Id="@FirstNameId" Label="@L["FirstName"]" Context="control">
            <input id="@control.Id" type="text" name="@FirstNameName" value="@_firstName" autocomplete="off"
                   @oninput="@(args => ChangeAsync(args, (names, value) => names with { FirstName = value }))" />
        </Field>
        <Field Id="@LastNameId" Label="@L["LastName"]" Error="@_error" Context="control">
            <input id="@control.Id" type="text" name="@LastNameName" value="@_lastName" autocomplete="off"
                   aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                   @oninput="@(args => ChangeAsync(args, (names, value) => names with { LastName = value }))" />
        </Field>
    </div>
    <Field Id="@PseudonymId" Label="@L["Pseudonym"]" Help="@L["Pseudonym.Help"]" Context="control">
        @* The error, said once under the last name, concerns the pseudonym as much: it is bordered and described by it too. *@
        <input id="@control.Id" type="text" name="@PseudonymName" value="@_pseudonym" autocomplete="off"
               aria-describedby="@PseudonymDescribedBy(control.DescribedBy)"
               aria-invalid="@(_error is null ? null : "true")"
               @oninput="@(args => ChangeAsync(args, (names, value) => names with { Pseudonym = value }))" />
    </Field>
    <div class="author-identity-derived" role="group" aria-labelledby="@DerivedTitleId">
        <p class="author-identity-derived-title" id="@DerivedTitleId">@L["Derived"]</p>
        <dl class="author-identity-values" aria-live="polite">
            <div class="author-identity-value">
                <dt>@L["Derived.Displayed"]</dt>
                <dd>@Value(_derived?.DisplayName, GrammaticalGender.Masculine)</dd>
            </div>
            <div class="author-identity-value">
                <dt>@L["Derived.SortKey"]</dt>
                <dd>@Value(_derived?.SortKey, GrammaticalGender.Feminine)</dd>
            </div>
            <div class="author-identity-value">
                <dt>@L["Derived.Entry"]</dt>
                <dd>@Value(_derived?.NavigationEntry, GrammaticalGender.Feminine)</dd>
            </div>
        </dl>
        <p class="author-identity-help">@L["Derived.Help"]</p>
    </div>
</div>

@code {
    // The number of the names whose identity is shown: each change of a name gets the next one, before anything is awaited, and
    // only the answer for the last names is shown (as the sort key of a title, Controls/TitleSortKeyField.razor).
    private int _namesNumber;
    private Names _names = new(null, null, null);
    private string? _lastName;
    private string? _firstName;
    private string? _pseudonym;
    private AuthorSortKey? _derived;
    private string? _error;
    private Received? _received;
    private readonly CancellationTokenSource _disposal = new();

    /// <summary>The identifier of the fields, unique in the page, from which those of each field derive.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>The names under which the form sends the last name, the first name and the pseudonym.</summary>
    [Parameter, EditorRequired]
    public string LastNameName { get; set; } = null!;

    [Parameter, EditorRequired]
    public string FirstNameName { get; set; } = null!;

    [Parameter, EditorRequired]
    public string PseudonymName { get; set; } = null!;

    [Parameter]
    public string? LastName { get; set; }

    [Parameter]
    public string? FirstName { get; set; }

    [Parameter]
    public string? Pseudonym { get; set; }

    /// <summary>What derives from these names, as the API computed it for the page; <c>null</c> without a name to identify the author.</summary>
    [Parameter]
    public AuthorSortKey? Derived { get; set; }

    /// <summary>Why the names sent were refused: neither a last name nor a pseudonym.</summary>
    [Parameter]
    public string? Error { get; set; }

    private string FirstNameId => $"{Id}-first-name";

    private string LastNameId => $"{Id}-last-name";

    private string PseudonymId => $"{Id}-pseudonym";

    private string DerivedTitleId => $"{Id}-derived";

    // What the page sends (the names read, or sent back with a refused form, and its error) replaces what is shown; the same
    // values sent again leave the typing as it is.
    protected override void OnParametersSet()
    {
        var received = new Received(new Names(LastName, FirstName, Pseudonym), Derived, Error);
        if (received == _received)
            return;
        _received = received;
        _names = received.Names;
        (_lastName, _firstName, _pseudonym, _derived, _error) = (LastName, FirstName, Pseudonym, Derived, Error);
    }

    private async Task ChangeAsync(ChangeEventArgs args, Func<Names, string?, Names> change)
    {
        var value = args.Value as string;
        _names = change(_names, value);
        (_lastName, _firstName, _pseudonym) = (_names.LastName, _names.FirstName, _names.Pseudonym);
        _error = null;
        var number = ++_namesNumber;
        var names = _names;
        try
        {
            var derived = await Api.GetAsync<AuthorSortKey>(
                $"/admin/sort-keys/author?lastName={Escape(names.LastName)}&firstName={Escape(names.FirstName)}&pseudonym={Escape(names.Pseudonym)}",
                _disposal.Token);
            if (number == _namesNumber)
                _derived = derived;
        }
        catch (ApiProblemException) when (number == _namesNumber)
        {
            // Shown again at the next change of a name; what is stored is the domain's anyway, whatever is shown.
            _derived = null;
        }
        catch (ApiProblemException)
        {
            // The identity of earlier names no longer matters.
        }
        catch (OperationCanceledException) when (_disposal.IsCancellationRequested)
        {
            // The panel is gone.
        }
    }

    private static string Escape(string? value) => Uri.EscapeDataString(value ?? "");

    // « — » for what no name gives yet, as any datum missing (visuel/charte-graphique/convivialite-et-efficacite.md).
    private static RenderFragment Value(string? value, GrammaticalGender gender) => value is null
        ? @<NotSet Brief="true" Gender="gender" />
        : @<text>@value</text>;

    private string? PseudonymDescribedBy(string? own) =>
        _error is null ? own : string.Join(' ', new[] { $"{LastNameId}-error", own }.OfType<string>());

    public void Dispose()
    {
        _disposal.Cancel();
        _disposal.Dispose();
    }

    private sealed record Names(string? LastName, string? FirstName, string? Pseudonym);

    private sealed record Received(Names Names, AuthorSortKey? Derived, string? Error);
}
