@* The dialog of a record created on the spot by its name or its title alone, from the choice of a record being entered that
   cites it (visuel/saisie-album/contenu.md, création sur place): it asks for what the record requires only, the text typed in
   the choice, which the user checks, and nothing else. Common to the records it creates (choix-implementation/socle/frontend.md,
   fiches de saisie), each giving its texts only: the rule cannot diverge from one record to another. The record is created
   only with the one that cites it, when that one is saved: the domain then applies its rules, and an error is presented with
   the saving. Interactive. *@
<Dialog Id="@Id" Title="@Title" Tone="DialogTone.Creation" OnClose="OnCancel">
    <ChildContent>
        <p class="record-creation-lead">@Lead</p>
        <div class="record-creation-fields">
            <Field Id="@($"{Id}-name")" Label="@Label" Required Context="control">
                <input id="@control.Id" type="text" @bind="_text" />
            </Field>
        </div>
    </ChildContent>
    <Actions>
        <Button Label="@CreateLabel" Variant="ButtonVariant.Primary" OnClick="CreateAsync" />
    </Actions>
</Dialog>

@code {
    private string? _text;

    /// <summary>The identifier of the dialog, unique in the page.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = null!;

    /// <summary>The title of the dialog (e.g. « Nouvelle série »).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>That the record is created only with the one that cites it.</summary>
    [Parameter, EditorRequired]
    public string Lead { get; set; } = null!;

    /// <summary>The label of the name or the title (e.g. « Titre »).</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = null!;

    /// <summary>The label of the creation (e.g. « Ajouter la série »).</summary>
    [Parameter, EditorRequired]
    public string CreateLabel { get; set; } = null!;

    /// <summary>The text typed in the choice of the record.</summary>
    [Parameter, EditorRequired]
    public string Text { get; set; } = null!;

    /// <summary>The name or the title of the record to create, trimmed: the domain says whether it suits.</summary>
    [Parameter]
    public EventCallback<string> OnCreated { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnInitialized() => _text = Text.Trim();

    private Task CreateAsync() => OnCreated.InvokeAsync(_text?.Trim() ?? "");
}
