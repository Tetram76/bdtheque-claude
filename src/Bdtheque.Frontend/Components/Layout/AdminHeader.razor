@using Bdtheque.Contracts.Admin
@using Bdtheque.Frontend.Api
@inject IStringLocalizer<LayoutText> L
@inject NavigationManager Navigation
@inject DisplayFormatter Format
@inject AdminRecordCounts RecordCounts
@inject ILogger<AdminHeader> Logger

@* The header of the administration (visuel/administration/en-tete-et-menu.md): the logo, the « Administration » tag, the
   search of a record to modify, the help, the way back to the consultation, then the « Menu » button. On a smartphone, it
   takes two lines: the logo, the tag, the consultation and the menu, reduced to their icon, then the search and the help.
   The menu is a popover of the browser, anchored to its button and floating over the page, which it never pushes aside: a
   click outside it, Escape, its cross or the button close it, without any interactivity nor script
   (choix-implementation/socle/frontend.md). While it is open, the page stays still and the panel scrolls on its own. *@
<header class="app-header admin-header">
    <a class="app-logo" href="@AppPaths.AdminHome">@L["AppName"]</a>
    <span class="admin-tag">@L["Administration"]</span>
    <div class="admin-search">
        <HeaderSearch Action="@AppPaths.AdminSearch" Id="admin-search" Label="@L["AdminSearch"]" Placeholder="@L["AdminSearchPlaceholder"]" />
        <HelpLink />
    </div>
    <div class="admin-actions">
        <a class="admin-action" href="@AppPaths.Home"><span class="visually-hidden-on-smartphone">@L["ToConsultation"]</span><Icon Name="IconName.Exit" /></a>
        <button type="button" class="admin-action admin-menu-toggle" popovertarget="@MenuId"><Icon Name="IconName.Menu" /><span class="visually-hidden-on-smartphone">@L["Menu"]</span></button>
        <div id="@MenuId" class="admin-menu" popover="auto">
            <div class="admin-menu-head">
                <span class="admin-menu-title">@L["Menu"]</span>
                <button type="button" class="admin-menu-close" popovertarget="@MenuId" popovertargetaction="hide" aria-label="@L["CloseMenu"]"><Icon Name="IconName.Close" /></button>
            </div>
            <nav aria-label="@L["AdminPlan"]">
                @foreach (var group in Groups)
                {
                    <div class="admin-menu-group">
                        <p class="admin-menu-group-title" id="admin-menu-@group.Name">@L[$"Group.{group.Name}"]</p>
                        <ul aria-labelledby="admin-menu-@group.Name">
                            @foreach (var entry in group.Entries)
                            {
                                <li>
                                    <a href="@entry.Path" aria-current="@(entry.IsCurrent(CurrentPath) ? "page" : null)">
                                        <span>@L[entry.Name]</span>
                                        @if (_counts is not null && Counts.TryGetValue(entry.Name, out var count))
                                        {
                                            <span class="admin-menu-count">@Format.Number(count(_counts))</span>
                                        }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
                <hr />
                <AdminLogoutForm />
            </nav>
        </div>
    </div>
</header>

@code {
    /// <summary>The identifier of the menu, which the page uses to stay still while it is open (app.css).</summary>
    public const string MenuId = "admin-menu";

    // The plan of the administration, by groups (visuel/administration/en-tete-et-menu.md). « Nouvelle édition » gives a
    // direct access to the main action of the administration.
    private static readonly IReadOnlyList<(string Name, IReadOnlyList<NavigationEntry> Entries)> Groups =
    [
        ("Home", [new("Admin.Dashboard", AppPaths.AdminHome, Exact: true), new("Admin.NewEdition", AppPaths.AdminNewEdition)]),
        ("Collection", [new("Admin.Albums", AppPaths.AdminAlbums), new("Admin.Series", AppPaths.AdminSeries),
            new("Admin.Editions", AppPaths.AdminEditions), new("Admin.PurchaseIntents", AppPaths.AdminPurchaseIntents)]),
        ("AuthorsAndPublishers", [new("Admin.Authors", AppPaths.AdminAuthors), new("Admin.Publishers", AppPaths.AdminPublishers)]),
        ("Referentials", [new("Admin.Genres", AppPaths.AdminGenres), new("Admin.Universes", AppPaths.AdminUniverses)]),
        ("Settings", [new("Admin.Settings", AppPaths.AdminSettings), new("Admin.Statistics", AppPaths.AdminStatistics)]),
    ];

    // The number of records of the entries that lead to a list (visuel/administration/en-tete-et-menu.md, « le cas échéant »).
    private static readonly IReadOnlyDictionary<string, Func<RecordCounts, int>> Counts = new Dictionary<string, Func<RecordCounts, int>>
    {
        ["Admin.Albums"] = c => c.Albums,
        ["Admin.Series"] = c => c.Series,
        ["Admin.Editions"] = c => c.Editions,
        ["Admin.PurchaseIntents"] = c => c.PurchaseIntents,
        ["Admin.Authors"] = c => c.Authors,
        ["Admin.Publishers"] = c => c.Publishers,
        ["Admin.Genres"] = c => c.Genres,
        ["Admin.Universes"] = c => c.Universes,
    };

    private RecordCounts? _counts;

    private string CurrentPath => new Uri(Navigation.Uri).AbsolutePath;

    // Without them, the menu still leads everywhere: the page, which needs them or not, presents the error itself.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _counts = await RecordCounts.GetAsync();
        }
        catch (ApiProblemException exception)
        {
            Logger.LogWarning(exception, "The menu of the administration is presented without the number of records.");
        }
    }
}
