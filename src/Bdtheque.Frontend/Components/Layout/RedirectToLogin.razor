@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        // `forceLoad` keeps the login out of any interactive render. Rendered statically, the page asked for answers by an
        // HTTP redirect, which the browser follows, or the script of Blazor by an enhanced navigation when a link of the
        // application asked for the page: either way the login is rendered statically, through the authentication
        // pipeline of ASP.NET Core.
        // The page to return to as the authentication cookie gives it: a path of the application, from its root.
        NavigationManager.NavigateTo(
            $"{AppPaths.AdminLogin}?{AppPaths.ReturnUrlParameter}={Uri.EscapeDataString(new Uri(NavigationManager.Uri).PathAndQuery)}",
            forceLoad: true);
    }
}
