@inject IStringLocalizer<LayoutText> L

@* Shown by blazor.web.js when an interactive component fails, a technical error presented as any other
   (choix-implementation/socle/frontend.md, Présentation): the id is the one the script looks for, and the classes reload
   and dismiss those of the elements it gives their action, whatever they are. *@
<div id="blazor-error-ui" data-nosnippet>
    <ErrorMessage Problem="ApiProblem.Technical()" Message="@L["UnhandledError"]">
        <Actions>
            <Button Label="@L["Reload"]" Icon="IconName.Reload" class="reload" />
            <Button Label="@L["Dismiss"]" Icon="IconName.Close" IconOnly="true" class="dismiss" />
        </Actions>
    </ErrorMessage>
</div>
