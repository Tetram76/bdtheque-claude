@using Bdtheque.Contracts.Admin
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<AlbumFilterFields> L

@* The panel of the filters of a list of the albums, the same in the consultation and in the administration
   (visuel/liste-albums/contenu.md): each record chosen by typing its name, interactive, a collection and its publisher linked,
   and the possession chosen in a list (fonctionnel/regles-metier/appartenance-a-la-collection.md#états-dun-album). The public
   list of the purchase intents takes it for the albums of its intents, without the possession, of no interest there
   (fonctionnel/regles-metier/perimetre-de-la-consultation.md). The names of its fields are those of the criteria in the
   address, shared by these lists. *@
<ListFilters Note="@L["Note"]">
    <Field Id="filter-series" Label="@L["Series"]" Context="control">
        <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Series" Name="@AlbumListQuery.SeriesName"
                      Value="@Option(Filters.Series, s => new(s.Id, s.Title, null))" Placeholder="@L["Any"]" />
    </Field>
    <Field Id="filter-author" Label="@L["Author"]" Context="control">
        <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Author" Name="@AlbumListQuery.AuthorName"
                      Value="@Option(Filters.Author, a => new(a.Id, RecordSearch.AuthorName(a.LastName, a.FirstName, a.Pseudonym), null))"
                      Placeholder="@L["Any"]" />
    </Field>
    @* A collection belongs to its publisher: the pair linked. *@
    <LinkedFilters @rendermode="InteractiveServer"
                   ParentKind="RecordKind.Publisher" ParentId="filter-publisher" ParentName="@AlbumListQuery.PublisherName"
                   ParentLabel="@L["Publisher"]" Parent="@Option(Filters.Publisher, p => new(p.Id, p.Name, null))"
                   ChildKind="RecordKind.PublisherCollection" ChildId="filter-collection" ChildName="@AlbumListQuery.PublisherCollectionName"
                   ChildLabel="@L["PublisherCollection"]" Child="@Option(Filters.PublisherCollection, RecordSearch.CollectionOption)"
                   Placeholder="@L["Any"]" />
    <Field Id="filter-genre" Label="@L["Genre"]" Context="control">
        <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Genre" Name="@AlbumListQuery.GenreName"
                      Value="@Option(Filters.Genre, g => new(g.Id, g.Label, null))" Placeholder="@L["Any"]" />
    </Field>
    <Field Id="filter-universe" Label="@L["Universe"]" Context="control">
        <RecordPicker @rendermode="InteractiveServer" Id="@control.Id" Kind="RecordKind.Universe" Name="@AlbumListQuery.UniverseName"
                      Value="@Option(Filters.Universe, u => new(u.Id, u.Name, u.ParentName))" Placeholder="@L["Any"]" />
    </Field>
    @if (WithPossession)
    {
        <Field Id="filter-state" Label="@L["State"]" Context="control">
            <select id="@control.Id" name="@AlbumListQuery.StateName">
                <option value="" selected="@(State is null)">@L["State.All"]</option>
                @foreach (var state in Enum.GetValues<AlbumCollectionState>())
                {
                    <option value="@state" selected="@(State == state)">@L[$"State.{state}"]</option>
                }
            </select>
        </Field>
    }
</ListFilters>

@code {
    /// <summary>The records the list is filtered on, as the API names them.</summary>
    [Parameter, EditorRequired]
    public AlbumListFilters Filters { get; set; } = null!;

    /// <summary>Whether the possession is one of the filters: not for the list of the purchase intents.</summary>
    [Parameter]
    public bool WithPossession { get; set; } = true;

    /// <summary>The possession chosen; <c>null</c> for all the albums.</summary>
    [Parameter]
    public AlbumCollectionState? State { get; set; }

    private static RecordOption? Option<T>(T? item, Func<T, RecordOption> option) where T : class => item is null ? null : option(item);
}
