@* The page of a list of the administration (visuel/liste-albums/contenu.md, model of the other lists): its heading, then the
   list in a single block without a visible title, and the dialogs of a row; the error of the API instead of the list. *@
<div class="admin-list">
    @Heading

    @if (Problem is not null)
    {
        <ErrorMessage Problem="Problem" />
    }
    else if (Loaded)
    {
        <Block Title="@Title" Kicker="@Kicker" TitleHidden="true">
            <div class="admin-list-body">
                @ChildContent
            </div>
        </Block>

        @Dialogs
    }
</div>

@code {
    /// <summary>The heading of the list (<see cref="ListHeading"/>).</summary>
    [Parameter, EditorRequired]
    public RenderFragment Heading { get; set; } = null!;

    /// <summary>The name of the list, its block having no visible title (e.g. « Liste des albums »).</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>The mention of the block of the list, which only some themes show (visuel/listes/declinaison-par-theme.md).</summary>
    [Parameter]
    public string? Kicker { get; set; }

    /// <summary>The error of the API that prevented the list from being read, presented instead of it.</summary>
    [Parameter]
    public ApiProblem? Problem { get; set; }

    /// <summary>Whether the list is read, and presented.</summary>
    [Parameter]
    public bool Loaded { get; set; }

    /// <summary>The search, filters, navigation, summary, rows and pagination of the list.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The dialog of a row opened by the address, if any.</summary>
    [Parameter]
    public RenderFragment? Dialogs { get; set; }
}
