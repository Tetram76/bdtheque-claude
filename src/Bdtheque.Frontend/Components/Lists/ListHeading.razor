@inject IStringLocalizer<ListHeading> L
@inject DisplayFormatter Format

@* The heading of a list of the administration (visuel/liste-albums/contenu.md): its fil d'Ariane, its title followed by the
   number of its records, and the creation of a new record, put forward and reduced to its icon on a smartphone; for records
   entered from another one, a mention of where they are entered in its place (visuel/listes/principes-communs.md). *@
<div class="list-heading">
    <Breadcrumb Items="@([new BreadcrumbItem(L["Administration"], AppPaths.AdminHome), new BreadcrumbItem(Title)])" />
    <div class="list-heading-title">
        <h1>@Title @if (TotalCount is { } count)
            {
                <span class="list-heading-count">@Format.Number(count)</span>
            }
        </h1>
        @if (NewHref is not null)
        {
            <Button Href="@NewHref" Variant="ButtonVariant.Primary" Icon="IconName.Add" Label="@(NewLabel!)" IconOnlyOnSmartphone="true" />
        }
        else if (Note is not null)
        {
            <p class="list-heading-note">@Note</p>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>The number of records of the type, the whole list; none when the API did not give it.</summary>
    [Parameter]
    public int? TotalCount { get; set; }

    /// <summary>The page that creates a record of the type; none for the records entered from another one.</summary>
    [Parameter]
    public string? NewHref { get; set; }

    /// <summary>The label of the creation (e.g. « Nouvel album »), required with <see cref="NewHref"/>.</summary>
    [Parameter]
    public string? NewLabel { get; set; }

    /// <summary>Where the records of the type are entered, in place of a creation they do not have.</summary>
    [Parameter]
    public string? Note { get; set; }
}
