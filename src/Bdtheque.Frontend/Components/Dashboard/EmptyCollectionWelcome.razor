@inject IStringLocalizer<EmptyCollectionWelcome> L

@* The welcome screen of an empty collection (visuel/dashboard/collection-vide.md), in place of the dashboard, which would
   have nothing to show: no counter, and no search in the header, which would have almost nothing to find. Each block
   names its area, which the theme lays out (--home-empty-areas, themes/base.css), as it chooses its illustration. *@
<NoHeaderSearch />

<div class="empty-collection">
    <Block Title="@L["Title"]" HeadingLevel="1" data-area="main">
        <div class="empty-collection-main">
            @* The place of the first album on the front page, as a page is laid out before its photo arrives. *@
            <div class="empty-collection-photo" aria-hidden="true">
                <svg viewBox="0 0 30 40" preserveAspectRatio="none"><path d="M0 0L30 40M30 0L0 40" /></svg>
                <span>@L["PhotoToCome"]</span>
            </div>
            <div class="empty-collection-text">
                <p class="empty-collection-lead">@L["Empty"]</p>
                <p>@L["Dashboard"]</p>
                <p class="empty-collection-aside">@L["Documentary"]</p>
                @* An illustration, without meaning of its own: shelves waiting for their first album. *@
                <svg class="empty-collection-shelf" viewBox="0 0 160 90" aria-hidden="true">
                    <rect class="shelf-slot" x="24" y="22" width="16" height="56" />
                    <rect class="shelf-slot" x="44" y="16" width="14" height="62" />
                    <rect class="shelf-slot" x="62" y="26" width="18" height="52" />
                    <rect class="shelf-slot" x="84" y="20" width="14" height="58" />
                    <rect class="shelf-book" x="104" y="24" width="16" height="54" transform="rotate(14 120 78)" />
                    <rect class="shelf-end" x="138" y="40" width="6" height="38" />
                    <line class="shelf-board" x1="8" y1="80" x2="152" y2="80" />
                </svg>
            </div>
        </div>
    </Block>

    <Block Title="@L["Browse.Title"]" data-area="browse">
        <p>@L["Browse.Text"]</p>
        <ul class="empty-collection-links">
            <li><a href="@AppPaths.Albums">@L["Browse.Albums"] →</a></li>
            <li><a href="@AppPaths.Series">@L["Browse.Series"] →</a></li>
            <li><a href="@AppPaths.Authors">@L["Browse.Authors"] →</a></li>
        </ul>
        <p class="empty-collection-links"><a href="@AppPaths.AdvancedSearch">@L["Browse.AdvancedSearch"] →</a></p>
    </Block>

    <Block Title="@L["Start.Title"]" Raised="true" data-area="start">
        <div class="empty-collection-start">
            <p>@L["Start.Text"]</p>
            <Button Label="@($"{L["Start.Open"]} →")" Href="@AppPaths.AdminHome" />
            <p class="empty-collection-aside">@L["Start.Login"]</p>
        </div>
    </Block>
</div>
