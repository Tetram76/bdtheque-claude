@* A block of content and its title. Its classes are anchors of the base theme (themes/base.css), on which a theme hooks its
   own touches: the bubble of the title, the mention above it (visuel/administration/declinaison-par-theme.md). *@
<section class="@ClassName" @attributes="OtherAttributes">
    <header>
        @if (Kicker is not null)
        {
            <p class="block-kicker">@Kicker</p>
        }
        @switch (HeadingLevel)
        {
            case 1:
                <h1 class="@TitleClass">@Title</h1>
                break;
            case 3:
                <h3 class="@TitleClass">@Title</h3>
                break;
            default:
                <h2 class="@TitleClass">@Title</h2>
                break;
        }
    </header>
    @ChildContent
</section>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = null!;

    /// <summary>The short mention above the title, which only some themes show (<c>--block-kicker-display</c>).</summary>
    [Parameter]
    public string? Kicker { get; set; }

    /// <summary>Level of the title in the outline of the page: 2 by default, 1 for the block that holds the page title.</summary>
    [Parameter]
    public int HeadingLevel { get; set; } = 2;

    /// <summary>Set in relief, for the block a page puts forward (e.g. the entry from an ISBN of the administration).</summary>
    [Parameter]
    public bool Raised { get; set; }

    /// <summary>A title read by assistive technologies only, for a block whose content speaks for itself (e.g. counters).</summary>
    [Parameter]
    public bool TitleHidden { get; set; }

    private string TitleClass => TitleHidden ? "block-title visually-hidden" : "block-title";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // Its own classes, anchors of the theme, then that of the caller, which adds to them: splatted after them, it would replace them.
    private string ClassName => CallerClasses.Merge(Raised ? "block block-raised" : "block", AdditionalAttributes);

    private IEnumerable<KeyValuePair<string, object>>? OtherAttributes => CallerClasses.Others(AdditionalAttributes);
}
