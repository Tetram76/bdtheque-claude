@using Bdtheque.Contracts.Catalog
@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<ContributionsByRole> L
@inject RecordLabels Labels
@inject ValueLabels Values

@* The contributions of a record by role (visuel/fiche-album/contenu.md, Contributions), shared by the records of the
   consultation: a line per role that has authors, in the order of the roles, with the number of its authors and their
   names, each leading to the record of the author; a role without any has no line, and a record without any author shows
   nothing (visuel/charte-graphique/convivialite-et-efficacite.md). The names of a role hold on one line, at the width of the screen: those it does not hold are folded behind « et N
   autres » (wwwroot/fold-row.js), which unfolds them, « Réduire » folding them back. The disclosure is that of the browser
   (details); the names it unfolds come before it, so that « Réduire » follows the last name. *@
@if (Contributions.Count > 0)
{
    <div class="contributions">
        <dl>
            @foreach (var role in Enum.GetValues<ContributionRole>())
            {
                var authors = Contributions.Where(c => c.Role == role).Select(c => c.Author).ToList();
                if (authors.Count == 0)
                    continue;
                <div>
                    <dt>
                        <span class="contributions-role">@Values.Of(role)</span>
                        @if (authors.Count > 1)
                        {
                            <span class="contributions-count">(@authors.Count)</span>
                        }
                    </dt>
                    <dd>
                        <app-fold-row class="contributions-names">
                            @foreach (var author in authors)
                            {
                                <a class="contributor" href="@AppPaths.AuthorRecord(author.Id)">@Labels.Author(author)</a>
                            }
                            <details class="contributions-toggle">
                                <summary>
                                    <span class="contributions-more" data-one="@L["More.One"]" data-other="@L["More.Other"]"></span>
                                    <span class="contributions-less">@L["Less"]</span>
                                </summary>
                            </details>
                        </app-fold-row>
                    </dd>
                </div>
            }
        </dl>
    </div>
}

@code {
    /// <summary>The contributions, in the order the API gives them: by role, then by author.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<ContributionItem> Contributions { get; set; } = [];
}
