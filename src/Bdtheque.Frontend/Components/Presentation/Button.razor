@* A button, or a link that looks like one when it leads to another page. Every button has the size of the controls
   (--control-height), the same on every page for a given width of screen (visuel/charte-graphique/convivialite-et-efficacite.md). Reduced to its icon on a smartphone, it keeps its label for assistive technologies. *@
@if (Href is not null)
{
    <a class="@ClassName" href="@Href" data-variant="@VariantName" data-icon-only-on-smartphone="@IconOnlyOnSmall" data-icon-only="@IconOnlyAlways" title="@Tooltip" @attributes="OtherAttributes">
        @Content
    </a>
}
else
{
    <button class="@ClassName" type="@Type" disabled="@Disabled" data-variant="@VariantName" data-icon-only-on-smartphone="@IconOnlyOnSmall" data-icon-only="@IconOnlyAlways" title="@Tooltip"
            @onclick="OnClick" @attributes="OtherAttributes">
        @Content
    </button>
}

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = null!;

    [Parameter]
    public ButtonVariant Variant { get; set; }

    [Parameter]
    public IconName? Icon { get; set; }

    /// <summary>
    /// Shows only the icon, at every width, its label being its name for assistive technologies and its tooltip (e.g. Éditions
    /// in a row of the list of the albums, beside Modifier, where a second label would take the room of the columns).
    /// </summary>
    [Parameter]
    public bool IconOnly { get; set; }

    /// <summary>Shows only the icon on a smartphone (e.g. Nouvel album, Modifier in a row of a list).</summary>
    [Parameter]
    public bool IconOnlyOnSmartphone { get; set; }

    /// <summary>The page it leads to: a link rather than a button.</summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>The type of a button: <c>button</c>, or <c>submit</c> in a form.</summary>
    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>What follows the label (e.g. the number of filters chosen on the button of the filters).</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    // Its own class, which carries the styles of the theme, then that of the caller, which adds to it.
    private string ClassName => CallerClasses.Merge("button", AdditionalAttributes);

    private IEnumerable<KeyValuePair<string, object>>? OtherAttributes => CallerClasses.Others(AdditionalAttributes);

    private string VariantName => Variant.ToString().ToLowerInvariant();

    // Rendered as bare attributes when set, absent otherwise.
    private bool? IconOnlyOnSmall => IconOnlyOnSmartphone && Icon is not null ? true : null;

    private bool? IconOnlyAlways => IconOnly && Icon is not null ? true : null;

    // The label, which an icon alone no longer shows.
    private string? Tooltip => IconOnlyAlways is true ? Label : null;

    private RenderFragment Content => @<text>
        @if (Icon is { } icon)
        {
            <Icon Name="icon" />
        }
        <span class="button-label">@Label</span>
        @ChildContent
    </text>;
}
