@using Bdtheque.Contracts.Enums
@inject IStringLocalizer<RatingStars> L
@inject ValueLabels Values

@* The rating of an album in five stars, the stars of the rating filled (visuel/fiche-album/contenu.md), shared by the records
   of the consultation: an image named by the rating for assistive technologies; without rating, five empty stars, decorative,
   that the page names itself (« Pas encore noté »), or leaves out. *@
@if (Rating is { } rating)
{
    <span class="rating-stars" role="img" aria-label="@L["Rating", Values.Of(rating), (int)rating]">@Stars((int)rating)</span>
}
else
{
    <span class="rating-stars" aria-hidden="true">@Stars(0)</span>
}

@code {
    /// <summary>The rating; <c>null</c> for an album not rated yet.</summary>
    [Parameter]
    public AlbumRating? Rating { get; set; }

    private static RenderFragment Stars(int rating) => __builder =>
    {
        @for (var star = 1; star <= 5; star++)
        {
            <svg class="star" data-on="@(star <= rating ? "" : null)" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 3l2.8 5.8 6.2.9-4.5 4.4 1 6.3L12 17.5 6.5 20.4l1-6.3L3 9.7l6.2-.9z" />
            </svg>
        }
    };
}
