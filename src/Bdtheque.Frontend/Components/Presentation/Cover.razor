@using Bdtheque.Contracts.Catalog
@inject IStringLocalizer<Cover> L

@* The thumbnail of a cover, or the generic visual for an edition or an album without cover (fonctionnel/regles-metier.md
   § Visuel par défaut, § Couverture d'un album). Its media is the display version relayed by frontend (VisualMediaRelay).
   Without text, it is decorative: the label next to it names what it shows. *@
<span class="cover">
    @if (VisualId is { } visual)
    {
        <img src="@VisualMediaRoutes.Display(visual)" alt="@(Alt ?? "")" loading="lazy" decoding="async" />
    }
    else
    {
        <svg viewBox="0 0 30 40" preserveAspectRatio="xMidYMid slice" role="@(Alt is null ? null : "img")"
             aria-label="@(Alt is null ? null : L["Generic"].Value)" aria-hidden="@(Alt is null ? "true" : null)">
            <rect class="cover-generic-page" x="0.5" y="0.5" width="29" height="39" />
            <rect class="cover-generic-spine" width="3" height="40" />
            <path class="cover-generic-bubble" d="M9 13h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2h-7l-4 3v-3h-3a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2z" />
            <circle class="cover-generic-dot" cx="12.5" cy="18.5" r="1" />
            <circle class="cover-generic-dot" cx="16" cy="18.5" r="1" />
            <circle class="cover-generic-dot" cx="19.5" cy="18.5" r="1" />
        </svg>
    }
</span>

@code {
    /// <summary>The visual of the cover; <c>null</c> without cover, the generic visual standing in for it.</summary>
    [Parameter]
    public Guid? VisualId { get; set; }

    /// <summary>What the cover shows, when no label next to it names it already.</summary>
    [Parameter]
    public string? Alt { get; set; }
}
