@using Bdtheque.Contracts.Catalog
@inject IStringLocalizer<Cover> L

@* The thumbnail of a cover, or the generic visual for an edition or an album without cover (fonctionnel/regles-metier/visuel-par-defaut.md, fonctionnel/regles-metier/couverture-d-un-album.md). Its media is the display version relayed by frontend (VisualMediaRelay).
   Without text, it is decorative: the label next to it names what it shows. The frame a theme gives a cover (the .cover
   anchor: border, background, shadow, tilt) is borne by the image itself, at its own proportions, so that it hugs the
   cover whatever its format: the slot around it only keeps the room of a cover in a list or a grid. The generic visual and
   the blank card of a pile are painted by the theme (--cover-generic, --cover-blank), as in the mockups: nothing is drawn
   in them.
   An album a page puts forward (Volume) may be shown by a theme as a book in volume (the .cover-volume anchor), whose
   spine takes the deep colour of its own cover (--cover-spine). *@
<span class="@(Volume ? "cover-slot cover-volume" : "cover-slot")" style="@(Volume && Palette is { } palette ? $"--cover-spine: {palette.Deep};" : null)">
    @if (VisualId is { } visual)
    {
        <img class="cover" src="@VisualMediaRoutes.Display(visual)" alt="@(Alt ?? "")" loading="lazy" decoding="async" />
    }
    else if (Blank)
    {
        <svg class="cover cover-blank" viewBox="0 0 30 40" aria-hidden="true"></svg>
    }
    else
    {
        <svg class="cover cover-generic" viewBox="0 0 30 40" role="@(Alt is null ? null : "img")"
             aria-label="@(Alt is null ? null : L["Generic"].Value)" aria-hidden="@(Alt is null ? "true" : null)"></svg>
    }
</span>

@code {
    /// <summary>The visual of the cover; <c>null</c> without cover, the generic visual standing in for it.</summary>
    [Parameter]
    public Guid? VisualId { get; set; }

    /// <summary>What the cover shows, when no label next to it names it already.</summary>
    [Parameter]
    public string? Alt { get; set; }

    /// <summary>
    /// A place without any album, a plain card rather than a cover (e.g. a place of a pile of covers beyond the volumes of a
    /// series, visuel/fiche-serie/); decorative.
    /// </summary>
    [Parameter]
    public bool Blank { get; set; }

    /// <summary>An album a page puts forward (e.g. the edition in the spotlight), which a theme may show in volume.</summary>
    [Parameter]
    public bool Volume { get; set; }

    /// <summary>The colours of the cover, whose deep one colours the spine of the album in volume.</summary>
    [Parameter]
    public CoverPalette? Palette { get; set; }
}
