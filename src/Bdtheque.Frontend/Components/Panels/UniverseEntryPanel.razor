@using Microsoft.AspNetCore.Components.Authorization

@* The side panel of a universe, changed or new (visuel/listes/saisie-selon-l-entite.md), over the page that its address opens: the
   list of the universes, or the record of the universe in the consultation, which stays under the panel (decisions of the user,
   #658). For the authenticated administrator only: rendered with the page, statically, it reads the authentication of the
   request, and renders the interactive panel (UniversePanelForm) for the administrator alone, so that a visitor of the record,
   public, sees no panel and opens no circuit. *@
@if (_administrator)
{
    <UniversePanelForm UniverseId="UniverseId" Searched="@Searched" CloseHref="@CloseHref" SavedHref="@SavedHref" Opening="Opening" />
}

@code {
    private bool _administrator;

    /// <summary>The universe changed; none for a new universe.</summary>
    [Parameter]
    public Guid? UniverseId { get; set; }

    /// <summary>The text searched in vain in the list, which a new universe takes as its name (« Créer l'univers « … » »).</summary>
    [Parameter]
    public string? Searched { get; set; }

    /// <summary>Where the closing of the panel leads: the page under it.</summary>
    [Parameter, EditorRequired]
    public string CloseHref { get; set; } = null!;

    /// <summary>Where the universe saved leads: the page under the panel, without it.</summary>
    [Parameter, EditorRequired]
    public string SavedHref { get; set; } = null!;

    /// <summary>
    /// The action the opening of the panel is, recorded by the panel when the page under it does not record it from its own
    /// address (the record of the universe; the list records it); none otherwise.
    /// </summary>
    [Parameter]
    public AudienceFunction? Opening { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    // The only authenticated user is the administrator (contraintes-techniques/architecture-deploiement/authentification.md).
    protected override async Task OnInitializedAsync() =>
        _administrator = Authentication is not null && (await Authentication).User.Identity?.IsAuthenticated == true;
}
