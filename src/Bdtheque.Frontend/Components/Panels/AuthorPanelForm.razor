@rendermode InteractiveServer
@using Bdtheque.Contracts.Admin
@using Bdtheque.Frontend.Entries
@inject IStringLocalizer<AuthorPanelForm> L
@inject IStringLocalizer<FieldMessages> FieldTexts
@inject IStringLocalizer<RuleMessages> Rules
@inject ApiClient Api
@inject AudienceRecorder Recorder
@inject NavigationManager Navigation

@* The side panel of an author (visuel/saisie-auteur/contenu.md), interactive: each datum changed is marked as it is typed, and
   the author reloaded after it was modified meanwhile offers again what was typed, under each datum (visuel/saisie-album/contenu.md,
   données modifiées, #355, #329), what is typed being compared with what was read by the tracker of the entry forms. Read once,
   by the prerendering, its state handed to the circuit, from which it is saved. An author deleted meanwhile keeps the panel
   open, with what was typed and the error of its saving; an address on an author deleted opens none. Rendered for the
   administrator alone (AuthorEntryPanel), it still saves nothing without the authentication of its circuit. *@
@if (_administrator && Entry is not null)
{
    <EntryPanel @ref="_panel" Id="author-panel" Title="@(Entry.Id is null ? L["Panel.New"] : L["Panel.Edit"])" CloseHref="@CloseHref"
                SaveLabel="@(Entry.Id is null ? L["Create"] : L["Save"])" OnSave="SaveAsync" HasRedo="Tracker.HasRedo"
                Problem="SaveProblem" Dates="Dates">
        <div class="author-panel-names">
            <Field Id="author-first-name" Label="@L["FirstName"]" Error="@Errors.For(FirstNameField)" State="@DatumState(FirstNameField)" Context="control">
                <input id="@control.Id" type="text" autofocus tabindex="0" aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                       @bind="Entry.FirstName" @bind:event="oninput" />
            </Field>
            <Field Id="author-last-name" Label="@L["LastName"]" Error="@Errors.For(LastNameField)" State="@DatumState(LastNameField)" Context="control">
                <input id="@control.Id" type="text" aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                       @bind="Entry.LastName" @bind:event="oninput" />
            </Field>
        </div>
        <Field Id="author-pseudonym" Label="@L["Pseudonym"]" Help="@L["Pseudonym.Help"]" Error="@Errors.For(PseudonymField)" State="@DatumState(PseudonymField)"
               Context="control">
            @* An author without last name nor pseudonym, said once under the last name, concerns the pseudonym as much:
               bordered, and described by it too (visuel/saisie-auteur/contenu.md). *@
            <input id="@control.Id" type="text" aria-describedby="@PseudonymDescribedBy(control.DescribedBy)"
                   aria-invalid="@(control.Invalid ?? (WithoutName ? "true" : null))" @bind="Entry.Pseudonym" @bind:event="oninput" />
        </Field>
        <Field Id="author-nationality" Label="@L["Nationality"]" Characters="18" Error="@Errors.For(NationalityField)" State="@DatumState(NationalityField)"
               Context="control">
            <input id="@control.Id" type="text" aria-describedby="@control.DescribedBy" aria-invalid="@control.Invalid"
                   @bind="Entry.Nationality" @bind:event="oninput" />
        </Field>
        <Field Id="author-biography" Label="@L["Biography"]" Error="@Errors.For(BiographyField)" State="@DatumState(BiographyField)" Context="control">
            <textarea id="@control.Id" rows="6" placeholder="@L["Biography.Placeholder"]" aria-describedby="@control.DescribedBy"
                      aria-invalid="@control.Invalid" @bind="Entry.Biography" @bind:event="oninput"></textarea>
        </Field>
    </EntryPanel>
}

@code {
    private bool _administrator;
    private ApiProblem? _problem;
    private bool _saving;
    private bool _revealProblem;
    private EntryPanel? _panel;
    private EntryTracker<AuthorEntry>? _tracker;

    /// <summary>The author changed; none for a new author.</summary>
    [Parameter]
    public Guid? AuthorId { get; set; }

    /// <summary>The text searched in vain in the list, which a new author takes as its name (« Créer l'auteur « … » »).</summary>
    [Parameter]
    public string? Searched { get; set; }

    /// <summary>Where the closing of the panel leads: the page under it.</summary>
    [Parameter, EditorRequired]
    public string CloseHref { get; set; } = null!;

    /// <summary>Where the author saved leads: the page under the panel, without it.</summary>
    [Parameter, EditorRequired]
    public string SavedHref { get; set; } = null!;

    /// <summary>The action the opening of the panel is, recorded by the panel; none when the page under it records it.</summary>
    [Parameter]
    public AudienceFunction? Opening { get; set; }

    /// <summary>The author as the panel holds it, read once, by the prerendering.</summary>
    [PersistentState]
    public AuthorEntry? Entry { get; set; }

    /// <summary>The author as it was read: what the user changed since.</summary>
    [PersistentState]
    public AuthorEntry? ReadEntry { get; set; }

    // The request of the prerendering, which the opening of the panel is recorded by; none in the circuit.
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? Authentication { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _administrator = await IsAdministratorAsync();
        if (!_administrator || Entry is not null)
            return;

        if (AuthorId is { } edited)
        {
            if (await FindAsync(edited) is not { } author)
                return;
            Entry = AuthorEntry.Of(author);
            if (Opening is { } opening && HttpContext is { } context && HttpMethods.IsGet(context.Request.Method))
                await Recorder.RecordActionAsync(opening, $"author={author.Id}", context.RequestAborted);
        }
        else
            Entry = AuthorEntry.New(Searched);
        ReadEntry = Entry.Copy();
    }

    // The only authenticated user is the administrator (contraintes-techniques/architecture-deploiement/authentification.md).
    private async Task<bool> IsAdministratorAsync() =>
        Authentication is not null && (await Authentication).User.Identity?.IsAuthenticated == true;

    // The author, or none if it no longer exists: the page is then shown without its panel.
    private async Task<AuthorForm?> FindAsync(Guid id)
    {
        try
        {
            return await Api.GetAsync<AuthorForm>($"/admin/authors/{id}");
        }
        catch (ApiProblemException exception) when (exception.Problem.Status == StatusCodes.Status404NotFound)
        {
            return null;
        }
    }

    private async Task SaveAsync()
    {
        // The API knows no user (docs/tech/mecanismes/authentification-et-appels-internes.md): over a public page, a circuit
        // whose session ended writes nothing.
        if (_saving || !await IsAdministratorAsync())
            return;
        _saving = true;
        _problem = null;
        try
        {
            // The author changed, as its panel read it, even deleted meanwhile: the API then says so, never a new author.
            var saved = Entry!.Id is { } edited
                ? await Api.PutAsync<UpdateAuthorRequest, AuthorForm>($"/admin/authors/{edited}", Entry.ToUpdate())
                : await Api.PostAsync<CreateAuthorRequest, AuthorForm>("/admin/authors", Entry.ToCreation());
            await Recorder.RecordActionAsync(
                Entry.Id is null ? AudienceFunctions.AdminAuthorCreated : AudienceFunctions.AdminAuthorSaved, $"author={saved.Id}");
            Navigation.NavigateTo(SavedHref);
        }
        catch (ApiProblemException exception)
        {
            _problem = exception.Problem;
            _revealProblem = true;
        }
        finally
        {
            _saving = false;
        }
    }

    // Once the error of a saving is rendered, what is to correct is brought into view.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_revealProblem && _panel is not null)
        {
            _revealProblem = false;
            await _panel.RevealProblemAsync();
        }
    }

    // The author as it is now, read anew within the circuit: the entry left behind offers again, under each datum, what the
    // user had typed (visuel/saisie-album/contenu.md, #329).
    private async Task ReloadAsync()
    {
        try
        {
            var reloaded = AuthorEntry.Of(await Api.GetAsync<AuthorForm>($"/admin/authors/{Entry!.Id!.Value}"));
            Tracker.Abandon();
            Entry = reloaded;
            ReadEntry = reloaded.Copy();
            _problem = null;
        }
        catch (ApiProblemException exception)
        {
            // Deleted meanwhile, or unreadable: said as the error of the saving was, what was typed staying as it is.
            _problem = exception.Problem;
        }
    }

    // The three categories told apart at first glance, as on an entry form (visuel/listes/saisie-selon-l-entite.md): no
    // « Voir mes changements », what was typed staying in the panel until the reload.
    private RenderFragment? SaveProblem => _problem is not { } problem ? null
        : @<SaveError Problem="problem" Conflict="@L["Problem.Functional.Conflict"]" NotFound="@L["Problem.Functional.NotFound"]"
                      Technical="@L["Problem.Technical.Text"]" CanReload="@(Entry!.Id is not null)" OnReload="ReloadAsync" OnRetry="SaveAsync" />;

    private RenderFragment? Dates => Entry is { CreatedAt: { } created, ModifiedAt: { } modified }
        ? @<text>@L["Dates.Created"] <LocalDateTime Value="created" />@L["Dates.Modified"] <LocalDateTime Value="modified" />.</text>
        : null;

    // The fields of the content the panel enters, in their order in the panel, each the datum the tracker compares.
    private const string FirstNameField = "/firstName";
    private const string LastNameField = "/lastName";
    private const string PseudonymField = "/pseudonym";
    private const string NationalityField = "/nationality";
    private const string BiographyField = "/biography";

    // The data of the author, in the order of the panel, compared on what is typed against what was read
    // (visuel/saisie-album/contenu.md, données modifiées): for their mark and the entry left behind at a reload.
    private EntryTracker<AuthorEntry> Tracker => _tracker ??= new(() => ReadEntry, () => Entry,
    [
        new(FirstNameField, L["FirstName"], e => e.FirstName, e => e.FirstName, (from, to) => to.FirstName = from.FirstName),
        new(LastNameField, L["LastName"], e => e.LastName, e => e.LastName, (from, to) => to.LastName = from.LastName),
        new(PseudonymField, L["Pseudonym"], e => e.Pseudonym, e => e.Pseudonym, (from, to) => to.Pseudonym = from.Pseudonym),
        new(NationalityField, L["Nationality"], e => e.Nationality, e => e.Nationality, (from, to) => to.Nationality = from.Nationality),
        new(BiographyField, L["Biography"], e => e.Biography, e => e.Biography, (from, to) => to.Biography = from.Biography),
    ]);

    // Nothing is modified on a new author, all of which is new.
    private EntryDatumState? DatumState(string key) => Entry!.Id is null ? null : Tracker.State(key, this);

    // The fields a refused saving designates (choix-implementation/socle/frontend.md, champ d'une erreur métier): a display name
    // already taken at the field it comes from (visuel/saisie-auteur/contenu.md), its text naming the author as typed.
    private FieldErrors Errors => new(
        _problem, FieldTexts, Rules, RecordSearch.AuthorName(Entry!.LastName?.Trim(), Entry.FirstName?.Trim(), Entry.Pseudonym?.Trim()));

    // An author without last name nor pseudonym, refused at the last name, which the domain designates.
    private bool WithoutName =>
        _problem is { Category: ProblemCategory.Business, RuleCode: "Author.LastNameOrPseudonymRequired" };

    private string? PseudonymDescribedBy(string? own) =>
        WithoutName ? string.Join(' ', new[] { "author-last-name-error", own }.OfType<string>()) : own;
}
