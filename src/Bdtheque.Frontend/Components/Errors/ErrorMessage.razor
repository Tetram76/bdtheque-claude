@using Bdtheque.Contracts.Deletion
@using Bdtheque.Frontend.Api
@inject IStringLocalizer<ErrorMessage> L
@inject IStringLocalizer<RuleMessages> Rules

@* The category tells the three kinds of errors apart at first glance (fonctionnel/presentation-des-erreurs.md), by its
   icon, its color and its frame (visuel/saisie-album/contenu.md), carried by an attribute (ErrorMessage.razor.css); the title
   names the situation met, in agreement with the message, written here once so that a same situation bears the same title
   wherever it occurs (fonctionnel/presentation-des-erreurs.md, titre d'une erreur). Compact, at the scale of a control (a
   list of suggestions, the line of an upload, under a field): the same title, icon, color and frame, smaller. *@
<div role="alert" class="error-message" data-error-category="@CategoryName" data-error-compact="@Compact">
    <span class="error-icon"><Icon Name="CategoryIcon" /></span>
    <div class="error-content">
        <p data-error-label>@(Label ?? L[Situation])</p>
        <p data-error-text>@Text</p>
        @if (Problem.Category != ProblemCategory.Technical && Problem.Impact is { BlockedBy.Count: > 0 } impact)
        {
            <RefusalLines Impact="impact" Hint="RefusalHint" data-error-impact="" />
        }
        @if (Actions is not null)
        {
            <div class="error-actions">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ApiProblem Problem { get; set; } = null!;

    /// <summary>
    /// The title of a situation the frontend finds itself, without any call to the API, and which no answer of the API names
    /// (e.g. a login refused, too many attempts of login, a page that does not exist).
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// The text of an error the frontend finds itself, without any call to the API (e.g. a refused login), in place of the
    /// text the API would give.
    /// </summary>
    [Parameter]
    public string? Message { get; set; }

    /// <summary>
    /// The text of a technical error, said for the action of a control that failed (e.g. its search), in place of the generic
    /// text of the request of a page; an error of another category keeps its own text, which says what to do about it.
    /// </summary>
    [Parameter]
    public string? TechnicalText { get; set; }

    /// <summary>
    /// What to do about the records of a type that block a refused deletion or removal, given the key of the type and of the
    /// number (<see cref="RefusalLines.Hint"/>); without it, each line gives the number of records only.
    /// </summary>
    [Parameter]
    public Func<string, string>? RefusalHint { get; set; }

    /// <summary>What the user can do about the error (e.g. reload the record, try again).</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>
    /// Whether the error answers the entry of a record (its saving), rather than an action without entry
    /// (e.g. an intent of acquisition added from a button): a business error then asks to correct the entry, where it
    /// otherwise says the action refused.
    /// </summary>
    [Parameter]
    public bool Entry { get; set; }

    /// <summary>Presented within a control rather than over a page or a form: the same error, at the scale of the control.</summary>
    [Parameter]
    public bool Compact { get; set; }

    private string CategoryName => Problem.Category.ToString().ToLowerInvariant();

    private IconName CategoryIcon => Problem.Category switch
    {
        ProblemCategory.Business => IconName.Exclamation,
        ProblemCategory.Functional => IconName.Reload,
        _ => IconName.Wrench,
    };

    // The situations told apart in the same order as the text, which the title introduces.
    private string Situation => Problem.Category switch
    {
        ProblemCategory.Business => Entry ? "Title.EntryToCorrect" : "Title.ActionRefused",
        ProblemCategory.Functional when Problem.Impact is not null => "Title.ImpactChanged",
        ProblemCategory.Functional when Problem.Status == StatusCodes.Status404NotFound => "Title.Deleted",
        ProblemCategory.Functional => "Title.Modified",
        _ => "Title.Technical",
    };

    // A technical error discloses nothing of its cause, which only the logs of the API hold.
    private string Text => Message ?? Problem.Category switch
    {
        ProblemCategory.Business when Problem.RuleCode is { } code && Rules[code] is { ResourceNotFound: false } rule => rule.Value,
        ProblemCategory.Business => L["Business.Generic"],
        ProblemCategory.Functional when Problem.Impact is not null => L["Functional.ImpactChanged"],
        ProblemCategory.Functional when Problem.Status == StatusCodes.Status404NotFound => L["Functional.NotFound"],
        ProblemCategory.Functional => L["Functional.Conflict"],
        _ => TechnicalText ?? L["Technical"],
    };
}
