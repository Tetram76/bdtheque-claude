<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Bdtheque.Api</RootNamespace>
    <UserSecretsId>bdtheque-api</UserSecretsId>
    <!-- No static file to serve: no static web assets manifest in the published output. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Settings of a local run from the sources (`dotnet run`), meaningless in a container. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bdtheque.Contracts\Bdtheque.Contracts.csproj" />
    <ProjectReference Include="..\Bdtheque.Domain\Bdtheque.Domain.csproj" />
    <ProjectReference Include="..\Bdtheque.Infrastructure\Bdtheque.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>
